---
import Layout from '../../layouts/Layout.astro';
import sitio from '../../datos/sitio.json';
import carrerasJson from '../../datos/carreras.json';
import fondosJson from '../../datos/fondos.json';
import microJson from '../../datos/microcertificaciones.json';
import { ficha } from '../../lib/carreras.mjs';

const carreras = carrerasJson.carreras;
const fondos = fondosJson.fondos;
const maestrias = microJson.maestrias;

export async function getStaticPaths() {
  const cList = carrerasJson.carreras;
  return cList.map((c: any) => ({
    params: { slug: c.slug },
    props: { carrera: c }
  }));
}

const { carrera } = Astro.props;

const SITIOS_UNIVERSIDAD: Record<string, string> = {
  'Universidad del Gran Rosario': 'https://ugr.edu.ar/'
};
// schema.org timeRequired must be an ISO 8601 duration.
const DURACIONES_ISO: Record<string, string> = {
  '1 año y medio': 'P18M',
  '2 años': 'P2Y',
  '2 años de cursado más tesis': 'P2Y',
  '2 años y medio': 'P30M',
  '4 años': 'P4Y'
};
// "a distancia" is the search term; add it only while the title still fits in Google (~60 with " | FGREC").
const conModalidad = `${carrera.nombre} a distancia`;
const tituloPagina = conModalidad.length + 8 <= 60 ? conModalidad : carrera.nombre;
const pagina = ficha(sitio, carrera, { carreras, fondos, maestrias });

// Course schema
const courseSchema = {
  '@type': 'Course',
  '@id': `https://www.fgrec.org/carreras/${carrera.slug}/#course`,
  'name': carrera.nombre,
  'description': carrera.resumen || `${carrera.nombre} a distancia en ${carrera.universidad}.`,
  'provider': {
    '@type': 'EducationalOrganization',
    'name': carrera.universidad,
    'sameAs': SITIOS_UNIVERSIDAD[carrera.universidad]
  },
  'educationalCredentialAwarded': carrera.titulo || carrera.nombre,
  'courseMode': carrera.instanciasPresenciales ? 'Blended' : 'Online',
  'timeRequired': DURACIONES_ISO[carrera.duracion],
  'inLanguage': 'es'
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  'itemListElement': [
    {
      '@type': 'ListItem',
      'position': 1,
      'name': 'Inicio',
      'item': 'https://www.fgrec.org/'
    },
    {
      '@type': 'ListItem',
      'position': 2,
      'name': 'Carreras',
      'item': 'https://www.fgrec.org/carreras/'
    },
    {
      '@type': 'ListItem',
      'position': 3,
      'name': carrera.nombre,
      'item': `https://www.fgrec.org/carreras/${carrera.slug}/`
    }
  ]
};
---
<Layout 
  title={tituloPagina} 
  description={pagina.descripcion || carrera.resumen || `${carrera.nombre} a distancia.`}
  image={carrera.imagenTarjeta}
  type="course"
  schema={[courseSchema, breadcrumbSchema]}
>
  <Fragment set:html={pagina.contenido} />
</Layout>
