---
export const prerender = false;

// "Mis datos": el postulante verifica sus datos de contacto, avisa si el nombre está mal y carga su documento, su fecha de nacimiento, su nacionalidad y su domicilio. El país del mercado no se muestra ni se edita. El sitio no valida los datos: lo decide FGREC; las listas de países salen de su respuesta.
import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import { leerDatos, datosFaltantes, campoEditable, CAMPOS_DATOS, LARGOS_DATOS, LARGO_MAX_DOCUMENTO, LARGO_MAX_COMENTARIO, type CampoDato } from '../../lib/datos-pure.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'datos',
  sesion: sesionToken,
  contexto: extraerContextoVisitante(Astro.request)
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mis%20datos%20en%20el%20portal.`
  : null;

const datos = leerDatos(respuesta.data);

// Los datos personales viajan a la universidad bajo la autorización de documentos: si falta aceptar la versión vigente, se pide aquí.
let consentimiento: { codigo: string; version: string; texto: string } | null = null;
if (respuesta.ok) {
  const respCons = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'consentimientos',
    sesion: sesionToken,
    contexto: extraerContextoVisitante(Astro.request)
  });
  const texto = respCons.ok ? respCons.data?.textos?.find((t: any) => t.codigo === 'DOCUMENTOS_TRANSFERENCIA') : null;
  if (texto && !texto.aceptado) consentimiento = { codigo: texto.codigo, version: texto.version, texto: texto.texto };
}
const nombreCompleto = `${datos.nombre} ${datos.apellido}`.trim();
const sinDato = 'Sin registrar';
const faltantes = datosFaltantes(datos);

const hoy = new Date().toISOString().slice(0, 10);
const editable = (campo: CampoDato) => campoEditable(datos, campo, datos.datosEditables);
const hayEditable = datos.documentoEditable || CAMPOS_DATOS.some(editable);
const datosCerrados = !datos.datosEditables && CAMPOS_DATOS.some((c) => datos[c]);
const actualInicial = Object.fromEntries(['documento', ...CAMPOS_DATOS].map((c) => [c, datos[c as 'documento' | CampoDato]]));

interface CampoVista { campo: CampoDato; etiqueta: string; tipo: 'date' | 'select' | 'text'; requerido?: boolean; autocomplete?: string; }
const secciones: Array<{ id: string; titulo: string; desc: string; campos: CampoVista[]; fila?: CampoVista[] }> = [
  {
    id: 'personales',
    titulo: 'Datos personales',
    desc: 'Los pedimos para tu alta académica en la universidad.',
    campos: [
      { campo: 'fechaNacimiento', etiqueta: 'Fecha de nacimiento', tipo: 'date', requerido: true, autocomplete: 'bday' },
      { campo: 'nacionalidad', etiqueta: 'Nacionalidad', tipo: 'select', requerido: true }
    ]
  },
  {
    id: 'domicilio',
    titulo: 'Domicilio',
    desc: 'Donde vives actualmente.',
    campos: [
      { campo: 'paisResidencia', etiqueta: 'País de residencia', tipo: 'select', requerido: true, autocomplete: 'country-name' },
      { campo: 'calle', etiqueta: 'Calle', tipo: 'text', requerido: true, autocomplete: 'address-line1' }
    ],
    fila: [
      { campo: 'numero', etiqueta: 'N°', tipo: 'text' },
      { campo: 'piso', etiqueta: 'Piso', tipo: 'text' },
      { campo: 'depto', etiqueta: 'Depto', tipo: 'text' },
      { campo: 'codigoPostal', etiqueta: 'Código postal', tipo: 'text', requerido: true, autocomplete: 'postal-code' }
    ]
  }
];
---

<PortalLayout title="Mis datos | Fundación Gran Rosario" autenticado={true} pendientes={{ datos: faltantes.length }}>
  {statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <h1 class="portal-title">{statusError === 429 ? 'Demasiados intentos' : 'Servicio no disponible'}</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        {statusError === 429
          ? 'Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.'
          : 'El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas atención inmediata, puedes escribir a nuestro canal oficial.'}
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="datos-page">
      <header class="datos-cabecera">
        <div class="datos-cabecera__hero">
          <span class="portal-badge portal-badge--neutral">Identificación y contacto</span>
          <h1 class="portal-title">Mis datos personales</h1>
          <p class="portal-desc">Verifica tu información registrada y completa los datos requeridos para la emisión de tus documentos académicos.</p>
        </div>
      </header>

      <div class="datos-grid">
        <!-- Columna Principal: documento y datos que se cargan en un solo formulario -->
        <div class="datos-col--main">
          <div id="datos-estado" class="portal-alert portal-alert--success" role="status" tabindex="-1" hidden></div>
          <div id="datos-error" class="portal-alert portal-alert--error" role="alert" tabindex="-1" hidden></div>

          <form
            id="datos-form"
            class="datos-form-secciones"
            novalidate
            data-actual={JSON.stringify(actualInicial)}
            data-documento-editable={datos.documentoEditable ? '1' : '0'}
            data-datos-editables={datos.datosEditables ? '1' : '0'}
          >
            <section class="section-card datos-card--primary" aria-labelledby="documento-titulo">
              <div class="datos-card__header">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--portal-cobre)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6.17 15a3 3 0 0 1 5.66 0"/><path d="M16 10h2"/><path d="M16 14h2"/></svg>
                <h2 class="section-card__title" id="documento-titulo">Documento de identidad</h2>
              </div>
              <p class="datos-card__desc">Este dato es indispensable para formalizar tu expediente ante la universidad.</p>

              <div class="datos-form-grid">
                {datos.documentoEditable ? (
                  <div class="portal-input-group">
                    <label for="datos-documento" class="portal-label">
                      <span>Número de documento de identidad</span>
                      <span class="portal-label__tag">Requerido</span>
                    </label>
                    <input
                      type="text"
                      id="datos-documento"
                      name="documento"
                      class="portal-input"
                      maxlength={LARGO_MAX_DOCUMENTO}
                      autocomplete="off"
                      placeholder="Ej. Cédula, DNI o Pasaporte"
                      value={datos.documento}
                      aria-describedby="datos-documento-error"
                    />
                    <p id="datos-documento-error" class="datos__error" hidden></p>
                  </div>
                ) : (
                  <div class="portal-input-group">
                    <p class="portal-label">Número de documento de identidad</p>
                    <div class="datos__valor-bloqueado">
                      <span class="datos__valor-texto">{datos.documento || sinDato}</span>
                      <span class="portal-badge portal-badge--neutral">Validado</span>
                    </div>
                    <p class="datos__nota">Tu expediente ya fue aprobado: para cambiar el número de documento, escríbele a tu asesora.</p>
                  </div>
                )}
              </div>
            </section>

            {secciones.map((sec) => {
              const campoVista = (c: CampoVista) => (
                <div class="portal-input-group">
                  {editable(c.campo) ? (
                    <>
                      <label for={`datos-${c.campo}`} class="portal-label">
                        <span>{c.etiqueta}</span>
                        {c.requerido && <span class="portal-label__tag">Requerido</span>}
                      </label>
                      {c.tipo === 'select' ? (
                        <select id={`datos-${c.campo}`} name={c.campo} class="portal-select" aria-describedby={`datos-${c.campo}-error`}>
                          <option value="">Selecciona una opción</option>
                          {datos.paises.map((p) => <option value={p} selected={p === datos[c.campo]}>{p}</option>)}
                        </select>
                      ) : (
                        <input
                          type={c.tipo}
                          id={`datos-${c.campo}`}
                          name={c.campo}
                          class="portal-input"
                          value={datos[c.campo]}
                          maxlength={c.tipo === 'text' ? LARGOS_DATOS[c.campo as keyof typeof LARGOS_DATOS] : undefined}
                          min={c.tipo === 'date' ? '1900-01-01' : undefined}
                          max={c.tipo === 'date' ? hoy : undefined}
                          autocomplete={c.autocomplete ?? 'off'}
                          aria-describedby={`datos-${c.campo}-error`}
                        />
                      )}
                      <p id={`datos-${c.campo}-error`} class="datos__error" hidden></p>
                    </>
                  ) : (
                    <>
                      <p class="portal-label">{c.etiqueta}</p>
                      <div class="datos__valor-bloqueado">
                        <span class="datos__valor-texto">{datos[c.campo]}</span>
                        <span class="portal-badge portal-badge--neutral">Validado</span>
                      </div>
                    </>
                  )}
                </div>
              );
              return (
                <section class="section-card datos-card--primary" aria-labelledby={`${sec.id}-titulo`}>
                  <div class="datos-card__header">
                    <h2 class="section-card__title" id={`${sec.id}-titulo`}>{sec.titulo}</h2>
                  </div>
                  <p class="datos-card__desc">{sec.desc}</p>
                  <div class="datos-form-grid">
                    {sec.campos.map(campoVista)}
                    {sec.fila && <div class="datos-fila">{sec.fila.map(campoVista)}</div>}
                  </div>
                </section>
              );
            })}

            {datosCerrados && (
              <p class="datos__nota">Tu expediente ya fue aprobado: los datos validados no se pueden cambiar. Para corregirlos, escríbele a tu asesora.</p>
            )}

            {consentimiento && CAMPOS_DATOS.some(editable) && (
              <section id="datos-consentimiento" class="section-card exp-consentimiento-card" aria-labelledby="datos-consentimiento-titulo"
                data-codigo={consentimiento.codigo} data-version={consentimiento.version}>
                <h2 id="datos-consentimiento-titulo" class="section-card__title">Autorización de uso y transferencia de datos</h2>
                <p class="datos-card__desc">Para guardar tus datos personales necesitamos que aceptes la autorización vigente: los enviamos a la universidad para tu alta académica.</p>
                <div class="exp-consentimiento__texto" tabindex="0" role="region" aria-label="Texto legal de la autorización">
                  {consentimiento.texto}
                </div>
                <label class="portal-label" for="datos-consentimiento-acepto">
                  <input type="checkbox" id="datos-consentimiento-acepto" aria-describedby="datos-consentimiento-error" />
                  <span>Leí y acepto la autorización de uso y transferencia de mis datos y documentos.</span>
                </label>
                <p id="datos-consentimiento-error" class="datos__error" hidden></p>
              </section>
            )}

            {hayEditable && (
              <div class="datos-form__footer">
                <button type="submit" id="datos-guardar" class="portal-btn portal-btn--primary">
                  Guardar mis datos
                </button>
              </div>
            )}
          </form>
        </div>

        <!-- Columna Secundaria: Ficha de contacto institucional y aviso de nombre -->
        <div class="datos-col--side">
          <section class="section-card datos-card--side" aria-labelledby="contacto-titulo">
            <div class="datos-card__header">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
              <h2 class="section-card__title" id="contacto-titulo">Datos de contacto registrados</h2>
            </div>

            <dl class="datos-contacto-lista">
              <div class="datos-contacto-item">
                <dt class="datos-contacto-label">Postulante</dt>
                <dd class="datos-contacto-val">{nombreCompleto || sinDato}</dd>
              </div>
              <div class="datos-contacto-item">
                <dt class="datos-contacto-label">Correo electrónico</dt>
                <dd class="datos-contacto-val">{datos.email || sinDato}</dd>
              </div>
              <div class="datos-contacto-item">
                <dt class="datos-contacto-label">Teléfono de contacto</dt>
                <dd class="datos-contacto-val">{datos.telefono || sinDato}</dd>
              </div>
            </dl>

            <p class="datos__nota-contacto">
              Si tu correo o teléfono presentan errores o cambiaron, solicítale su actualización a tu asesora de admisión.
            </p>

            <div class="datos-nombre-box">
              <div id="nombre-estado" class="portal-alert portal-alert--success" role="status" tabindex="-1" hidden></div>
              <div id="nombre-error" class="portal-alert portal-alert--error" role="alert" tabindex="-1" hidden></div>

              <button type="button" id="nombre-abrir" class="portal-btn portal-btn--outline portal-btn--block" aria-expanded="false" aria-controls="nombre-form">
                Mi nombre presenta un error
              </button>

              <form id="nombre-form" class="datos__form" hidden novalidate>
                <div class="portal-input-group">
                  <label for="nombre-comentario" class="portal-label">¿Cómo debe escribirse correctamente?</label>
                  <textarea id="nombre-comentario" name="comentario" class="portal-input" rows="3" maxlength={LARGO_MAX_COMENTARIO} placeholder="Escribe tu nombre y apellidos según figuran en tu documento..."></textarea>
                </div>
                <button type="submit" id="nombre-enviar" class="portal-btn portal-btn--primary portal-btn--block">
                  Avisar a mi asesora
                </button>
              </form>
            </div>
          </section>
        </div>
      </div>
    </div>
  )}
</PortalLayout>

<style>
  .datos-page { width: 100%; box-sizing: border-box; }
  .datos-cabecera { margin-bottom: 24px; }
  .datos-cabecera .enlace-flecha {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 13.5px; font-weight: 500; color: var(--portal-cobre);
    text-decoration: none; margin-bottom: 12px;
  }
  .datos-cabecera .enlace-flecha:hover { text-decoration: underline; }
  .datos-cabecera__hero { display: flex; flex-direction: column; gap: 8px; }
  .datos-cabecera__hero .portal-title { margin: 0; font-size: 26px; }
  .datos-cabecera__hero .portal-desc { margin: 0; font-size: 14.5px; line-height: 1.5; color: var(--portal-mutado); max-width: 720px; }

  /* Grilla de 2 columnas en desktop para aprovechar el ancho */
  .datos-grid {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 24px;
    align-items: start;
  }

  .datos-card--primary {
    border-top: 3px solid var(--portal-cobre);
    padding: 24px;
  }
  .datos-card--side {
    background: #FAF8F5;
    border: 1px solid var(--portal-borde);
    padding: 24px;
  }
  .datos-card__header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 8px;
    color: var(--portal-azul);
  }
  .datos-card__header .section-card__title {
    margin: 0;
    padding: 0;
    border: none;
    font-size: 16px;
    font-weight: 700;
  }
  .datos-card__desc {
    margin: 0 0 20px;
    font-size: 13.5px;
    line-height: 1.5;
    color: var(--portal-mutado);
  }

  .portal-label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 13px;
    font-weight: 600;
    color: var(--portal-azul);
    margin-bottom: 6px;
  }
  .portal-label__tag {
    font-size: 11px;
    font-weight: 600;
    color: var(--portal-cobre);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .datos-form-grid {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .datos-form-grid .portal-input-group { margin-bottom: 0; }
  .datos-form-secciones { display: flex; flex-direction: column; gap: 24px; }
  .datos-fila { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: 18px; }
  .datos-col--main > .portal-alert { margin-bottom: 16px; }
  .datos-form__footer {
    padding-top: 4px;
  }

  .datos__valor-bloqueado {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 10px 14px;
    background: #F1F5F9;
    border: 1px solid var(--portal-borde);
    border-radius: var(--portal-radio);
  }
  .datos__valor-texto { font-size: 15px; font-weight: 600; color: var(--portal-azul); }

  /* Lista de contacto */
  .datos-contacto-lista {
    margin: 0 0 16px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .datos-contacto-item {
    padding-bottom: 10px;
    border-bottom: 1px solid rgba(11, 27, 46, 0.08);
  }
  .datos-contacto-item:last-child { border-bottom: none; padding-bottom: 0; }
  .datos-contacto-label {
    font-size: 11.5px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--portal-mutado);
    margin-bottom: 2px;
  }
  .datos-contacto-val {
    margin: 0;
    font-size: 14.5px;
    font-weight: 600;
    color: var(--portal-azul);
    overflow-wrap: anywhere;
  }
  .datos__nota-contacto {
    margin: 0 0 16px;
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--portal-mutado);
  }

  .datos-nombre-box {
    padding-top: 14px;
    border-top: 1px solid var(--portal-borde);
  }
  .portal-btn--block { width: 100%; box-sizing: border-box; justify-content: center; }
  .datos__form { margin-top: 14px; display: flex; flex-direction: column; gap: 12px; }
  .datos__error { margin: 6px 0 0; font-size: 12.5px; font-weight: 600; color: var(--portal-rojo); }
  .datos__nota { margin: 6px 0 0; font-size: 12.5px; line-height: 1.45; color: var(--portal-mutado); }
  .portal-alert[hidden], .datos__error[hidden], .datos__form[hidden] { display: none; }
  textarea.portal-input { resize: vertical; font-family: inherit; }

  @media (max-width: 899px) {
    .datos-grid { grid-template-columns: 1fr; gap: 20px; }
  }
</style>

<script>
  import { construirCambios, mensajeErrorDatos, tocaDatosPersonales, CAMPOS_DATOS, type ErrorDatos } from '../../lib/datos-pure.ts';

  const REDIRECCION_LOGIN = '/mi-postulacion/ingresar';
  const CABECERAS = { 'Content-Type': 'application/json', 'X-FGREC-Portal': '1' };
  const ERROR_RED = 'No pudimos conectar con el servicio. Revisa tu conexión e inténtalo de nuevo.';

  const el = <T extends HTMLElement>(id: string) => document.getElementById(id) as T | null;

  function mostrar(caja: HTMLElement | null, mensaje: string) {
    if (!caja) return;
    caja.textContent = mensaje;
    caja.hidden = false;
    caja.focus();
  }
  function ocultar(...cajas: Array<HTMLElement | null>) {
    cajas.forEach((c) => { if (c) { c.hidden = true; c.textContent = ''; } });
  }

  /** POST JSON; devuelve status y cuerpo. Con 401 la sesión terminó: vuelve a ingresar. */
  async function enviar(ruta: string, cuerpo: unknown): Promise<{ status: number; data: any } | null> {
    try {
      const res = await fetch(ruta, { method: 'POST', headers: CABECERAS, credentials: 'same-origin', body: JSON.stringify(cuerpo) });
      if (res.status === 401) {
        window.location.href = REDIRECCION_LOGIN;
        return null;
      }
      let data: any = {};
      try { data = await res.json(); } catch { /* sin cuerpo */ }
      return { status: res.status, data };
    } catch {
      return { status: 0, data: null };
    }
  }

  // --- Aviso de nombre ---
  const abrir = el<HTMLButtonElement>('nombre-abrir');
  const formNombre = el<HTMLFormElement>('nombre-form');
  const comentario = el<HTMLTextAreaElement>('nombre-comentario');
  const enviarNombre = el<HTMLButtonElement>('nombre-enviar');
  const nombreEstado = el('nombre-estado');
  const nombreError = el('nombre-error');

  abrir?.addEventListener('click', () => {
    if (!formNombre) return;
    const abierto = formNombre.hidden;
    formNombre.hidden = !abierto;
    abrir.setAttribute('aria-expanded', String(abierto));
    if (abierto) comentario?.focus();
  });

  formNombre?.addEventListener('submit', async (e) => {
    e.preventDefault();
    ocultar(nombreEstado, nombreError);
    if (enviarNombre) enviarNombre.disabled = true;
    const texto = comentario?.value.trim() ?? '';
    const r = await enviar('/api/portal/datos/nombre', texto ? { comentario: texto } : {});
    if (enviarNombre) enviarNombre.disabled = false;
    if (!r) return;
    if (r.status === 200 && r.data?.avisado) {
      formNombre.hidden = true;
      abrir?.setAttribute('aria-expanded', 'false');
      if (comentario) comentario.value = '';
      mostrar(nombreEstado, 'Le avisamos a tu asesora. Va a corregir tu nombre.');
    } else {
      mostrar(nombreError, r.status === 0 ? ERROR_RED : mensajeErrorDatos(r.status, r.data).mensaje);
    }
  });

  // --- Datos del postulante (documento, fecha de nacimiento, nacionalidad y domicilio) ---
  const form = el<HTMLFormElement>('datos-form');
  const guardar = el<HTMLButtonElement>('datos-guardar');
  const estado = el('datos-estado');
  const error = el('datos-error');

  const documentoEditable = form?.dataset.documentoEditable === '1';
  const datosEditables = form?.dataset.datosEditables === '1';
  let actual: Record<string, string> = JSON.parse(form?.dataset.actual ?? '{}');

  const campoInput = (campo: string) => el<HTMLInputElement | HTMLSelectElement>(`datos-${campo}`);
  const campoError = (campo: string) => el(`datos-${campo}-error`);

  function limpiarErrores() {
    ocultar(estado, error);
    for (const campo of ['documento', ...CAMPOS_DATOS]) {
      ocultar(campoError(campo));
      campoInput(campo)?.removeAttribute('aria-invalid');
    }
  }

  function mostrarError(e: ErrorDatos) {
    const input = e.campo && e.campo !== 'comentario' ? campoInput(e.campo) : null;
    const caja = e.campo ? campoError(e.campo) : null;
    if (input && caja) {
      input.setAttribute('aria-invalid', 'true');
      caja.textContent = e.mensaje;
      caja.hidden = false;
      input.focus();
    } else {
      mostrar(error, e.mensaje);
    }
  }

  form?.addEventListener('submit', async (ev) => {
    ev.preventDefault();
    limpiarErrores();
    // Un campo que no se dibujó (bloqueado) no tiene input: queda sin valor y no viaja.
    const nuevo: Record<string, string | undefined> = {};
    for (const campo of ['documento', ...CAMPOS_DATOS]) nuevo[campo] = campoInput(campo)?.value;
    const cambios = construirCambios(actual, nuevo, documentoEditable, datosEditables);
    if (!Object.keys(cambios).length) {
      mostrar(estado, 'No hay cambios para guardar.');
      return;
    }
    const bloqueConsentimiento = el('datos-consentimiento');
    if (bloqueConsentimiento && tocaDatosPersonales(cambios)) {
      const acepto = el<HTMLInputElement>('datos-consentimiento-acepto');
      const errorConsentimiento = el('datos-consentimiento-error');
      ocultar(errorConsentimiento);
      if (!acepto?.checked) {
        if (errorConsentimiento) {
          errorConsentimiento.textContent = 'Para guardar tus datos personales, marca que aceptas la autorización.';
          errorConsentimiento.hidden = false;
        }
        acepto?.focus();
        return;
      }
      if (guardar) guardar.disabled = true;
      const c = await enviar('/api/portal/consentimiento', { codigo: bloqueConsentimiento.dataset.codigo, version: bloqueConsentimiento.dataset.version });
      if (!c) return;
      if (c.status !== 200 && c.status !== 201) {
        if (guardar) guardar.disabled = false;
        mostrar(error, c.status === 0 ? ERROR_RED : (c.data?.message || 'No pudimos registrar tu aceptación. Inténtalo de nuevo.'));
        return;
      }
      bloqueConsentimiento.remove();
    }
    if (guardar) guardar.disabled = true;
    const r = await enviar('/api/portal/datos', cambios);
    if (guardar) guardar.disabled = false;
    if (!r) return;
    if (r.status === 200) {
      for (const [campo, enviado] of Object.entries(cambios)) {
        // FGREC puede normalizar lo guardado; si no devuelve el campo, vale lo que se envió.
        const guardado = typeof r.data?.[campo] === 'string' ? r.data[campo] : (enviado as string);
        actual[campo] = guardado;
        const input = campoInput(campo);
        if (input) input.value = guardado;
      }
      mostrar(estado, 'Guardamos tus datos.');
    } else {
      mostrarError(r.status === 0 ? { campo: null, mensaje: ERROR_RED } : mensajeErrorDatos(r.status, r.data));
    }
  });
</script>
