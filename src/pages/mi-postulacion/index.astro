---
export const prerender = false;

import AsesoriaCard from '../../components/AsesoriaCard.astro';
import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import { cartaEnviadaEnPanel, resumirDocumentosPanel } from '../../lib/portal-pure.ts';
import { leerConvenio, formatearFechaConvenio } from '../../lib/convenio-pure.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;
const resumenDocumentos = resumirDocumentosPanel(documentos, postulacion.expediente);

// Obtener nombre de pila del postulante para un saludo personalizado institucional
let nombrePostulante = '';
try {
  const respCtx = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'precalificador/contexto',
    sesion: sesionToken,
    contexto
  });
  if (respCtx.ok && respCtx.data?.nombre) {
    nombrePostulante = respCtx.data.nombre;
  }
} catch {
  // Saludo fallback
}

// Estado del convenio de corresponsabilidad (solo lectura). Si la consulta falla, el panel simplemente no lo muestra.
let convenio = leerConvenio(null);
try {
  const respConvenio = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'convenio',
    sesion: sesionToken,
    contexto
  });
  if (respConvenio.ok) {
    convenio = leerConvenio(respConvenio.data);
  }
} catch {
  // Sin estado de convenio
}
const convenioPendiente = convenio.estado === 'GENERADO';
const convenioAceptado = convenio.estado === 'ACEPTADO';
const fechaConvenio = formatearFechaConvenio(convenio.aceptadoEn);

// Mapeo jerárquico formal de etapas públicas a las 5 fases del proceso de admisión
const pasoCodigo = paso.codigo || 'ORIENTACION';
let faseActiva = 1;
if (pasoCodigo === 'ORIENTACION') {
  faseActiva = 1;
} else if (['CARTA_INTERES', 'DOCUMENTACION', 'DOCUMENTACION_COMPLETA'].includes(pasoCodigo)) {
  faseActiva = 2;
} else if (['EVALUACION_ACADEMICA'].includes(pasoCodigo)) {
  faseActiva = 3;
} else if (['FONDO_ECUADOR'].includes(pasoCodigo)) {
  faseActiva = 4;
} else if (['PROPUESTA', 'RESERVA_CONFIRMADA', 'INSCRIPCION_CONFIRMADA'].includes(pasoCodigo)) {
  faseActiva = 5;
}

const accionConvenio = proximoPaso?.codigo === 'ACEPTAR_CONVENIO';
// Un convenio pendiente tiene prioridad sobre el aviso de revisión: es lo único que el postulante puede hacer.
const enRevision = pasoCodigo === 'DOCUMENTACION_COMPLETA' && !accionConvenio;
const cartaEnviada = cartaEnviadaEnPanel(postulacion, enRevision);
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc">
        Ha realizado demasiadas solicitudes en poco tiempo. Por favor espere unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc">
        El servicio no está disponible temporalmente; intente de nuevo en unos minutos. Si requiere atención inmediata, puede contactar a nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="postulacion-container">

      <!-- FICHA DE EXPEDIENTE DEL POSTULANTE -->
      <header class="applicant-bar">
        <div class="applicant-bar__info">
          <h1 class="applicant-bar__name">
            {nombrePostulante ? nombrePostulante : 'Expediente del Postulante'}
          </h1>
          {situacion === 'ACTIVA' && (
            <span class="badge-tag badge-tag--active">Postulación activa</span>
          )}
          {situacion === 'EN_PAUSA' && (
            <span class="badge-tag badge-tag--pause">En pausa {postulacion.pausaHasta ? `hasta ${postulacion.pausaHasta}` : ''}</span>
          )}
          {situacion === 'CERRADA' && (
            <span class="badge-tag badge-tag--closed">Postulación cerrada</span>
          )}
        </div>
        <div class="applicant-bar__program">
          Red Universitaria FGREC &middot; Universidad asociada: <strong>UGR</strong>
        </div>
      </header>

      <!-- MAPA DE FASES / STEPPER FORMAL INSTITUCIONAL -->
      <section class="stepper-card" aria-label="Fases del proceso de admisión académica">
        <div class="stepper-card__header">
          <h2 class="stepper-card__title">Proceso de Admisión Académica</h2>
          <span class="stepper-card__legend">Campaña Ingreso Marzo 2027</span>
        </div>

        <ol class="stepper">
          <!-- Fase 1 -->
          <li class={`step ${faseActiva > 1 ? 'step--completed' : faseActiva === 1 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 1 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '1'}
            </div>
            <span class="step__title">1. Orientación y Registro</span>
            <span class="step__status">{faseActiva > 1 ? 'Completado' : 'En curso'}</span>
          </li>

          <!-- Fase 2 -->
          <li class={`step ${faseActiva > 2 ? 'step--completed' : faseActiva === 2 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 2 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '2'}
            </div>
            <span class="step__title">2. Documentación y Carta</span>
            <span class="step__status">
              {faseActiva > 2 ? 'Completado' : faseActiva === 2 ? (enRevision ? 'En revisión' : 'En curso') : 'Pendiente'}
            </span>
          </li>

          <!-- Fase 3 -->
          <li class={`step ${faseActiva > 3 ? 'step--completed' : faseActiva === 3 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 3 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '3'}
            </div>
            <span class="step__title">3. Dictamen y Admisión</span>
            <span class="step__status">{faseActiva > 3 ? 'Completado' : faseActiva === 3 ? 'En curso' : 'Pendiente'}</span>
          </li>

          <!-- Fase 4 -->
          <li class={`step ${faseActiva > 4 ? 'step--completed' : faseActiva === 4 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 4 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '4'}
            </div>
            <span class="step__title">4. Fondo Institucional</span>
            <span class="step__status">{faseActiva > 4 ? 'Completado' : faseActiva === 4 ? 'En curso' : 'Pendiente'}</span>
          </li>

          <!-- Fase 5 -->
          <li class={`step ${faseActiva === 5 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">5</div>
            <span class="step__title">5. Matrícula y Alta</span>
            <span class="step__status">{faseActiva === 5 ? 'En curso' : 'Final'}</span>
          </li>
        </ol>
      </section>

      <!-- GRID PRINCIPAL -->
      <div class="postulacion-layout">

        <!-- COLUMNA PRINCIPAL DE ACCIÓN -->
        <div class="postulacion-main">

          <!-- TARJETA PRINCIPAL DE ACCIÓN REQUERIDA -->
          <article class="action-card">
            <span class="action-card__tag">
              {enRevision
                ? 'Expediente remitido a secretaría'
                : `Fase ${faseActiva} en curso · Requerimiento de admisión`}
            </span>

            <h2 class="action-card__heading">
              {enRevision
                ? 'Expediente formal en revisión institucional'
                : proximoPaso?.codigo === 'CARGAR_DOCUMENTOS' || proximoPaso?.codigo === 'SUBSANAR_DOCUMENTOS'
                ? 'Completar expediente de admisión institucional'
                : proximoPaso?.codigo === 'ESCRIBIR_CARTA'
                ? 'Presentar carta de interés institucional'
                : proximoPaso?.codigo === 'ACEPTAR_CONVENIO'
                ? 'Revisar y aceptar su convenio de corresponsabilidad'
                : proximoPaso?.codigo === 'COMPLETAR_PRECALIFICADOR'
                ? 'Completar registro de antecedentes previos'
                : paso.nombre}
            </h2>

            <p class="action-card__lead">
              {enRevision
                ? 'Su documentación y carta de interés han sido recibidas y se encuentran bajo revisión de la Dirección de Admisiones y la universidad asociada.'
                : proximoPaso?.texto
                ? proximoPaso.texto
                : 'Para remitir su legajo a la Dirección de Admisiones y al comité académico de la universidad asociada, es necesario consignar la documentación obligatoria requerida y su carta de interés institucional.'}
            </p>

            <!-- AUDITORÍA DE ELEMENTOS PENDIENTES -->
            <div class="audit-list">
              <div class="audit-list__row">
                <div class="audit-list__col-left">
                  <span class={`audit-indicator ${resumenDocumentos.completos ? 'audit-indicator--ok' : 'audit-indicator--pending'}`}>
                    {resumenDocumentos.completos && (
                      <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </span>
                  <span>Documentos de identidad y título habilitante</span>
                </div>
                <span class={`badge-status ${resumenDocumentos.completos ? 'badge-status--ok' : 'badge-status--pending'}`}>
                  {resumenDocumentos.etiqueta}
                </span>
              </div>

              <div class="audit-list__row">
                <div class="audit-list__col-left">
                  <span class={`audit-indicator ${cartaEnviada ? 'audit-indicator--ok' : 'audit-indicator--pending'}`}>
                    {cartaEnviada && (
                      <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </span>
                  <span>Carta de interés institucional</span>
                </div>
                {cartaEnviada ? (
                  <span class="badge-status badge-status--ok">Enviada</span>
                ) : (
                  <span class="badge-status badge-status--pending">Borrador o pendiente</span>
                )}
              </div>

              <div class="audit-list__row">
                <div class="audit-list__col-left">
                  <span class="audit-indicator audit-indicator--ok">
                    <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                      <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                    </svg>
                  </span>
                  <span>Consentimiento para tratamiento de datos académicos</span>
                </div>
                <span class="badge-status badge-status--ok">Registrado</span>
              </div>

              {(convenioPendiente || convenioAceptado) && (
                <div class="audit-list__row">
                  <div class="audit-list__col-left">
                    <span class={`audit-indicator ${convenioAceptado ? 'audit-indicator--ok' : 'audit-indicator--pending'}`}>
                      {convenioAceptado && (
                        <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                        </svg>
                      )}
                    </span>
                    <span>Convenio de corresponsabilidad</span>
                  </div>
                  {convenioAceptado ? (
                    <span class="badge-status badge-status--ok">Aceptado{fechaConvenio ? ` el ${fechaConvenio}` : ''}</span>
                  ) : (
                    <span class="badge-status badge-status--pending">Pendiente de aceptación</span>
                  )}
                </div>
              )}
            </div>

            <!-- BOTÓN PRINCIPAL DE GESTIÓN -->
            {enRevision ? (
              <a href="/mi-postulacion/documentos" class="btn-primary">
                <span>Ver expediente presentado</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : proximoPaso?.codigo === 'ESCRIBIR_CARTA' ? (
              <a href="/mi-postulacion/documentos#carta" class="btn-primary">
                <span>Redactar carta de interés</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : proximoPaso?.codigo === 'ACEPTAR_CONVENIO' ? (
              <a href="/mi-postulacion/convenio" class="btn-primary">
                <span>Leer y aceptar mi convenio</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : proximoPaso?.codigo === 'COMPLETAR_PRECALIFICADOR' ? (
              <a href="/mi-postulacion/precalificador" class="btn-primary">
                <span>Completar preguntas previas</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : (
              <a href="/mi-postulacion/documentos" class="btn-primary">
                <span>Gestionar documentación y carta de interés</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </article>

          <!-- SEGUIMIENTO ARANCELARIO -->
          <section class="aranceles-card" aria-labelledby="pagos-titulo">
            <div class="aranceles-card__header">
              <h3 class="aranceles-card__title" id="pagos-titulo">Aranceles y Registro de Pagos</h3>
            </div>
            <p class="aranceles-card__text">
              Consulte los pagos que ya figuran en su postulación e informe uno nuevo adjuntando su comprobante. FGREC revisa cada envío antes de confirmarlo.
            </p>
            <a href="/mi-postulacion/pagos" class="aranceles-card__link">
              <span>Ver mis pagos e informar un pago</span>
              <span aria-hidden="true">&rarr;</span>
            </a>
          </section>

        </div>

        <!-- COLUMNA LATERAL (ASESORÍA INSTITUCIONAL) -->
        <aside class="postulacion-aside">
          <AsesoriaCard asesora={asesora} whatsappHref={whatsappHref} />
        </aside>

      </div>

    </div>
  )}
</PortalLayout>

<style>
  .error-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: #FFFFFF;
    border: 1px solid var(--portal-borde);
    border-radius: var(--portal-radio);
  }

  /* BARRA DE EXPEDIENTE DEL POSTULANTE */
  .applicant-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 12px;
    padding-bottom: 16px;
    margin-bottom: 24px;
    border-bottom: 1px solid var(--portal-borde);
  }
  .applicant-bar__info {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-wrap: wrap;
  }
  .applicant-bar__name {
    font-family: var(--serif);
    font-size: 24px;
    font-weight: 600;
    color: var(--portal-azul);
    margin: 0;
    letter-spacing: -0.01em;
  }
  .badge-tag {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 3px 9px;
    border-radius: 3px;
  }
  .badge-tag--active {
    background: var(--portal-verde-fondo);
    color: var(--portal-verde);
    border: 1px solid #C4DEC8;
  }
  .badge-tag--pause {
    background: var(--portal-ambar-fondo);
    color: var(--portal-ambar);
    border: 1px solid #F6DFB3;
  }
  .badge-tag--closed {
    background: var(--portal-rojo-fondo);
    color: var(--portal-rojo);
    border: 1px solid #F5C2C0;
  }
  .applicant-bar__program {
    font-size: 13.5px;
    color: var(--portal-mutado);
  }
  .applicant-bar__program strong {
    color: var(--portal-azul);
    font-weight: 600;
  }

  /* STEPPER FORMAL INSTITUCIONAL */
  .stepper-card {
    background: var(--portal-blanco);
    border: 1px solid var(--portal-borde);
    border-radius: 4px;
    padding: 24px 28px;
    margin-bottom: 28px;
    box-shadow: 0 1px 3px rgba(11, 27, 46, 0.04);
  }
  .stepper-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
  }
  .stepper-card__title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--portal-cobre-texto);
    margin: 0;
  }
  .stepper-card__legend {
    font-size: 12px;
    color: var(--portal-mutado);
  }

  .stepper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stepper::before {
    content: "";
    position: absolute;
    top: 17px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: #CBD5E1;
    z-index: 1;
  }
  .step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .step__marker {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #94A3B8;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 10px;
    transition: all 0.2s;
  }
  .step--completed .step__marker {
    background: var(--portal-verde);
    border-color: var(--portal-verde);
    color: #FFFFFF;
  }
  .step--active .step__marker {
    background: var(--portal-azul);
    border-color: var(--portal-cobre);
    color: #FFFFFF;
    box-shadow: 0 0 0 4px rgba(201, 138, 75, 0.2);
  }
  .step__title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--portal-mutado);
    line-height: 1.3;
  }
  .step--active .step__title {
    color: var(--portal-azul);
    font-weight: 700;
  }
  .step__status {
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
    color: #94A3B8;
  }
  .step--completed .step__status { color: var(--portal-verde); }
  .step--active .step__status { color: var(--portal-cobre-texto); }

  /* SECCIÓN ARANCELARIA */
  .aranceles-card {
    background: var(--portal-blanco);
    border: 1px solid var(--portal-borde);
    border-radius: 4px;
    padding: 24px;
    box-shadow: 0 1px 3px rgba(11, 27, 46, 0.03);
  }
  .aranceles-card__header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 10px;
  }
  .aranceles-card__title {
    font-size: 16px;
    font-weight: 700;
    color: var(--portal-azul);
    margin: 0;
  }
  .aranceles-card__text {
    font-size: 13.5px;
    color: var(--portal-mutado);
    margin: 0 0 16px 0;
    line-height: 1.5;
  }
  .aranceles-card__link {
