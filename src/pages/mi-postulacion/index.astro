---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import { cartaEnviadaEnPanel, loQueSigue, resumirDocumentosPanel } from '../../lib/portal-pure.ts';
import { leerConvenio, formatearFechaConvenio } from '../../lib/convenio-pure.ts';
import { datosFaltantes, leerDatos } from '../../lib/datos-pure.ts';
import AsesoriaCard from '../../components/AsesoriaCard.astro';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;
const resumenDocumentos = resumirDocumentosPanel(documentos, postulacion.expediente);

// Obtener nombre de pila del postulante para un saludo personalizado institucional
let nombrePostulante = '';
try {
  const respCtx = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'precalificador/contexto',
    sesion: sesionToken,
    contexto
  });
  if (respCtx.ok && respCtx.data?.nombre) {
    nombrePostulante = respCtx.data.nombre;
  }
} catch {
  // Saludo fallback
}

// Estado del convenio de corresponsabilidad (solo lectura). Si la consulta falla, el panel simplemente no lo muestra.
let convenio = leerConvenio(null);
try {
  const respConvenio = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'convenio',
    sesion: sesionToken,
    contexto
  });
  if (respConvenio.ok) {
    convenio = leerConvenio(respConvenio.data);
  }
} catch {
  // Sin estado de convenio
}
const convenioPendiente = convenio.estado === 'GENERADO';

// Lo que FGREC todavía no tiene del postulante: se avisa arriba, sin tener que bajar. Si la consulta falla, no se avisa.
let faltantes: string[] = [];
try {
  const respDatos = await llamarFGRECPortal({ metodo: 'GET', rutaRelativa: 'datos', sesion: sesionToken, contexto });
  if (respDatos.ok) faltantes = datosFaltantes(leerDatos(respDatos.data));
} catch {
  // Sin aviso de datos
}
const convenioAceptado = convenio.estado === 'ACEPTADO';
const fechaConvenio = formatearFechaConvenio(convenio.aceptadoEn);

// Mapeo jerárquico formal de etapas públicas a las 5 fases del proceso de admisión
const pasoCodigo = paso.codigo || 'ORIENTACION';
let faseActiva = 1;
if (pasoCodigo === 'ORIENTACION') {
  faseActiva = 1;
} else if (['CARTA_INTERES', 'DOCUMENTACION', 'DOCUMENTACION_COMPLETA'].includes(pasoCodigo)) {
  faseActiva = 2;
} else if (['EVALUACION_ACADEMICA'].includes(pasoCodigo)) {
  faseActiva = 3;
} else if (['FONDO_ECUADOR'].includes(pasoCodigo)) {
  faseActiva = 4;
} else if (['PROPUESTA', 'RESERVA_CONFIRMADA', 'INSCRIPCION_CONFIRMADA'].includes(pasoCodigo)) {
  faseActiva = 5;
}

const accionConvenio = proximoPaso?.codigo === 'ACEPTAR_CONVENIO';
// Un convenio pendiente tiene prioridad sobre el aviso de revisión: es lo único que el postulante puede hacer.
const enRevision = pasoCodigo === 'DOCUMENTACION_COMPLETA' && !accionConvenio;
const cartaEnviada = cartaEnviadaEnPanel(postulacion, enRevision);

// «Lo que sigue»: una sola acción según la etapa (src/lib/portal-pure.ts). Una postulación en pausa sigue su próximo paso.
const siguiente = loQueSigue(postulacion);
const FASES = ['Orientación y registro', 'Documentación y carta', 'Dictamen y admisión', 'Fondo Institucional', 'Matrícula y alta'];
const estadoDatos = faltantes.length === 0 ? 'Completos'
  : faltantes.length === 1 ? `Falta ${faltantes[0].replace(/^tu /, '')}` : `Faltan ${faltantes.length} datos`;
const filas = [
  { nombre: 'Documentos', ok: resumenDocumentos.completos, estado: resumenDocumentos.etiqueta, href: '/mi-postulacion/documentos', accion: resumenDocumentos.completos ? 'Ver documentos' : 'Cargar documentos' },
  { nombre: 'Carta de interés', ok: cartaEnviada, estado: cartaEnviada ? 'Enviada' : 'Pendiente', href: '/mi-postulacion/documentos#carta', accion: cartaEnviada ? 'Ver la carta' : 'Escribir la carta' },
  { nombre: 'Tus datos', ok: faltantes.length === 0, estado: estadoDatos, href: '/mi-postulacion/datos', accion: faltantes.length === 0 ? 'Ver mis datos' : 'Completar mis datos' },
  ...(convenioPendiente || convenioAceptado
    ? [{ nombre: 'Convenio de corresponsabilidad', ok: convenioAceptado, estado: convenioAceptado ? `Aceptado${fechaConvenio ? ` el ${fechaConvenio}` : ''}` : 'Por aceptar', href: '/mi-postulacion/convenio', accion: convenioAceptado ? 'Ver el convenio' : 'Leer el convenio' }]
    : [])
];
// Lo que la barra lateral cuenta como pendiente en cada sección.
const pendientesExpediente = Number(documentos.pendientes ?? 0) + Number(documentos.observados ?? 0) + (cartaEnviada ? 0 : 1) + (convenioPendiente ? 1 : 0);
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true} pendientes={{ expediente: pendientesExpediente, datos: faltantes.length }}>
  {statusError === 429 ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc">
        Hiciste demasiadas solicitudes en poco tiempo. Espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc">
        El servicio no está disponible por ahora; inténtalo de nuevo en unos minutos. Si necesitas ayuda ya, escríbenos por nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="inicio">
      <header class="inicio__cabecera">
        <p class="antetitulo inicio__antetitulo">Mi postulación · Red Universitaria FGREC</p>
        <div class="inicio__saludo">
          <h1 class="inicio__titulo">{nombrePostulante ? `Hola, ${nombrePostulante}` : 'Mi postulación'}</h1>
          {situacion === 'ACTIVA' && <span class="badge-tag badge-tag--active">Postulación activa</span>}
          {situacion === 'CERRADA' && <span class="badge-tag badge-tag--closed">Postulación cerrada</span>}
        </div>
      </header>

      {faltantes.length > 0 && (
        <div class="portal-alert portal-alert--info datos-faltantes" role="status">
          <span>
            Nos falta {faltantes.join(' y ')}.
            <a href="/mi-postulacion/datos" class="datos-faltantes__link">Completar mis datos &rarr;</a>
          </span>
        </div>
      )}

      <section class="stepper-card" aria-label="Fases del proceso de admisión académica">
        <div class="stepper-card__header">
          <h2 class="stepper-card__title">Proceso de Admisión Académica</h2>
          <span class="stepper-card__legend">Campaña Ingreso Marzo 2027</span>
        </div>

        <ol class="stepper">
          <!-- Fase 1 -->
          <li class={`step ${faseActiva > 1 ? 'step--completed' : faseActiva === 1 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 1 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '1'}
            </div>
            <span class="step__title">1. Orientación y Registro</span>
            <span class="step__status">{faseActiva > 1 ? 'Completado' : 'En curso'}</span>
          </li>

          <!-- Fase 2 -->
          <li class={`step ${faseActiva > 2 ? 'step--completed' : faseActiva === 2 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 2 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '2'}
            </div>
            <span class="step__title">2. Documentación y Carta</span>
            <span class="step__status">
              {faseActiva > 2 ? 'Completado' : faseActiva === 2 ? (enRevision ? 'En revisión' : 'En curso') : 'Pendiente'}
            </span>
          </li>

          <!-- Fase 3 -->
          <li class={`step ${faseActiva > 3 ? 'step--completed' : faseActiva === 3 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 3 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '3'}
            </div>
            <span class="step__title">3. Dictamen y Admisión</span>
            <span class="step__status">{faseActiva > 3 ? 'Completado' : faseActiva === 3 ? 'En curso' : 'Pendiente'}</span>
          </li>

          <!-- Fase 4 -->
          <li class={`step ${faseActiva > 4 ? 'step--completed' : faseActiva === 4 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">
              {faseActiva > 4 ? (
                <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor">
                  <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
              ) : '4'}
            </div>
            <span class="step__title">4. Fondo Institucional</span>
            <span class="step__status">{faseActiva > 4 ? 'Completado' : faseActiva === 4 ? 'En curso' : 'Pendiente'}</span>
          </li>

          <!-- Fase 5 -->
          <li class={`step ${faseActiva === 5 ? 'step--active' : ''}`}>
            <div class="step__marker" aria-hidden="true">5</div>
            <span class="step__title">5. Matrícula y Alta</span>
            <span class="step__status">{faseActiva === 5 ? 'En curso' : 'Final'}</span>
          </li>
        </ol>
        <p class="stepper-card__actual">Fase {faseActiva} de 5 · {FASES[faseActiva - 1]}</p>
      </section>

      <div class="inicio__grid">
        <div class="inicio__principal">
          <article class="action-card inicio__accion" aria-labelledby="sigue-titulo">
            <span class="action-card__tag">{siguiente.etiqueta ?? `Fase ${faseActiva} en curso · Lo que sigue`}</span>
            <h2 class="action-card__heading" id="sigue-titulo">{siguiente.titulo}</h2>
            <p class="action-card__lead">{siguiente.texto}</p>
            {siguiente.accion ? (
              <a href={siguiente.accion.href} class="btn-primary">
                <span>{siguiente.accion.etiqueta}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            ) : siguiente.contacto && whatsappHref ? (
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full inicio__wa">Escribir a mi asesora</a>
            ) : null}
            {siguiente.enlace && (
              <a href={siguiente.enlace.href} class="inicio__enlace">{siguiente.enlace.etiqueta} <span aria-hidden="true">&rarr;</span></a>
            )}
          </article>

          <section aria-labelledby="expediente-titulo">
            <h2 class="antetitulo inicio__seccion" id="expediente-titulo">Tu expediente</h2>
            <div class="audit-list inicio__lista">
              {filas.map((f) => (
                <div class="audit-list__row">
                  <div class="audit-list__col-left">
                    <span class={`audit-indicator ${f.ok ? 'audit-indicator--ok' : 'audit-indicator--pending'}`}>
                      {f.ok && (
                        <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                      )}
                    </span>
                    <span>{f.nombre}</span>
                  </div>
                  <div class="inicio__fila-fin">
                    <span class={`badge-status ${f.ok ? 'badge-status--ok' : 'badge-status--pending'}`}>{f.estado}</span>
                    <a href={f.href} class="inicio__fila-accion">{f.accion} <span aria-hidden="true">&rarr;</span></a>
                  </div>
                </div>
              ))}
            </div>
          </section>
        </div>

        <aside class="inicio__lateral">
          <AsesoriaCard asesora={asesora} whatsappHref={whatsappHref} />
        </aside>
      </div>
    </div>
  )}
</PortalLayout>

<style>
  .error-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: #FFFFFF;
    border: 1px solid var(--portal-borde);
    border-radius: var(--portal-radio);
  }

  .inicio { display: flex; flex-direction: column; }

  .datos-faltantes { margin-bottom: 22px; }
  .datos-faltantes__link {
    margin-left: 6px;
    font-weight: 600;
    color: inherit;
    white-space: nowrap;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .inicio__cabecera { margin-bottom: 22px; }
  .inicio__antetitulo { margin-bottom: 8px; }
  .inicio__saludo { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .badge-tag { font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; padding: 3px 9px; border-radius: 3px; }
  .badge-tag--active { background: var(--portal-verde-fondo); color: var(--portal-verde); border: 1px solid #C4DEC8; }
  .badge-tag--closed { background: var(--portal-rojo-fondo); color: var(--portal-rojo); border: 1px solid #F5C2C0; }
  .inicio__titulo { margin: 0; font-family: var(--serif); font-weight: 600; font-size: 38px; line-height: 1.1; color: var(--portal-azul); text-wrap: balance; }

  .stepper-card {
    background: var(--portal-blanco);
    border: 1px solid var(--portal-borde);
    border-radius: 4px;
    padding: 24px 28px;
    margin-bottom: 28px;
    box-shadow: 0 1px 3px rgba(11, 27, 46, 0.04);
  }
  .stepper-card__header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 22px;
  }
  .stepper-card__title {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--portal-cobre-texto);
    margin: 0;
  }
  .stepper-card__legend {
    font-size: 12px;
    color: var(--portal-mutado);
  }

  .stepper {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    position: relative;
    gap: 16px;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stepper::before {
    content: "";
    position: absolute;
    top: 17px;
    left: 10%;
    right: 10%;
    height: 1px;
    background: #CBD5E1;
    z-index: 1;
  }
  .step {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }
  .step__marker {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #FFFFFF;
    border: 2px solid #94A3B8;
    color: #64748B;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
    margin-bottom: 10px;
    transition: all 0.2s;
  }
  .step--completed .step__marker {
    background: var(--portal-verde);
    border-color: var(--portal-verde);
    color: #FFFFFF;
  }
  .step--active .step__marker {
    background: var(--portal-azul);
    border-color: var(--portal-cobre);
    color: #FFFFFF;
    box-shadow: 0 0 0 4px rgba(201, 138, 75, 0.2);
  }
  .step__title {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--portal-mutado);
    line-height: 1.3;
  }
  .step--active .step__title {
    color: var(--portal-azul);
    font-weight: 700;
  }
  .step__status {
    font-size: 10.5px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-top: 4px;
    color: #94A3B8;
  }
  .step--completed .step__status { color: var(--portal-verde); }
  .step--active .step__status { color: var(--portal-cobre-texto); }

  .stepper-card__actual { display: none; margin: 14px 0 0; text-align: center; font-size: 14px; font-weight: 600; color: var(--portal-azul); }
  .inicio__grid { display: grid; grid-template-columns: minmax(0, 1fr) 300px; gap: 28px; align-items: start; }
  .inicio__accion .btn-primary { margin-top: 4px; }
  .inicio__wa { display: inline-flex; width: auto; padding: 0 22px; }
  .inicio__enlace { display: inline-block; margin-top: 4px; font-size: 14px; font-weight: 600; color: var(--portal-cobre-texto); }
  .inicio__seccion { margin: 6px 0 10px; }
  .inicio__lista { margin-bottom: 0; background: var(--portal-blanco); }
  .inicio__fila-fin { display: flex; align-items: center; gap: 18px; }
  .inicio__fila-accion { font-size: 13.5px; font-weight: 600; color: var(--portal-cobre-texto); text-decoration: none; white-space: nowrap; min-height: 44px; display: inline-flex; align-items: center; }
  .inicio__fila-accion:hover { color: var(--portal-cobre-hover); text-decoration: underline; }

  @media (max-width: 1100px) {
    .inicio__grid { grid-template-columns: minmax(0, 1fr); }
  }
  @media (max-width: 768px) {
    .inicio__titulo { font-size: 30px; }
    .stepper-card { padding: 18px 16px; }
    .stepper-card__header { margin-bottom: 16px; }
    .stepper-card__legend { display: none; }
    .stepper { gap: 0; }
    .step__marker { margin-bottom: 0; width: 30px; height: 30px; font-size: 12px; }
    .step__title, .step__status { display: none; }
    .stepper-card__actual { display: block; }
    .action-card { padding: 24px 20px; }
    .audit-list__row { flex-wrap: wrap; padding: 12px 14px; }
    .inicio__fila-fin { flex: 1 0 100%; box-sizing: border-box; flex-wrap: wrap; column-gap: 16px; row-gap: 0; padding-left: 32px; }
  }
</style>
