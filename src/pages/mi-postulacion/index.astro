---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Hablar con un asesor por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔧</div>
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas atención inmediata, puedes escribir a nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <>
      <!-- Encabezado con estado -->
      <div class="portal-card" style="border-left: 5px solid var(--portal-dorado);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
          <div>
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--portal-dorado); letter-spacing: 0.05em;">
              Paso actual
            </span>
            <h1 class="portal-title" style="margin-top: 0.25rem; font-size: 1.5rem;">
              {paso.nombre}
            </h1>
          </div>
          <div>
            {situacion === 'ACTIVA' && (
              <span style="display: inline-block; padding: 0.25rem 0.75rem; background: var(--portal-verde-fondo); color: var(--portal-verde); font-weight: 700; font-size: 0.8125rem; border-radius: 9999px;">
                Activa
              </span>
            )}
            {situacion === 'EN_PAUSA' && (
              <span style="display: inline-block; padding: 0.25rem 0.75rem; background: var(--portal-ambar-fondo); color: var(--portal-ambar); font-weight: 700; font-size: 0.8125rem; border-radius: 9999px;">
                Postulación en pausa
              </span>
            )}
            {situacion === 'CERRADA' && (
              <span style="display: inline-block; padding: 0.25rem 0.75rem; background: var(--portal-rojo-fondo); color: var(--portal-rojo); font-weight: 700; font-size: 0.8125rem; border-radius: 9999px;">
                Postulación cerrada
              </span>
            )}
          </div>
        </div>

        {asesora?.nombre && (
          <p style="margin: 0.75rem 0 0 0; font-size: 0.875rem; color: var(--portal-mutado);">
            Te acompaña en el proceso: <strong>{asesora.nombre}</strong> (Asesoría institucional FGREC).
          </p>
        )}
      </div>

      <!-- Próximo paso prioritario -->
      {proximoPaso && (
        <div class="portal-card" style="background: #F8FAFC; border-color: #CBD5E1;">
          <h2 style="font-size: 1rem; font-weight: 700; color: var(--portal-azul); margin: 0 0 0.5rem 0; display: flex; align-items: center; gap: 0.5rem;">
            <span>🎯</span> Próximo paso
          </h2>
          <p style="font-size: 0.9375rem; margin: 0 0 1rem 0; line-height: 1.5; color: var(--portal-texto);">
            {proximoPaso.texto}
          </p>

          {proximoPaso.codigo === 'CARGAR_DOCUMENTOS' || proximoPaso.codigo === 'SUBSANAR_DOCUMENTOS' ? (
            <a href="/mi-postulacion/documentos" class="portal-btn portal-btn--primary">
              Ir a mis documentos
            </a>
          ) : proximoPaso.codigo === 'COMPLETAR_PRECALIFICADOR' ? (
            <a href="/mi-postulacion/precalificador" class="portal-btn portal-btn--gold">
              Completar precalificador
            </a>
          ) : whatsappHref ? (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--outline">
              Consultar por WhatsApp
            </a>
          ) : null}
        </div>
      )}

      <!-- Resumen de documentos -->
      <div class="portal-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem;">
          <h2 style="font-size: 1.125rem; font-weight: 700; color: var(--portal-azul); margin: 0;">
            Documentos del expediente
          </h2>
          <a href="/mi-postulacion/documentos" style="font-size: 0.875rem; font-weight: 600; color: var(--portal-azul); text-decoration: underline;">
            Ver todos
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; margin: 1rem 0 1.25rem 0; text-align: center;">
          <div style="padding: 0.75rem; background: var(--portal-fondo); border-radius: 8px;">
            <div style="font-size: 1.5rem; font-weight: 700; color: var(--portal-azul);">{documentos.total}</div>
            <div style="font-size: 0.75rem; color: var(--portal-mutado);">Total</div>
          </div>
          <div style="padding: 0.75rem; background: var(--portal-fondo); border-radius: 8px;">
            <div style="font-size: 1.5rem; font-weight: 700; color: documentos.pendientes > 0 ? 'var(--portal-ambar)' : 'var(--portal-mutado)';">
              {documentos.pendientes}
            </div>
            <div style="font-size: 0.75rem; color: var(--portal-mutado);">Pendientes</div>
          </div>
          <div style="padding: 0.75rem; background: var(--portal-fondo); border-radius: 8px;">
            <div style="font-size: 1.5rem; font-weight: 700; color: documentos.observados > 0 ? 'var(--portal-rojo)' : 'var(--portal-mutado)';">
              {documentos.observados}
            </div>
            <div style="font-size: 0.75rem; color: var(--portal-mutado);">Observados</div>
          </div>
        </div>

        <a href="/mi-postulacion/documentos" class="portal-btn portal-btn--outline">
          Gestionar documentación
        </a>
      </div>

      <!-- Ayuda / Asesoría -->
      <div class="portal-card" style="text-align: center;">
        <h2 style="font-size: 1rem; font-weight: 700; color: var(--portal-azul); margin: 0 0 0.5rem 0;">
          ¿Tienes alguna duda o necesitas asistencia?
        </h2>
        <p style="font-size: 0.875rem; color: var(--portal-mutado); margin: 0 0 1rem 0;">
          Las asesoras institucionales de la Fundación Gran Rosario están disponibles para orientarte.
        </p>
        {whatsappHref ? (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            <span>Hablar con un asesor por WhatsApp</span>
          </a>
        ) : (
          <a href="/contacto" class="portal-btn portal-btn--outline">
            Contactar a la Fundación
          </a>
        )}
      </div>
    </>
  )}
</PortalLayout>
