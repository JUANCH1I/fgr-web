---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;

// Obtener nombre de pila del postulante para un saludo personalizado institucional
let nombrePostulante = '';
try {
  const respCtx = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'precalificador/contexto',
    sesion: sesionToken,
    contexto
  });
  if (respCtx.ok && respCtx.data?.nombre) {
    nombrePostulante = respCtx.data.nombre;
  }
} catch {
  // Saludo fallback
}
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Hablar con un asesor por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔧</div>
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas atención inmediata, puedes escribir a nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <>
      <!-- Hero de bienvenida institucional -->
      <section class="portal-hero-lead" style="margin-bottom: 32px;">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 16px; flex-wrap: wrap; margin-bottom: 12px;">
          <div>
            <p class="antetitulo" style="margin-bottom: 6px;">Expediente de postulación · Red Universitaria</p>
            <h1 class="portal-auth-title" style="font-size: clamp(28px, 3.5vw, 38px); margin: 0 0 6px 0;">
              {nombrePostulante ? `Bienvenido/a, ${nombrePostulante}` : 'Tu expediente académico'}
            </h1>
            <p class="entrada" style="margin: 0; font-size: 17px; max-width: 680px;">
              Seguimiento oficial de tu postulación con la Fundación del Gran Rosario Ecuador y la red de universidades aliadas.
            </p>
          </div>
          <div>
            {situacion === 'ACTIVA' && (
              <span class="badge-acento" style="background: var(--portal-verde-fondo); color: var(--portal-verde); border-color: #C4DEC8; padding: 6px 14px; font-size: 13px;">
                ● Postulación activa
              </span>
            )}
            {situacion === 'EN_PAUSA' && (
              <span class="badge-acento" style="background: var(--portal-ambar-fondo); color: var(--portal-ambar); border-color: #F6DFB3; padding: 6px 14px; font-size: 13px;">
                ⏸ En pausa {postulacion.pausaHasta ? `hasta ${postulacion.pausaHasta}` : ''}
              </span>
            )}
            {situacion === 'CERRADA' && (
              <span class="badge-acento" style="background: var(--portal-rojo-fondo); color: var(--portal-rojo); border-color: #F5C2C0; padding: 6px 14px; font-size: 13px;">
                ✕ Postulación cerrada
              </span>
            )}
          </div>
        </div>

        {asesora?.nombre && (
          <div style="margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--portal-borde); display: flex; align-items: center; justify-content: space-between; gap: 16px; flex-wrap: wrap;">
            <div style="font-size: 15px; color: var(--portal-mutado);">
              Asesora institucional asignada: <strong style="color: var(--portal-azul);">{asesora.nombre}</strong>
            </div>
            {whatsappHref && (
              <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="enlace-flecha" style="font-size: 14px;">
                Contactar por WhatsApp <span aria-hidden="true">→</span>
              </a>
            )}
          </div>
        )}
      </section>

      <!-- Grid principal de dos columnas -->
      <div class="portal-dashboard-grid">
        <!-- Columna principal (izquierda) -->
        <div class="portal-dashboard-main">
          <!-- Etapa actual y acción prioritaria -->
          <div class="tarjeta" style="background: #FFFFFF; border-left: 4px solid var(--portal-cobre); position: relative;">
            <p class="antetitulo" style="margin-bottom: 6px;">Etapa del proceso</p>
            <div style="display: flex; justify-content: space-between; align-items: baseline; gap: 12px; flex-wrap: wrap; margin-bottom: 12px;">
              <h2 style="font-size: 26px; color: var(--portal-azul); margin: 0;">
                {paso.nombre}
              </h2>
              <span style={`font-size: 13px; font-weight: 700; color: ${situacion === 'EN_PAUSA' ? 'var(--portal-ambar)' : situacion === 'CERRADA' ? 'var(--portal-rojo)' : 'var(--portal-cobre-texto)'}; text-transform: uppercase; letter-spacing: 0.08em;`}>
                {situacion === 'EN_PAUSA' ? 'En pausa' : situacion === 'CERRADA' ? 'Cerrada' : 'En curso'}
              </span>
            </div>

            {proximoPaso ? (
              <div style="background: var(--crema, #F7F4EE); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio); padding: 18px 20px; margin-top: 16px;">
                <p class="antetitulo" style="color: var(--portal-cobre-texto); margin-bottom: 4px;">🎯 Próxima acción requerida</p>
                <p style="font-size: 16px; font-weight: 600; color: var(--portal-azul); margin: 0 0 16px 0; line-height: 1.4;">
                  {proximoPaso.texto}
                </p>

                {proximoPaso.codigo === 'CARGAR_DOCUMENTOS' || proximoPaso.codigo === 'SUBSANAR_DOCUMENTOS' ? (
                  <a href="/mi-postulacion/documentos" class="boton boton--acento" style="display: inline-flex;">
                    Gestionar mis documentos
                  </a>
                ) : proximoPaso.codigo === 'ESCRIBIR_CARTA' ? (
                  <a href="/mi-postulacion/documentos#carta" class="boton boton--acento" style="display: inline-flex;">
                    Escribir mi carta
                  </a>
                ) : proximoPaso.codigo === 'COMPLETAR_PRECALIFICADOR' ? (
                  <a href="/mi-postulacion/precalificador" class="boton boton--acento" style="display: inline-flex;">
                    Completar preguntas previas
                  </a>
                ) : whatsappHref ? (
                  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="boton boton--contorno" style="display: inline-flex;">
                    Consultar con mi asesora
                  </a>
                ) : null}
              </div>
            ) : (
              <p class="entrada" style="font-size: 16px; margin: 12px 0 0 0;">
                Tu expediente se encuentra al día. El equipo de admisiones está revisando la información.
              </p>
            )}
          </div>

          <!-- Resumen del expediente documental -->
          <div class="tarjeta" style="background: #FFFFFF;">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px; flex-wrap: wrap; gap: 8px;">
              <div>
                <p class="antetitulo" style="margin-bottom: 4px;">Documentación académica</p>
                <h2 style="font-size: 24px; color: var(--portal-azul); margin: 0;">
                  Estado del expediente
                </h2>
              </div>
              <a class="enlace-flecha" href="/mi-postulacion/documentos">
                Ver todos los documentos <span aria-hidden="true">→</span>
              </a>
            </div>

            <p style="font-size: 15px; color: var(--portal-mutado); margin: 0 0 18px 0; line-height: 1.5;">
              La universidad aliada requiere la validación de estos requisitos para emitir el dictamen académico formal.
            </p>

            <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin-bottom: 22px; text-align: center;">
              <div style="padding: 16px; background: var(--crema, #F7F4EE); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
                <div style="font-size: 32px; font-weight: 700; font-family: var(--serif); color: var(--portal-azul); line-height: 1;">
                  {documentos.total}
                </div>
                <div style="font-size: 12px; font-weight: 700; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 6px;">
                  Requisitos totales
                </div>
              </div>

              <div style="padding: 16px; background: var(--crema, #F7F4EE); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
                <div style={`font-size: 32px; font-weight: 700; font-family: var(--serif); color: ${documentos.pendientes > 0 ? 'var(--portal-cobre-texto)' : 'var(--portal-mutado)'}; line-height: 1;`}>
                  {documentos.pendientes}
                </div>
                <div style="font-size: 12px; font-weight: 700; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 6px;">
                  Pendientes
                </div>
              </div>

              <div style="padding: 16px; background: var(--crema, #F7F4EE); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
                <div style={`font-size: 32px; font-weight: 700; font-family: var(--serif); color: ${documentos.observados > 0 ? 'var(--portal-rojo)' : 'var(--portal-mutado)'}; line-height: 1;`}>
                  {documentos.observados}
                </div>
                <div style="font-size: 12px; font-weight: 700; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 6px;">
                  Observados
                </div>
              </div>
            </div>

            <div style="display: flex; gap: 12px; flex-wrap: wrap;">
              <a href="/mi-postulacion/documentos" class="boton boton--contorno">
                Abrir módulo de documentos
              </a>
              {documentos.pendientes > 0 && (
                <a href="/mi-postulacion/documentos" class="boton boton--acento">
                  Cargar documentos pendientes
                </a>
              )}
            </div>
          </div>
        </div>

        <!-- Columna lateral (derecha) -->
        <div class="portal-dashboard-aside">
          <!-- Tarjeta Destacada: Tu Asesor Institucional Asignado -->
          <div class="tarjeta" style="background: #FFFFFF; border-top: 4px solid var(--portal-cobre); box-shadow: 0 4px 16px rgba(11, 27, 46, 0.06);">
            <p class="antetitulo" style="margin-bottom: 6px;">Asesoría Personalizada</p>
            <h3 style="font-size: 21px; color: var(--portal-azul); margin-bottom: 12px;">
              Tu Asesor Asignado
            </h3>

            {asesora?.nombre ? (
              <div>
                <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 14px; background: var(--crema, #F7F4EE); padding: 14px 16px; border-radius: var(--portal-radio); border: 1px solid var(--portal-borde);">
                  <div style="width: 48px; height: 48px; border-radius: 50%; background: var(--portal-azul); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 20px; font-weight: 700; flex-shrink: 0; font-family: var(--serif);">
                    {asesora.nombre.charAt(0).toUpperCase()}
                  </div>
                  <div>
                    <strong style="display: block; font-size: 17px; color: var(--portal-azul); line-height: 1.2;">
                      {asesora.nombre}
                    </strong>
                    <span style="font-size: 13px; color: var(--portal-cobre-texto); font-weight: 600;">
                      Admisiones Institucionales FGREC
                    </span>
                  </div>
                </div>

                <p style="font-size: 14px; color: var(--portal-mutado); line-height: 1.5; margin-bottom: 16px;">
                  Tu asesora revisa tu expediente académico, valida tus requisitos ante la universidad y te guía en cada paso del proceso.
                </p>

                {whatsappHref && (
                  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="boton boton--acento" style="width: 100%; display: flex; gap: 8px;">
                    <span>Hablar con {asesora.nombre.split(' ')[0]}</span>
                    <span aria-hidden="true">→</span>
                  </a>
                )}
              </div>
            ) : (
              <div>
                <div style="background: var(--crema, #F7F4EE); padding: 14px 16px; border-radius: var(--portal-radio); border: 1px solid var(--portal-borde); margin-bottom: 14px;">
                  <strong style="display: block; font-size: 16px; color: var(--portal-azul); margin-bottom: 2px;">
                    Equipo de Admisiones FGREC
                  </strong>
                  <span style="font-size: 13px; color: var(--portal-mutado);">
                    Asignación en curso
                  </span>
                </div>
                <p style="font-size: 14px; color: var(--portal-mutado); line-height: 1.5; margin-bottom: 16px;">
                  Tu expediente está siendo asignado a una asesora institucional para acompañarte en tu postulación.
                </p>
                {whatsappHref && (
                  <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="boton boton--oscuro" style="width: 100%;">
                    Contactar mesa de admisiones
                  </a>
                )}
              </div>
            )}
          </div>

          <!-- Tarjeta de Acompañamiento Institucional (Rol de la Fundación) -->
          <div class="tarjeta" style="background: var(--crema-2, #F3EBDD); border-color: #DFD5C3;">
            <p class="antetitulo" style="margin-bottom: 6px;">Acompañamiento FGREC</p>
            <h3 style="font-size: 20px; color: var(--portal-azul); margin-bottom: 8px;">
              ¿Cómo funciona tu proceso?
            </h3>
            <p style="font-size: 14px; color: var(--portal-mutado); line-height: 1.5; margin-bottom: 14px;">
              La Fundación del Gran Rosario te orienta y acompaña con cada trámite hacia la universidad aliada:
            </p>

            <ul style="padding-left: 18px; margin: 0 0 18px 0; font-size: 14px; color: var(--portal-texto); line-height: 1.5;">
              <li>Revisión preliminar de tu documentación.</li>
              <li>Articulación y solicitud de dictamen académico.</li>
              <li>Acceso al Beneficio Institucional FGREC.</li>
              <li>Acompañamiento hasta tu matriculación oficial.</li>
            </ul>

            <a class="enlace-flecha" href="/la-fundacion/" target="_blank" rel="noopener" style="font-size: 14px;">
              Conocer más sobre la Fundación <span aria-hidden="true">→</span>
            </a>
          </div>

          <!-- Canales de contacto directo y sede -->
          <div class="tarjeta" style="background: #FFFFFF;">
            <p class="antetitulo" style="margin-bottom: 6px;">Sede y Soporte</p>
            <h3 style="font-size: 18px; color: var(--portal-azul); margin-bottom: 6px;">
              Oficina Quito, Ecuador
            </h3>
            <p style="font-size: 13px; color: var(--portal-mutado); line-height: 1.45; margin-bottom: 14px;">
              Av. 12 de Octubre y Lincoln, Edificio Torre 1492, Of. 902.
            </p>
            <a href="/contacto/" target="_blank" rel="noopener" class="enlace-flecha" style="font-size: 14px;">
              Ver ubicación y horarios <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </>
  )}
</PortalLayout>
