---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import { cartaEnviadaEnPanel, loQueSigue, resumirDocumentosPanel } from '../../lib/portal-pure.ts';
import { leerConvenio, formatearFechaConvenio } from '../../lib/convenio-pure.ts';
import { datosFaltantes, leerDatos } from '../../lib/datos-pure.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;
const resumenDocumentos = resumirDocumentosPanel(documentos, postulacion.expediente);

// Obtener nombre de pila del postulante para un saludo personalizado institucional
let nombrePostulante = '';
try {
  const respCtx = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'precalificador/contexto',
    sesion: sesionToken,
    contexto
  });
  if (respCtx.ok && respCtx.data?.nombre) {
    nombrePostulante = respCtx.data.nombre;
  }
} catch {
  // Saludo fallback
}

// Estado del convenio de corresponsabilidad (solo lectura). Si la consulta falla, el panel simplemente no lo muestra.
let convenio = leerConvenio(null);
try {
  const respConvenio = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'convenio',
    sesion: sesionToken,
    contexto
  });
  if (respConvenio.ok) {
    convenio = leerConvenio(respConvenio.data);
  }
} catch {
  // Sin estado de convenio
}
const convenioPendiente = convenio.estado === 'GENERADO';

// Lo que FGREC todavía no tiene del postulante: se avisa arriba, sin tener que bajar. Si la consulta falla, no se avisa.
let faltantes: string[] = [];
try {
  const respDatos = await llamarFGRECPortal({ metodo: 'GET', rutaRelativa: 'datos', sesion: sesionToken, contexto });
  if (respDatos.ok) faltantes = datosFaltantes(leerDatos(respDatos.data));
} catch {
  // Sin aviso de datos
}
const convenioAceptado = convenio.estado === 'ACEPTADO';
const fechaConvenio = formatearFechaConvenio(convenio.aceptadoEn);

// Mapeo jerárquico formal de etapas públicas a las 5 fases del proceso de admisión
const pasoCodigo = paso.codigo || 'ORIENTACION';
let faseActiva = 1;
if (pasoCodigo === 'ORIENTACION') {
  faseActiva = 1;
} else if (['CARTA_INTERES', 'DOCUMENTACION', 'DOCUMENTACION_COMPLETA'].includes(pasoCodigo)) {
  faseActiva = 2;
} else if (['EVALUACION_ACADEMICA'].includes(pasoCodigo)) {
  faseActiva = 3;
} else if (['FONDO_ECUADOR'].includes(pasoCodigo)) {
  faseActiva = 4;
} else if (['PROPUESTA', 'RESERVA_CONFIRMADA', 'INSCRIPCION_CONFIRMADA'].includes(pasoCodigo)) {
  faseActiva = 5;
}

const accionConvenio = proximoPaso?.codigo === 'ACEPTAR_CONVENIO';
// Un convenio pendiente tiene prioridad sobre el aviso de revisión: es lo único que el postulante puede hacer.
const enRevision = pasoCodigo === 'DOCUMENTACION_COMPLETA' && !accionConvenio;
const cartaEnviada = cartaEnviadaEnPanel(postulacion, enRevision);

// «Lo que sigue»: una sola acción según la etapa (src/lib/portal-pure.ts). Una postulación en pausa sigue su próximo paso.
const siguiente = loQueSigue(postulacion);
const FASES = ['Orientación y registro', 'Documentación y carta', 'Dictamen y admisión', 'Fondo Institucional', 'Matrícula y alta'];
const estadoDatos = faltantes.length === 0 ? 'Completos'
  : faltantes.length === 1 ? `Falta ${faltantes[0].replace(/^tu /, '')}` : `Faltan ${faltantes.length} datos`;
const filas = [
  { nombre: 'Documentos', ok: resumenDocumentos.completos, estado: resumenDocumentos.etiqueta, href: '/mi-postulacion/documentos', accion: resumenDocumentos.completos ? 'Ver documentos' : 'Cargar documentos' },
  { nombre: 'Carta de interés', ok: cartaEnviada, estado: cartaEnviada ? 'Enviada' : 'Pendiente', href: '/mi-postulacion/documentos#carta', accion: cartaEnviada ? 'Ver la carta' : 'Escribir la carta' },
  { nombre: 'Tus datos', ok: faltantes.length === 0, estado: estadoDatos, href: '/mi-postulacion/datos', accion: faltantes.length === 0 ? 'Ver mis datos' : 'Completar mis datos' },
  ...(convenioPendiente || convenioAceptado
    ? [{ nombre: 'Convenio de corresponsabilidad', ok: convenioAceptado, estado: convenioAceptado ? `Aceptado${fechaConvenio ? ` el ${fechaConvenio}` : ''}` : 'Por aceptar', href: '/mi-postulacion/convenio', accion: convenioAceptado ? 'Ver el convenio' : 'Leer el convenio' }]
    : [])
];
// Lo que la barra lateral cuenta como pendiente en cada sección.
const pendientesExpediente = Number(documentos.pendientes ?? 0) + Number(documentos.observados ?? 0) + (cartaEnviada ? 0 : 1) + (convenioPendiente ? 1 : 0);
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true} pendientes={{ expediente: pendientesExpediente, datos: faltantes.length }}>
  {statusError === 429 ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc">
        Hiciste demasiadas solicitudes en poco tiempo. Espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card error-card">
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc">
        El servicio no está disponible por ahora; inténtalo de nuevo en unos minutos. Si necesitas ayuda ya, escríbenos por nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="inicio">
      <header class="inicio__cabecera">
        <div class="inicio__saludo">
          <h1 class="inicio__titulo">{nombrePostulante ? `Hola, ${nombrePostulante}` : 'Mi postulación'}</h1>
          {situacion === 'ACTIVA' && <span class="inicio__estado">Postulación activa</span>}
        </div>
        <div class="inicio__fase">
          <span><strong>Fase {faseActiva} de 5</strong> · {FASES[faseActiva - 1]}</span>
          <span class="inicio__puntos" role="img" aria-label={`Fase ${faseActiva} de 5`}>
            {FASES.map((_, i) => <span class={i < faseActiva ? 'inicio__punto inicio__punto--hecho' : 'inicio__punto'} />)}
          </span>
        </div>
      </header>

      <section class="inicio__sigue" aria-labelledby="sigue-titulo">
        <div class="inicio__sigue-texto">
          <span class="inicio__rotulo">Lo que sigue</span>
          {siguiente.etiqueta && <span class="inicio__etiqueta">{siguiente.etiqueta}</span>}
          <h2 class="inicio__sigue-titulo" id="sigue-titulo">{siguiente.titulo}</h2>
          <p class="inicio__sigue-lead">{siguiente.texto}</p>
          {siguiente.enlace && (
            <a href={siguiente.enlace.href} class="inicio__enlace">{siguiente.enlace.etiqueta} <span aria-hidden="true">&rarr;</span></a>
          )}
        </div>
        {siguiente.accion ? (
          <a href={siguiente.accion.href} class="btn-primary inicio__boton">
            <span>{siguiente.accion.etiqueta}</span>
            <span aria-hidden="true">&rarr;</span>
          </a>
        ) : siguiente.contacto && whatsappHref ? (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="inicio__wa">Escribir a mi asesora</a>
        ) : null}
      </section>

      <section class="inicio__expediente" aria-labelledby="expediente-titulo">
        <h2 class="inicio__expediente-titulo" id="expediente-titulo">Tu expediente</h2>
        <ul class="inicio__filas">
          {filas.map((f) => (
            <li class="inicio__fila">
              <span class={f.ok ? 'inicio__marca inicio__marca--ok' : 'inicio__marca'} aria-hidden="true">
                {f.ok && (
                  <svg width="10" height="10" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" /></svg>
                )}
              </span>
              <span class="inicio__fila-nombre">{f.nombre}</span>
              <span class={f.ok ? 'inicio__pastilla inicio__pastilla--ok' : 'inicio__pastilla'}>{f.estado}</span>
              <a href={f.href} class="inicio__fila-accion">{f.accion} <span aria-hidden="true">&rarr;</span></a>
            </li>
          ))}
        </ul>
      </section>
    </div>
  )}
</PortalLayout>

<style>
  .error-card {
    text-align: center;
    padding: 2.5rem 1.5rem;
    background: #FFFFFF;
    border: 1px solid var(--portal-borde);
    border-radius: var(--portal-radio);
  }

  .inicio { display: flex; flex-direction: column; gap: 24px; }

  .inicio__cabecera { display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; }
  .inicio__saludo { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .inicio__titulo { margin: 0; font-family: var(--serif); font-weight: 600; font-size: 32px; line-height: 1.1; color: var(--portal-texto); text-wrap: balance; }
  .inicio__estado { font-size: 12px; font-weight: 600; color: var(--portal-verde); background: var(--portal-verde-fondo); padding: 4px 10px; border-radius: 999px; }
  .inicio__fase { display: flex; align-items: center; gap: 12px; font-size: 14px; color: var(--portal-mutado); }
  .inicio__fase strong { color: var(--portal-texto); font-weight: 600; }
  .inicio__puntos { display: inline-flex; gap: 6px; }
  .inicio__punto { width: 10px; height: 10px; border-radius: 50%; border: 1.5px solid #B9AE9C; box-sizing: border-box; }
  .inicio__punto--hecho { background: var(--portal-azul); border-color: var(--portal-azul); }

  .inicio__sigue {
    display: flex; align-items: center; justify-content: space-between; gap: 32px;
    padding: 28px 32px; background: var(--portal-blanco); border: 1px solid var(--portal-borde); border-radius: 8px;
  }
  .inicio__sigue-texto { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; max-width: 560px; }
  .inicio__rotulo { font-size: 13px; font-weight: 600; color: var(--portal-cobre-texto); }
  .inicio__etiqueta { font-size: 12px; font-weight: 600; color: var(--portal-cobre-texto); background: var(--portal-ambar-fondo); padding: 4px 10px; border-radius: 999px; }
  .inicio__sigue-titulo { margin: 0; font-family: var(--serif); font-weight: 600; font-size: 26px; line-height: 1.2; color: var(--portal-texto); text-wrap: balance; }
  .inicio__sigue-lead { margin: 0; font-size: 15px; line-height: 1.5; color: var(--portal-mutado); }
  .inicio__enlace { font-size: 14px; font-weight: 600; color: var(--portal-cobre-texto); }
  .inicio__boton { flex-shrink: 0; }
  .inicio__wa {
    flex-shrink: 0; min-height: 44px; padding: 0 20px; border-radius: var(--portal-radio);
    display: inline-flex; align-items: center; background: var(--portal-verde); color: var(--portal-blanco);
    font-size: 15px; font-weight: 600; text-decoration: none;
  }

  .inicio__expediente { padding: 24px 32px 8px; background: var(--portal-blanco); border: 1px solid var(--portal-borde); border-radius: 8px; }
  .inicio__expediente-titulo { margin: 0 0 8px; font-family: var(--serif); font-weight: 600; font-size: 20px; color: var(--portal-texto); }
  .inicio__filas { list-style: none; margin: 0; padding: 0; }
  .inicio__fila {
    display: grid; grid-template-columns: 22px minmax(0, 1fr) auto 200px; align-items: center; gap: 14px;
    padding: 14px 0; border-top: 1px solid #EFE9DE;
  }
  .inicio__marca {
    width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--portal-cobre-texto); box-sizing: border-box;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .inicio__marca--ok { background: var(--portal-verde); border-color: var(--portal-verde); color: var(--portal-blanco); }
  .inicio__fila-nombre { font-size: 15px; color: var(--portal-texto); }
  .inicio__pastilla { justify-self: start; font-size: 13px; font-weight: 600; color: var(--portal-cobre-texto); background: var(--portal-ambar-fondo); padding: 4px 10px; border-radius: 999px; white-space: nowrap; }
  .inicio__pastilla--ok { color: var(--portal-verde); background: var(--portal-verde-fondo); }
  .inicio__fila-accion { justify-self: end; font-size: 14px; font-weight: 600; color: var(--portal-cobre-texto); text-decoration: none; min-height: 44px; display: inline-flex; align-items: center; }
  .inicio__fila-accion:hover { color: var(--portal-cobre-hover); text-decoration: underline; }

  @media (max-width: 720px) {
    .inicio__titulo { font-size: 28px; }
    .inicio__sigue { flex-direction: column; align-items: stretch; padding: 20px; gap: 16px; }
    .inicio__boton, .inicio__wa { justify-content: center; }
    .inicio__sigue-titulo { font-size: 22px; }
    .inicio__expediente { padding: 18px 20px 4px; }
    .inicio__fila { grid-template-columns: 22px minmax(0, 1fr) auto; row-gap: 2px; }
    .inicio__fila-accion { grid-column: 2 / -1; justify-self: start; min-height: 32px; }
  }
</style>
