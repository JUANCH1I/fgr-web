---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

const respuesta = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'postulacion',
  sesion: sesionToken,
  contexto
});

if (respuesta.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuesta.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuesta.ok ? respuesta.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

const postulacion = respuesta.data || {};
const paso = postulacion.paso || { codigo: 'ORIENTACION', nombre: 'Orientación' };
const situacion = postulacion.situacion || 'ACTIVA';
const proximoPaso = postulacion.proximoPaso;
const documentos = postulacion.documentos || { pendientes: 0, observados: 0, total: 0 };
const asesora = postulacion.asesora;
---

<PortalLayout title="Mi postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Hablar con un asesor por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔧</div>
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas atención inmediata, puedes escribir a nuestro canal oficial.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <>
      <!-- Encabezado con estado -->
      <div class="portal-card" style="border-left: 4px solid var(--portal-cobre);">
        <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
          <div>
            <p class="antetitulo" style="margin-bottom: 4px;">Paso actual de tu proceso</p>
            <h1 class="portal-title" style="margin: 0; font-size: 28px;">
              {paso.nombre}
            </h1>
          </div>
          <div>
            {situacion === 'ACTIVA' && (
              <span class="badge-acento" style="background: var(--portal-verde-fondo); color: var(--portal-verde); border-color: #C4DEC8;">
                Activa
              </span>
            )}
            {situacion === 'EN_PAUSA' && (
              <span class="badge-acento" style="background: var(--portal-ambar-fondo); color: var(--portal-ambar); border-color: #F6DFB3;">
                Postulación en pausa
              </span>
            )}
            {situacion === 'CERRADA' && (
              <span class="badge-acento" style="background: var(--portal-rojo-fondo); color: var(--portal-rojo); border-color: #F5C2C0;">
                Postulación cerrada
              </span>
            )}
          </div>
        </div>

        {asesora?.nombre && (
          <p style="margin: 14px 0 0 0; font-size: 15px; color: var(--portal-mutado); border-top: 1px solid var(--portal-borde); padding-top: 12px;">
            Te acompaña en el proceso: <strong style="color: var(--portal-azul);">{asesora.nombre}</strong> (Asesoría institucional FGREC).
          </p>
        )}
      </div>

      <!-- Próximo paso prioritario -->
      {proximoPaso && (
        <div class="tarjeta" style="background: #FFFFFF; border-left: 4px solid var(--portal-azul); margin-bottom: 20px;">
          <p class="antetitulo" style="color: var(--portal-azul); margin-bottom: 4px;">🎯 Acción recomendada</p>
          <h2 style="font-size: 22px; margin-bottom: 8px; color: var(--portal-azul);">
            Próximo paso
          </h2>
          <p class="entrada" style="font-size: 16px; margin-bottom: 18px; color: var(--portal-texto);">
            {proximoPaso.texto}
          </p>

          {proximoPaso.codigo === 'CARGAR_DOCUMENTOS' || proximoPaso.codigo === 'SUBSANAR_DOCUMENTOS' ? (
            <a href="/mi-postulacion/documentos" class="portal-btn portal-btn--acento" style="width: auto; display: inline-flex;">
              Ir a mis documentos
            </a>
          ) : proximoPaso.codigo === 'COMPLETAR_PRECALIFICADOR' ? (
            <a href="/mi-postulacion/precalificador" class="portal-btn portal-btn--acento" style="width: auto; display: inline-flex;">
              Completar precalificador
            </a>
          ) : whatsappHref ? (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--outline" style="width: auto; display: inline-flex;">
              Consultar por WhatsApp
            </a>
          ) : null}
        </div>
      )}

      <!-- Resumen de documentos -->
      <div class="portal-card">
        <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 16px;">
          <div>
            <p class="antetitulo" style="margin-bottom: 4px;">Expediente académico</p>
            <h2 class="portal-title" style="margin: 0; font-size: 24px;">
              Documentos requeridos
            </h2>
          </div>
          <a class="enlace-flecha" href="/mi-postulacion/documentos">
            Ver todos <span aria-hidden="true">→</span>
          </a>
        </div>

        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; margin: 16px 0 20px 0; text-align: center;">
          <div style="padding: 14px; background: var(--portal-fondo); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
            <div style="font-size: 28px; font-weight: 700; font-family: var(--serif); color: var(--portal-azul); line-height: 1.1;">{documentos.total}</div>
            <div style="font-size: 13px; font-weight: 600; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px;">Total</div>
          </div>
          <div style="padding: 14px; background: var(--portal-fondo); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
            <div style="font-size: 28px; font-weight: 700; font-family: var(--serif); color: documentos.pendientes > 0 ? 'var(--portal-cobre-texto)' : 'var(--portal-mutado)'; line-height: 1.1;">
              {documentos.pendientes}
            </div>
            <div style="font-size: 13px; font-weight: 600; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px;">Pendientes</div>
          </div>
          <div style="padding: 14px; background: var(--portal-fondo); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio);">
            <div style="font-size: 28px; font-weight: 700; font-family: var(--serif); color: documentos.observados > 0 ? 'var(--portal-rojo)' : 'var(--portal-mutado)'; line-height: 1.1;">
              {documentos.observados}
            </div>
            <div style="font-size: 13px; font-weight: 600; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.05em; margin-top: 4px;">Observados</div>
          </div>
        </div>

        <a href="/mi-postulacion/documentos" class="portal-btn portal-btn--outline">
          Gestionar documentación del expediente
        </a>
      </div>

      <!-- Ayuda / Asesoría -->
      <div class="tarjeta" style="background: var(--crema-2, #F3EBDD); border-color: #DFD5C3; text-align: center;">
        <p class="antetitulo" style="margin-bottom: 6px;">Orientación personalizada</p>
        <h2 style="font-size: 22px; color: var(--portal-azul); margin-bottom: 8px;">
          ¿Tienes alguna duda con tu postulación?
        </h2>
        <p style="font-size: 15px; color: var(--portal-mutado); max-width: 540px; margin: 0 auto 16px auto;">
          Las asesoras de la Fundación del Gran Rosario Ecuador revisan tu documentación y te orientan en cada etapa.
        </p>
        <div style="max-width: 280px; margin: 0 auto;">
          <a href="/contacto" class="portal-btn portal-btn--primary">
            Contactar a la Fundación
          </a>
        </div>
      </div>
    </>
  )}
</PortalLayout>
