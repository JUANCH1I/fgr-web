---
export const prerender = false;
import PortalLayout from '../../layouts/PortalLayout.astro';
import { COOKIE_SESION_NOMBRE, llamarFGRECPortal, extraerContextoVisitante, borrarSesionYContacto } from '../../lib/fgrec-portal.ts';
import { publicPaymentContext, registrationUnavailable, paymentSummary, type PaymentContext } from '../../lib/payment-pure.ts';

Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate');
const session = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;
if (!session) return Astro.redirect('/mi-postulacion/ingresar', 302);
const response = await llamarFGRECPortal<PaymentContext>({ metodo: 'GET', rutaRelativa: 'pagos', sesion: session, contexto: extraerContextoVisitante(Astro.request) });
if (response.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}
if (response.status === 403) return Astro.redirect('/mi-postulacion/codigo', 302);
const context = response.ok && response.data ? publicPaymentContext(response.data) : null;
const unavailable = context ? registrationUnavailable(context) : null;
---

<PortalLayout title="Mis pagos | Fundación Gran Rosario" autenticado={true}>
  <header class="payment-heading">
    <p class="antetitulo">Seguimiento institucional</p>
    <h1 class="portal-title">Mis pagos</h1>
    <p class="portal-desc">Informa un pago que ya realizaste y adjunta su comprobante. El equipo de FGREC revisará la información antes de confirmar su recepción.</p>
  </header>
  {!context ? (
    <section class="portal-card" aria-labelledby="payment-service-title">
      <h2 id="payment-service-title">{response.status === 429 ? 'Demasiados intentos' : 'Servicio no disponible'}</h2>
      <p>{response.status === 429 ? 'Espera unos minutos antes de volver a consultar tus pagos.' : 'No podemos consultar tus pagos en este momento. Intenta más tarde o contacta a tu asesora institucional.'}</p>
      <a href="/mi-postulacion/pagos" class="boton boton--contorno">Volver a consultar</a>
    </section>
  ) : (
    <div class="payment-grid">
      <section class="portal-card payment-history" aria-labelledby="payment-history-title">
        <p class="antetitulo">Tu historial</p>
        <h2 id="payment-history-title">Pagos informados</h2>
        <p class="payment-help">Un pago pendiente de confirmación todavía no acredita su recepción.</p>
        <p id="payment-empty" hidden={context.pagos.length > 0}>Aún no tienes pagos informados.</p>
        <ol id="payment-list" class="payment-list">
          {context.pagos.map(payment => {
            const summary = paymentSummary(payment);
            return (
              <li class="payment-item">
                <div class="payment-item-heading"><h3>{summary.title}</h3><span class="payment-state" data-state={payment.estado}>{payment.estadoTexto}</span></div>
                <dl>{summary.details.map(([label, value]) => <div><dt>{label}</dt><dd>{value}</dd></div>)}</dl>
                <p class="payment-help">{payment.comprobanteRecibido ? 'Comprobante recibido' : 'Sin comprobante registrado'}</p>
                {payment.motivo && <p class="payment-reason">{payment.motivo}</p>}
              </li>
            );
          })}
        </ol>
        <a href="/mi-postulacion/pagos" class="enlace-flecha">Actualizar historial <span aria-hidden="true">↻</span></a>
      </section>
      <section class="portal-card payment-report" aria-labelledby="payment-report-title">
        <p class="antetitulo">Comprobante de pago</p>
        <h2 id="payment-report-title">Enviar un comprobante</h2>
        {unavailable ? <div class="portal-alert portal-alert--info">{unavailable}</div> : (
          <>
            <p class="payment-help">Sube el comprobante del pago que realizaste. El equipo de FGREC revisará el comprobante y completará los datos del pago antes de confirmarlo.</p>
            <noscript><p class="portal-alert portal-alert--info">Activa JavaScript para informar tu pago y enviar el comprobante de forma segura.</p></noscript>
            <div id="payment-status" class="payment-feedback" role="status" aria-live="polite" aria-atomic="true" tabindex="-1"></div>
            <div id="payment-error" class="payment-feedback payment-reason" role="alert" aria-atomic="true" tabindex="-1"></div>
            <a id="payment-review" href="/mi-postulacion/pagos" class="enlace-flecha" hidden>Consultar el historial antes de continuar</a>
            <form id="payment-form" data-max-bytes={context.maxBytes}>
              <fieldset id="payment-fields" disabled>
                <legend class="sr-only">Comprobante de pago</legend>
                <div class="portal-input-group">
                  <label class="portal-label" for="payment-receipt">Comprobante</label>
                  <input class="portal-input payment-file" id="payment-receipt" name="receipt" type="file" accept="application/pdf,image/jpeg,image/png,.pdf,.jpg,.jpeg,.png" required aria-describedby="payment-file-help" />
                  <p class="payment-help" id="payment-file-help">PDF, JPG o PNG. Máximo {Math.floor(context.maxBytes / 1024 / 1024)} MB. Debe ser legible.</p>
                </div>
                <button class="portal-btn" type="submit">Enviar comprobante</button>
              </fieldset>
            </form>
          </>
        )}
      </section>
    </div>
  )}
</PortalLayout>

<style is:global>
  .payment-heading { max-width: 760px; margin-bottom: 28px; }
  .payment-heading > .enlace-flecha { margin-bottom: 20px; }
  .payment-heading .antetitulo { margin-bottom: 8px; }
  .payment-grid { display: grid; gap: 24px; align-items: start; }
  .payment-grid .portal-card { min-width: 0; margin-bottom: 0; }
  .payment-grid h2 { font-size: 25px; margin: 0 0 12px; color: var(--portal-azul); }
  .payment-history { border-top: 4px solid var(--portal-cobre); }
  .payment-help { font-size: 14px; color: var(--portal-mutado); line-height: 1.5; margin: 8px 0 18px; }
  .payment-list { list-style: none; padding: 0; margin: 0 0 20px; }
  .payment-item { border-bottom: 1px solid var(--portal-borde); padding: 20px 0 4px; overflow-wrap: anywhere; }
  .payment-item:first-child { padding-top: 8px; }
  .payment-item-heading { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 10px; }
  .payment-item-heading h3 { color: var(--portal-azul); font-size: 23px; margin: 0; }
  .payment-state { display: inline-block; padding: 5px 9px; border-radius: 4px; background: var(--portal-ambar-fondo); color: var(--portal-ambar); font-size: 13px; font-weight: 700; }
  .payment-state[data-state='CONFIRMADO'] { background: var(--portal-verde-fondo); color: var(--portal-verde); }
  .payment-state[data-state='RECHAZADO'], .payment-state[data-state='ANULADO'] { background: var(--portal-rojo-fondo); color: var(--portal-rojo); }
  .payment-item dl { display: grid; gap: 8px; margin: 16px 0; font-size: 14px; }
  .payment-item dt { color: var(--portal-mutado); }
  .payment-item dd { margin: 2px 0 0; font-weight: 600; }
  #payment-fields { border: 0; margin: 0; padding: 0; min-width: 0; }
  .payment-feedback:not(:empty) { padding: 14px; margin-bottom: 16px; background: var(--portal-verde-fondo); color: var(--portal-verde); border-radius: 4px; }
  .payment-feedback.payment-reason:not(:empty), .payment-reason { color: var(--portal-rojo); background: var(--portal-rojo-fondo); }
  #payment-review:not([hidden]) { display: block; margin-bottom: 18px; }
  .payment-file { padding: 10px; }
  .payment-report .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
  @media (min-width: 900px) { .payment-grid { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); } }
</style>

<script>
  import { validatePaymentBody, paymentSummary, type Payment } from '../../lib/payment-pure.ts';
  import { validarArchivoCliente } from '../../lib/portal-pure.ts';
  import { reportPayment, PaymentUploadError } from '../../lib/payment-upload.ts';

  const form = document.getElementById('payment-form') as HTMLFormElement | null;
  if (form) {
    const fields = document.getElementById('payment-fields') as HTMLFieldSetElement;
    const receipt = document.getElementById('payment-receipt') as HTMLInputElement;
    const status = document.getElementById('payment-status')!;
    const error = document.getElementById('payment-error')!;
    const review = document.getElementById('payment-review')!;
    let busy = false;
    let uncertain = false;
    fields.disabled = false;

    function showError(message: string) { error.textContent = message; error.focus(); }
    function renderHistory(payments: Payment[]) {
      const list = document.getElementById('payment-list')!;
      list.replaceChildren();
      document.getElementById('payment-empty')!.hidden = payments.length > 0;
      for (const payment of payments) {
        const item = document.createElement('li'); item.className = 'payment-item';
        const heading = document.createElement('div'); heading.className = 'payment-item-heading';
        const summary = paymentSummary(payment);
        const amount = document.createElement('h3'); amount.textContent = summary.title;
        const state = document.createElement('span'); state.className = 'payment-state'; state.dataset.state = payment.estado; state.textContent = payment.estadoTexto;
        heading.append(amount, state);
        const details = document.createElement('dl');
        for (const [label, value] of summary.details) {
          const row = document.createElement('div'); const term = document.createElement('dt'); term.textContent = label; const valueElement = document.createElement('dd'); valueElement.textContent = value; row.append(term, valueElement); details.append(row);
        }
        const evidence = document.createElement('p'); evidence.className = 'payment-help'; evidence.textContent = payment.comprobanteRecibido ? 'Comprobante recibido' : 'Sin comprobante registrado';
        item.append(heading, details, evidence);
        if (payment.motivo) { const reason = document.createElement('p'); reason.className = 'payment-reason'; reason.textContent = payment.motivo; item.append(reason); }
        list.append(item);
      }
    }

    form.addEventListener('submit', async event => {
      event.preventDefault();
      if (busy || uncertain) return;
      status.textContent = ''; error.textContent = '';
      const file = receipt.files?.[0];
      if (!file) { showError('Selecciona el comprobante de este pago.'); return; }
      const validation = validarArchivoCliente(file);
      if (!validation.valido || file.size > Number(form.dataset.maxBytes)) { showError(validation.error || 'El comprobante supera el tamaño permitido.'); return; }
      const valid = validatePaymentBody({ nombreArchivo: file.name, tipo: validation.tipoMime, tamano: file.size });
      if (!valid.ok) { showError(valid.message); return; }
      busy = true; fields.disabled = true; form.setAttribute('aria-busy', 'true');
      try {
        await reportPayment(valid.body, file, { onProgress: message => { status.textContent = message; } });
        status.textContent = 'Comprobante recibido. FGREC lo revisará y completará los datos del pago antes de confirmarlo.';
        form.reset(); status.focus();
        try {
          const refreshed = await fetch('/api/portal/pagos', { cache: 'no-store', signal: AbortSignal.timeout(15000) });
          if (!refreshed.ok) throw new Error('refresh');
          const context = await refreshed.json();
          renderHistory(context.pagos);
          // Eligibility may have changed while uploading: require fresh server rendering.
          uncertain = true; review.hidden = false; review.textContent = 'Actualizar la página para enviar otro comprobante';
        } catch {
          uncertain = true; review.hidden = false;
          status.textContent += ' No pudimos actualizar el historial. Consúltalo antes de informar otro pago.';
        }
      } catch (cause) {
        status.textContent = '';
        const failure = cause instanceof PaymentUploadError ? cause : new PaymentUploadError('No se pudo completar la carga. Actualiza el historial antes de continuar.', 0, '', true);
        if (failure.status === 401 && !failure.ambiguous && failure.code !== 'UPLOAD_TOKEN_INVALID') { window.location.href = '/mi-postulacion/ingresar'; return; }
        if (failure.status === 403 && failure.code === 'LEVEL_REQUIRED') { window.location.href = '/mi-postulacion/codigo'; return; }
        uncertain = failure.requiresRefresh;
        receipt.value = '';
        review.hidden = false;
        showError(failure.message);
      } finally {
        busy = false; fields.disabled = uncertain; form.setAttribute('aria-busy', 'false');
      }
    });
  }
</script>
