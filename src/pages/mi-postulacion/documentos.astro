---
export const prerender = false;

import { createHash } from 'node:crypto';
import PortalLayout from '../../layouts/PortalLayout.astro';
import CartaInteres from '../../components/CartaInteres.astro';
import AsesoriaCard from '../../components/AsesoriaCard.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import type { RequisitoUI } from '../../lib/portal-pure.ts';
import { leerExpediente, resumirExpediente } from '../../lib/carta-pure.ts';
import {
  contarDocumentos,
  modelarTarjetaEstado,
  presentarFilaDocumento,
  resumirCarta,
  resumirSeccionDocumentos
} from '../../lib/documentos-pure.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

// 1. Obtener listado de requisitos y estado documental
const respuestaDocs = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'documentos',
  sesion: sesionToken,
  contexto
});

if (respuestaDocs.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuestaDocs.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuestaDocs.ok ? respuestaDocs.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20la%20documentación%20de%20mi%20postulación.`
  : null;

const docsData = respuestaDocs.data || {};
const consentimientoPendiente = Boolean(docsData.consentimientoPendiente);
const requisitos: RequisitoUI[] = Array.isArray(docsData.requisitos) ? docsData.requisitos : [];

// 2. Si el consentimiento está pendiente, traer los textos
let textoConsentimiento: any = null;
if (consentimientoPendiente && respuestaDocs.ok) {
  const respCons = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'consentimientos',
    sesion: sesionToken,
    contexto
  });
  if (respCons.ok && respCons.data?.textos?.length > 0) {
    textoConsentimiento = respCons.data.textos[0];
  }
}

// 3. Consultar datos de la postulación para obtener la asesora asignada y el próximo paso
let asesoraAsignada: { nombre: string; whatsapp?: string | null } | null = null;
let proximoPaso: { codigo?: string | null; texto?: string | null } | null = null;
try {
  const respPostulacion = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'postulacion',
    sesion: sesionToken,
    contexto
  });
  if (respPostulacion.ok && respPostulacion.data?.asesora) {
    asesoraAsignada = respPostulacion.data.asesora;
  }
  if (respPostulacion.ok && respPostulacion.data?.proximoPaso) {
    proximoPaso = respPostulacion.data.proximoPaso;
  }
} catch {
  // Sin asesora ni próximo paso: la tarjeta se arma con lo que hay
}

// 4. Carta de interés: parte del expediente (documentos + carta)
let carta: any = null;
let errorCarta: { status: number; code?: string; message?: string } | null = null;
if (respuestaDocs.ok) {
  const respCarta = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'carta',
    sesion: sesionToken,
    contexto
  });
  if (respCarta.status === 401) {
    borrarSesionYContacto(Astro.cookies);
    return Astro.redirect('/mi-postulacion/ingresar', 302);
  }
  if (respCarta.ok) {
    carta = respCarta.data;
  } else {
    errorCarta = { status: respCarta.status, code: respCarta.error?.code, message: respCarta.error?.message };
  }
}
// Clave opaca para el respaldo local del borrador: no expone el token de sesión.
const claveSesion = createHash('sha256').update(sesionToken).digest('hex').slice(0, 16);
const cartaEnviada = Boolean(carta) && carta.puedeEditar === false;
// El estado oficial lo calcula el servidor; si no lo envía (backend anterior) se usa el cálculo local de antes.
const expediente = leerExpediente(docsData.expediente) ?? leerExpediente(carta?.expediente);
const resumen = resumirExpediente(requisitos, cartaEnviada, expediente);
const cartaEnviadaFinal = resumen.cartaEnviada;

// Modelo de la página: tarjeta de estado, filas de documentos y resumen de cada sección
const conteo = contarDocumentos(requisitos);
const cartaEditable = Boolean(carta) && carta.puedeEditar !== false && !resumen.soloLectura;
const tarjeta = modelarTarjetaEstado({
  estado: resumen.estado,
  conteo,
  documentosCompletos: resumen.documentosCompletos,
  cartaEnviada: cartaEnviadaFinal,
  cartaEditable,
  cartaTieneTexto: typeof carta?.texto === 'string' && carta.texto.trim().length > 0,
  cartaNuevaVersion: cartaEditable && Number(carta?.version) > 1,
  consentimientoPendiente: consentimientoPendiente && Boolean(textoConsentimiento),
  proximoPaso
});
const resumenDocumentos = resumirSeccionDocumentos(conteo);
const resumenCarta = resumirCarta({ carta, soloLectura: resumen.soloLectura });
const filas = requisitos.map((req) => ({ req, fila: presentarFilaDocumento(req, resumen.soloLectura) }));
const hayCarga = filas.some(({ fila }) => fila.permiteSubida);
---

<PortalLayout title="Documentos de la postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Hablar con un asesor por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔧</div>
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas enviar tus documentos con urgencia, puedes coordinar la entrega por WhatsApp.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="postulacion-container">
      <header class="exp-cab">
        <a class="enlace-flecha" href="/mi-postulacion"><span aria-hidden="true">←</span> Volver a mi postulación</a>
        <p class="antetitulo">Fase 2 · Documentación y carta</p>
        <h1 class="portal-title">Mi expediente</h1>
        <p class="portal-desc">Reúne tus documentos y tu carta de interés; con ambos completos, la Fundación revisa tu expediente.</p>
      </header>

      <div class="postulacion-layout">
        <div class="postulacion-main">
          <div id="alertaError" class="portal-alert portal-alert--error" role="alert" style="display: none;"></div>
          <div id="alertaExito" class="portal-alert portal-alert--success" role="status" style="display: none;"></div>

          <article class="action-card" aria-labelledby="estadoTitulo" data-estado={resumen.estado}>
            <span class="action-card__tag">{tarjeta.etiqueta}</span>
            <div class="action-card__estado" role="status">
              <h2 id="estadoTitulo" class="action-card__heading">{tarjeta.titulo}</h2>
              {(tarjeta.texto || tarjeta.aviso) && (
                <p class="action-card__lead">
                  {tarjeta.texto}{tarjeta.texto && tarjeta.aviso ? ' ' : ''}{tarjeta.aviso && <strong>{tarjeta.aviso}</strong>}
                </p>
              )}
            </div>
            {tarjeta.accion && (
              <a href={tarjeta.accion.href} class="btn-primary" data-ir>
                <span>{tarjeta.accion.texto}</span>
                <span aria-hidden="true">&rarr;</span>
              </a>
            )}
          </article>

          {consentimientoPendiente && textoConsentimiento && (
            <section id="bloqueConsentimiento" class="section-card" aria-labelledby="consentimientoTitulo" tabindex="-1">
              <h2 id="consentimientoTitulo" class="section-card__title">Consentimiento de datos</h2>
              {textoConsentimiento.borrador && (
                <p class="exp-consentimiento__borrador">Borrador institucional ({textoConsentimiento.version})</p>
              )}
              <div class="exp-consentimiento__texto" tabindex="0" role="region" aria-label="Texto del consentimiento">
                {textoConsentimiento.texto}
              </div>
              <button
                type="button"
                id="btnAceptarConsentimiento"
                data-codigo={textoConsentimiento.codigo}
                data-version={textoConsentimiento.version}
                class="btn-primary"
              >
                <span>Acepto el consentimiento y habilitar la carga</span>
              </button>
            </section>
          )}

          <section id="documentos" class="section-card" aria-labelledby="documentosTitulo">
            <h2 id="documentosTitulo" class="section-card__title">Documentos</h2>
            {requisitos.length > 0 && (
              <p class={`section-card__resumen ${resumen.documentosCompletos && conteo.conAccion === 0 ? 'section-card__resumen--ok' : ''}`}>
                {resumenDocumentos}
              </p>
            )}

            <div id="listaRequisitos" class={consentimientoPendiente ? 'exp-bloqueado' : ''} inert={consentimientoPendiente}>
              {requisitos.length === 0 ? (
                <p class="exp-vacio">No hay documentos pendientes para esta vía.</p>
              ) : (
                <ul class="audit-list" style="list-style: none; padding: 0;">
                  {filas.map(({ req, fila }) => (
                    <li
                      class={`audit-list__row audit-list__row--expand requisito-item`}
                      id={`doc-${req.codigo}`}
                      data-requisito={req.codigo}
                      tabindex="-1"
                    >
                      <div class="audit-list__col-left">
                        <span class={`audit-indicator ${fila.tono === 'ok' ? 'audit-indicator--ok' : fila.tono === 'error' ? 'audit-indicator--error' : fila.icono === 'observado' ? 'audit-indicator--alert' : 'audit-indicator--pending'}`} aria-hidden="true">
                          {fila.tono === 'ok' && (
                            <svg width="12" height="12" viewBox="0 0 20 20" fill="currentColor">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                            </svg>
                          )}
                          {(fila.icono === 'observado' || fila.icono === 'reemplazo') && '!'}
                        </span>
                        <h3 class="audit-list__nombre">
                          {req.nombre}
                          {fila.opcional && <span class="audit-list__opcional">Opcional</span>}
                        </h3>
                      </div>
                      <span class={`badge-status ${fila.tono === 'ok' ? 'badge-status--ok' : fila.tono === 'error' ? 'badge-status--error' : 'badge-status--pending'}`}>
                        {fila.estadoTexto}
                      </span>

                      {(fila.nota || fila.permiteSubida) && (
                        <div class="audit-list__extra">
                          {fila.nota && (
                            <p class={`portal-alert ${fila.tono === 'error' ? 'portal-alert--error' : 'portal-alert--info'}`}>{fila.nota}</p>
                          )}
                          {fila.permiteSubida && (
                            <div class="audit-list__accion">
                              <label class="btn-contact btn-contact--fila btn-cargar-archivo" tabindex="0" role="button">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                  <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                  <polyline points="17 8 12 3 7 8"></polyline>
                                  <line x1="12" y1="3" x2="12" y2="15"></line>
                                </svg>
                                <span>{fila.textoBoton}</span>
                                <input
                                  type="file"
                                  class="input-file-documento"
                                  data-requisito={req.codigo}
                                  accept="image/jpeg,image/png,application/pdf"
                                  aria-label={`${fila.textoBoton}: ${req.nombre}`}
                                />
                              </label>
                              <span class="audit-list__formato">PDF, JPG o PNG · hasta 10 MB</span>
                              <span class="estado-subida" role="status" aria-live="polite" style="display: none;"></span>
                            </div>
                          )}
                        </div>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>

            {hayCarga && (
              <details class="exp-ayuda">
                <summary>¿Problemas con la foto o el formato?</summary>
                <p>
                  Usa buena luz, sin reflejos y con los bordes del documento visibles. Las fotos HEIC de iPhone se convierten
                  a un formato compatible. Si no logras cargar un archivo, puedes coordinar la entrega con tu asesora
                  {whatsappHref ? (<Fragment> por <a href={whatsappHref} target="_blank" rel="noopener noreferrer">WhatsApp</a></Fragment>) : ' por el WhatsApp oficial de la Fundación'}.
                </p>
              </details>
            )}
          </section>

          <CartaInteres
            carta={carta}
            error={errorCarta}
            claveSesion={claveSesion}
            soloLectura={resumen.soloLectura}
            resumen={resumenCarta}
          />
        </div>

        <aside class="postulacion-aside">
          <AsesoriaCard asesora={asesoraAsignada} whatsappHref={whatsappHref} />
        </aside>
      </div>
    </div>
  )}
</PortalLayout>

<script>
  import { validarArchivoCliente, mensajeErrorSubida } from '../../lib/portal-pure.ts';

  const alertaError = document.getElementById('alertaError') as HTMLDivElement | null;
  const alertaExito = document.getElementById('alertaExito') as HTMLDivElement | null;
  const btnAceptarConsentimiento = document.getElementById('btnAceptarConsentimiento') as HTMLButtonElement | null;
  const listaRequisitos = document.getElementById('listaRequisitos') as HTMLDivElement | null;
  const bloqueConsentimiento = document.getElementById('bloqueConsentimiento') as HTMLDivElement | null;

  function mostrarError(msg: string) {
    if (alertaExito) alertaExito.style.display = 'none';
    if (!alertaError) return;
    alertaError.textContent = msg;
    alertaError.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function mostrarExito(msg: string) {
    if (alertaError) alertaError.style.display = 'none';
    if (!alertaExito) return;
    alertaExito.textContent = msg;
    alertaExito.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  btnAceptarConsentimiento?.addEventListener('click', async () => {
    const codigo = btnAceptarConsentimiento.getAttribute('data-codigo');
    const version = btnAceptarConsentimiento.getAttribute('data-version');
    btnAceptarConsentimiento.disabled = true;
    btnAceptarConsentimiento.textContent = 'Registrando aceptación...';

    try {
      const res = await fetch('/api/portal/consentimiento', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-FGREC-Portal': '1'
        },
        body: JSON.stringify({ codigo, version })
      });

      if (res.status === 401) {
        window.location.href = '/mi-postulacion/ingresar';
        return;
      }

      if (res.ok) {
        mostrarExito('Consentimiento registrado con éxito. Ya puedes cargar tus documentos.');
        if (bloqueConsentimiento) bloqueConsentimiento.style.display = 'none';
        if (listaRequisitos) {
          listaRequisitos.classList.remove('exp-bloqueado');
          listaRequisitos.removeAttribute('inert');
        }
      } else {
        const data = await res.json();
        mostrarError(data.message || 'No se pudo registrar el consentimiento.');
        btnAceptarConsentimiento.disabled = false;
        btnAceptarConsentimiento.textContent = 'Acepto el consentimiento y habilitar la carga';
      }
    } catch {
      mostrarError('Error de conexión al registrar consentimiento.');
      btnAceptarConsentimiento.disabled = false;
    }
  });

  async function convertirHeicAJpeg(file: File): Promise<File | null> {
    return new Promise((resolve) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || img.width;
          canvas.height = img.naturalHeight || img.height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            URL.revokeObjectURL(url);
            resolve(null);
            return;
          }
          ctx.drawImage(img, 0, 0);
          canvas.toBlob((blob) => {
            URL.revokeObjectURL(url);
            if (!blob) {
              resolve(null);
              return;
            }
            const nuevoNombre = file.name.replace(/\.[^/.]+$/, '') + '.jpg';
            const nuevoFile = new File([blob], nuevoNombre, { type: 'image/jpeg' });
            resolve(nuevoFile);
          }, 'image/jpeg', 0.9);
        } catch {
          URL.revokeObjectURL(url);
          resolve(null);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(null);
      };
      img.src = url;
    });
  }

  const inputsFile = document.querySelectorAll('.input-file-documento');
  inputsFile.forEach((inputEl) => {
    inputEl.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const fileList = target.files;
      if (!fileList || fileList.length === 0) return;

      let file = fileList[0];
      const requisito = target.getAttribute('data-requisito');
      const contenedor = target.closest('.requisito-item');
      const estadoSpan = contenedor?.querySelector('.estado-subida') as HTMLElement | null;

      function setEstado(texto: string, cargando: boolean = false) {
        if (!estadoSpan) return;
        estadoSpan.textContent = texto;
        estadoSpan.style.display = texto ? 'block' : 'none';
        estadoSpan.dataset.cargando = cargando ? 'true' : 'false';
      }

      // 1. Validar en cliente
      const validacion = validarArchivoCliente(file);
      if (!validacion.valido) {
        if (validacion.esHeic) {
          setEstado('Convirtiendo foto a JPEG...', true);
          const convertido = await convertirHeicAJpeg(file);
          if (convertido) {
            file = convertido;
          } else {
            mostrarError('Tu teléfono tomó la foto en formato HEIC y no fue posible convertirla automáticamente. Por favor toma una foto en formato JPG o selecciona otro archivo.');
            setEstado('', false);
            target.value = '';
            return;
          }
        } else {
          mostrarError(validacion.error || 'Archivo no válido.');
          setEstado('', false);
          target.value = '';
          return;
        }
      }

      setEstado('Autorizando carga...', true);

      try {
        // 2. Pedir token de subida de un solo uso
        const authRes = await fetch('/api/portal/subida-autorizar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-FGREC-Portal': '1'
          },
          body: JSON.stringify({
            requisito,
            nombreArchivo: file.name,
            tipo: validacion.tipoMime || file.type,
            tamano: file.size
          })
        });

        if (authRes.status === 401) {
          window.location.href = '/mi-postulacion/ingresar';
          return;
        }

        const authData = await authRes.json();
        if (!authRes.ok || !authData.token || !authData.url) {
          mostrarError(authData.message || 'No fue posible autorizar la subida del documento.');
          setEstado('Error de autorización', false);
          target.value = '';
          return;
        }

        setEstado('Subiendo archivo a FGREC...', true);

        // 3. Subir archivo crudo directo a FGREC con el token
        // Browser calcula Content-Length automáticamente
        const uploadRes = await fetch(authData.url, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${authData.token}`,
            'Content-Type': authData.tipo
          },
          body: file
        });

        if (uploadRes.status === 202) {
          setEstado('✓ Documento recibido', false);
          mostrarExito(`Recibimos ${file.name}. Gracias.`);
          setTimeout(() => {
            window.location.reload();
          }, 1200);
        } else {
          let errData: any = {};
          try {
            errData = await uploadRes.json();
          } catch {}
          const errorMsg = mensajeErrorSubida(uploadRes.status, errData.code, errData.message);
          mostrarError(errorMsg);
          setEstado('Rechazado', false);
          target.value = '';
        }
      } catch (err: any) {
        mostrarError('Error de red durante la carga del archivo. Vuelve a seleccionar el archivo para intentar de nuevo.');
        setEstado('Error de subida', false);
        target.value = '';
      }
    });
  });

  // El botón principal de la tarjeta lleva al primer pendiente y deja el foco ahí (el ancla sola no mueve el foco).
  document.querySelectorAll<HTMLAnchorElement>('a[data-ir]').forEach((enlace) => {
    enlace.addEventListener('click', (e) => {
      const destino = document.querySelector<HTMLElement>(enlace.getAttribute('href') || '');
      if (!destino) return;
      e.preventDefault();
      const sinMovimiento = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      destino.scrollIntoView({ behavior: sinMovimiento ? 'auto' : 'smooth', block: 'start' });
      history.replaceState(null, '', enlace.getAttribute('href') || '');
      const foco = destino.querySelector<HTMLElement>('.btn-cargar-archivo, #cartaTexto, #btnAceptarConsentimiento') ?? destino;
      foco.focus({ preventScroll: true });
    });
  });

  document.querySelectorAll<HTMLLabelElement>('.btn-cargar-archivo').forEach((label) => {
    label.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        const input = label.querySelector<HTMLInputElement>('input[type="file"]');
        input?.click();
      }
    });
  });
</script>
