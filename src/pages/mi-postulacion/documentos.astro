---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto,
  obtenerVariableEntorno
} from '../../lib/fgrec-portal.ts';
import { presentarEstadoDocumento, type RequisitoUI } from '../../lib/portal-pure.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;

if (!sesionToken) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

const contexto = extraerContextoVisitante(Astro.request);

// 1. Obtener listado de requisitos y estado documental
const respuestaDocs = await llamarFGRECPortal({
  metodo: 'GET',
  rutaRelativa: 'documentos',
  sesion: sesionToken,
  contexto
});

if (respuestaDocs.status === 401) {
  borrarSesionYContacto(Astro.cookies);
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

if (respuestaDocs.status === 403) {
  return Astro.redirect('/mi-postulacion/codigo', 302);
}

const statusError = !respuestaDocs.ok ? respuestaDocs.status : null;
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20la%20documentación%20de%20mi%20postulación.`
  : null;

const docsData = respuestaDocs.data || {};
const consentimientoPendiente = Boolean(docsData.consentimientoPendiente);
const requisitos: RequisitoUI[] = Array.isArray(docsData.requisitos) ? docsData.requisitos : [];

// 2. Si el consentimiento está pendiente, traer los textos
let textoConsentimiento: any = null;
if (consentimientoPendiente && respuestaDocs.ok) {
  const respCons = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'consentimientos',
    sesion: sesionToken,
    contexto
  });
  if (respCons.ok && respCons.data?.textos?.length > 0) {
    textoConsentimiento = respCons.data.textos[0];
  }
}

// 3. Consultar datos de la postulación para obtener el asesor asignado
let asesoraAsignada: { nombre: string; whatsapp?: string | null } | null = null;
try {
  const respPostulacion = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'postulacion',
    sesion: sesionToken,
    contexto
  });
  if (respPostulacion.ok && respPostulacion.data?.asesora) {
    asesoraAsignada = respPostulacion.data.asesora;
  }
} catch {
  // Asesoría fallback
}
---

<PortalLayout title="Documentos de la postulación | Fundación Gran Rosario" autenticado={true}>
  {statusError === 429 ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">⏳</div>
      <h1 class="portal-title">Demasiados intentos</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        Has realizado demasiadas solicitudes en poco tiempo. Por favor espera unos minutos antes de volver a ingresar.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Hablar con un asesor por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : statusError !== null ? (
    <div class="portal-card" style="text-align: center; padding: 2.25rem 1.5rem;">
      <div style="font-size: 2.5rem; margin-bottom: 1rem;">🔧</div>
      <h1 class="portal-title">Servicio no disponible</h1>
      <p class="portal-desc" style="max-width: 440px; margin: 0 auto 1.5rem auto;">
        El servicio no está disponible; intenta de nuevo en unos minutos. Si necesitas enviar tus documentos con urgencia, puedes coordinar la entrega por WhatsApp.
      </p>
      {whatsappHref && (
        <div style="max-width: 320px; margin: 0 auto;">
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn portal-btn--wa-full">
            Contactar por WhatsApp
          </a>
        </div>
      )}
    </div>
  ) : (
    <div class="portal-card">
      <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem; flex-wrap: wrap;">
        <div>
          <a class="enlace-flecha" href="/mi-postulacion" style="margin-bottom: 8px; font-size: 14px;">
            <span aria-hidden="true">←</span> Volver a mi postulación
          </a>
          <p class="antetitulo" style="margin-bottom: 4px;">Expediente institucional</p>
          <h1 class="portal-title" style="margin: 0; font-size: 28px;">Documentación requerida</h1>
        </div>
        {whatsappHref && (
          <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="portal-btn-sm portal-btn-sm--ghost" style="color: var(--portal-azul); border-color: var(--portal-borde);">
            Enviar por WhatsApp
          </a>
        )}
      </div>
      <p class="portal-desc" style="margin-top: 8px;">
        Carga los documentos solicitados para la evaluación académica de tu expediente. Solo se aceptan archivos PDF, JPG y PNG de hasta 10 MB.
      </p>

      {asesoraAsignada?.nombre && (
        <div style="background: var(--crema, #F7F4EE); border: 1px solid var(--portal-borde); border-radius: var(--portal-radio); padding: 12px 16px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap;">
          <div style="display: flex; align-items: center; gap: 10px;">
            <div style="width: 32px; height: 32px; border-radius: 50%; background: var(--portal-azul); color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700; flex-shrink: 0;">
              {asesoraAsignada.nombre.charAt(0).toUpperCase()}
            </div>
            <span style="font-size: 14px; color: var(--portal-texto);">
              Tu asesora asignada para este expediente es <strong style="color: var(--portal-azul);">{asesoraAsignada.nombre}</strong>.
            </span>
          </div>
          {whatsappHref && (
            <a href={whatsappHref} target="_blank" rel="noopener noreferrer" class="enlace-flecha" style="font-size: 13px;">
              Consultar con mi asesora <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
      )}

      <div id="alertaError" class="portal-alert portal-alert--error" style="display: none;"></div>
      <div id="alertaExito" class="portal-alert portal-alert--success" style="display: none;"></div>

      <!-- Bloque de consentimiento pendiente -->
      {consentimientoPendiente && textoConsentimiento && (
        <div id="bloqueConsentimiento" class="nota-destacada" style="margin-bottom: 24px;">
          <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
            <span style="font-size: 18px;">📝</span>
            <h2 style="font-size: 17px; font-weight: 700; color: var(--portal-azul); margin: 0;">
              Consentimiento para tratamiento de datos y transferencia académica
            </h2>
          </div>

          {textoConsentimiento.borrador && (
            <div style="font-size: 11px; font-weight: 700; text-transform: uppercase; background: var(--crema-2); color: var(--portal-cobre-texto); display: inline-block; padding: 2px 8px; border-radius: 4px; margin-bottom: 12px; border: 1px solid var(--portal-borde);">
              Borrador institucional ({textoConsentimiento.version})
            </div>
          )}

          <div style="font-size: 14px; color: var(--portal-texto); line-height: 1.5; white-space: pre-wrap; max-height: 180px; overflow-y: auto; background: #FFFFFF; padding: 12px; border-radius: 4px; border: 1px solid var(--portal-borde); margin-bottom: 14px;">
            {textoConsentimiento.texto}
          </div>

          <button
            type="button"
            id="btnAceptarConsentimiento"
            data-codigo={textoConsentimiento.codigo}
            data-version={textoConsentimiento.version}
            class="portal-btn portal-btn--acento"
            style="width: auto;"
          >
            Acepto el consentimiento y habilitar la carga
          </button>
        </div>
      )}

      <!-- Listado de requisitos -->
      <div id="listaRequisitos" style={consentimientoPendiente ? 'opacity: 0.5; pointer-events: none;' : ''}>
        {requisitos.length === 0 ? (
          <div style="text-align: center; padding: 2rem; color: var(--portal-mutado);">
            No hay requisitos documentales pendientes para esta vía.
          </div>
        ) : (
            <div style="display: flex; flex-direction: column; gap: 16px;">
              {requisitos.map((req) => {
                const vista = presentarEstadoDocumento(req);
                const colorDetalle = (req.estado === 'OBSERVADO' || req.estado === 'REEMPLAZO_SOLICITADO')
                  ? 'var(--portal-rojo)'
                  : 'var(--portal-mutado)';

                return (
                  <div
                    class="requisito-item"
                    data-requisito={req.codigo}
                    style="border: 1.5px solid var(--portal-borde); border-radius: var(--portal-radio); padding: 20px 24px; background: #FFFFFF; display: flex; flex-direction: column; gap: 12px; box-shadow: 0 2px 6px rgba(11, 27, 46, 0.03);"
                  >
                    <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 14px; flex-wrap: wrap;">
                      <div>
                        <h3 style="font-size: 18px; font-weight: 700; color: var(--portal-azul); margin: 0 0 4px 0; line-height: 1.25;">
                          {req.nombre}
                        </h3>
                        {req.obligatorio ? (
                          <span style="font-size: 11px; font-weight: 800; color: var(--portal-cobre-texto); text-transform: uppercase; letter-spacing: 0.08em; background: var(--crema-2, #F3EBDD); padding: 2px 8px; border-radius: 3px; display: inline-block;">
                            Obligatorio para admisión
                          </span>
                        ) : (
                          <span style="font-size: 11px; font-weight: 700; color: var(--portal-mutado); text-transform: uppercase; letter-spacing: 0.08em; background: #F1F5F9; padding: 2px 8px; border-radius: 3px; display: inline-block;">
                            Documento opcional
                          </span>
                        )}
                      </div>

                      <!-- Badge de estado -->
                      <div>
                        {req.estado === 'PENDIENTE' && (
                          <span class="badge-acento" style="background: var(--crema-2, #F3EBDD); color: var(--portal-cobre-texto); border-color: #DFD5C3;">
                            ○ Pendiente de carga
                          </span>
                        )}
                        {req.estado === 'RECIBIDO' && (
                          <span class="badge-acento" style="background: #E8F0FE; color: #174EA6; border-color: #D2E3FC;">
                            ⏳ Recibido · En revisión
                          </span>
                        )}
                        {req.estado === 'VALIDADO' && (
                          <span class="badge-acento" style="background: var(--portal-verde-fondo); color: var(--portal-verde); border-color: #C4DEC8;">
                            ✓ Validado por admisiones
                          </span>
                        )}
                        {req.estado === 'OBSERVADO' && (
                          <span class="badge-acento" style="background: var(--portal-ambar-fondo); color: var(--portal-ambar); border-color: #F6DFB3;">
                            ⚠️ Observado
                          </span>
                        )}
                        {req.estado === 'REEMPLAZO_SOLICITADO' && (
                          <span class="badge-acento" style="background: var(--portal-rojo-fondo); color: var(--portal-rojo); border-color: #F5C2C0;">
                            ⚠️ Reemplazo solicitado
                          </span>
                        )}
                      </div>
                    </div>

                    <!-- Detalle o motivo con aviso destacado -->
                    {vista.detalle && (
                      <div class="nota-destacada" style={`font-size: 14px; color: ${colorDetalle}; line-height: 1.45; padding: 10px 14px; margin: 2px 0;`}>
                        {vista.detalle}
                      </div>
                    )}

                    <!-- Zona de acción para cargar o reemplazar archivo -->
                    {vista.permiteSubida && (
                      <div style="margin-top: 4px; padding-top: 12px; border-top: 1px dashed var(--portal-borde); display: flex; align-items: center; gap: 14px; flex-wrap: wrap;">
                        <label
                          class="boton boton--acento btn-cargar-archivo"
                          style="cursor: pointer; width: auto; font-size: 15px; min-height: 44px; padding: 10px 20px; display: inline-flex;"
                        >
                          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" y1="3" x2="12" y2="15"></line>
                          </svg>
                          <span>{vista.textoBoton === 'Reemplazar' ? 'Subir reemplazo' : 'Cargar archivo (PDF o foto)'}</span>
                          <input
                            type="file"
                            class="input-file-documento"
                            data-requisito={req.codigo}
                            accept="image/jpeg,image/png,application/pdf"
                            style="display: none;"
                          />
                        </label>
                        <span style="font-size: 13px; color: var(--portal-mutado);">
                          PDF, JPG o PNG · Hasta 10 MB
                        </span>
                        <span class="estado-subida" style="font-size: 14px; font-weight: 700; color: var(--portal-azul); display: none;"></span>
                      </div>
                    )}
                  </div>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <div class="portal-card" style="font-size: 0.8125rem; color: var(--portal-mutado); line-height: 1.45;">
    <p style="margin: 0 0 0.5rem 0;">
      <strong>¿Problemas al tomar la foto o con el formato?</strong>
    </p>
    <p style="margin: 0;">
      Asegúrate de que la foto tenga buena luz, sin reflejos y con los bordes del documento visibles.
      Si estás en un iPhone, las imágenes HEIC se convierten a formato compatible. En caso de interrupciones,
      también puedes coordinar la entrega con tu asesora mediante el WhatsApp oficial de la Fundación.
    </p>
  </div>
</PortalLayout>

<script>
  import { validarArchivoCliente, mensajeErrorSubida } from '../../lib/portal-pure.ts';

  const alertaError = document.getElementById('alertaError') as HTMLDivElement | null;
  const alertaExito = document.getElementById('alertaExito') as HTMLDivElement | null;
  const btnAceptarConsentimiento = document.getElementById('btnAceptarConsentimiento') as HTMLButtonElement | null;
  const listaRequisitos = document.getElementById('listaRequisitos') as HTMLDivElement | null;
  const bloqueConsentimiento = document.getElementById('bloqueConsentimiento') as HTMLDivElement | null;

  function mostrarError(msg: string) {
    if (alertaExito) alertaExito.style.display = 'none';
    if (!alertaError) return;
    alertaError.textContent = msg;
    alertaError.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function mostrarExito(msg: string) {
    if (alertaError) alertaError.style.display = 'none';
    if (!alertaExito) return;
    alertaExito.textContent = msg;
    alertaExito.style.display = 'block';
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  btnAceptarConsentimiento?.addEventListener('click', async () => {
    const codigo = btnAceptarConsentimiento.getAttribute('data-codigo');
    const version = btnAceptarConsentimiento.getAttribute('data-version');
    btnAceptarConsentimiento.disabled = true;
    btnAceptarConsentimiento.textContent = 'Registrando aceptación...';

    try {
      const res = await fetch('/api/portal/consentimiento', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-FGREC-Portal': '1'
        },
        body: JSON.stringify({ codigo, version })
      });

      if (res.status === 401) {
        window.location.href = '/mi-postulacion/ingresar';
        return;
      }

      if (res.ok) {
        mostrarExito('Consentimiento registrado con éxito. Ya puedes cargar tus documentos.');
        if (bloqueConsentimiento) bloqueConsentimiento.style.display = 'none';
        if (listaRequisitos) {
          listaRequisitos.style.opacity = '1';
          listaRequisitos.style.pointerEvents = 'auto';
        }
      } else {
        const data = await res.json();
        mostrarError(data.message || 'No se pudo registrar el consentimiento.');
        btnAceptarConsentimiento.disabled = false;
        btnAceptarConsentimiento.textContent = 'Acepto el consentimiento y habilitar la carga';
      }
    } catch {
      mostrarError('Error de conexión al registrar consentimiento.');
      btnAceptarConsentimiento.disabled = false;
    }
  });

  async function convertirHeicAJpeg(file: File): Promise<File | null> {
    return new Promise((resolve) => {
      const url = URL.createObjectURL(file);
      const img = new Image();
      img.onload = () => {
        try {
          const canvas = document.createElement('canvas');
          canvas.width = img.naturalWidth || img.width;
          canvas.height = img.naturalHeight || img.height;
          const ctx = canvas.getContext('2d');
          if (!ctx) {
            URL.revokeObjectURL(url);
            resolve(null);
            return;
          }
          ctx.drawImage(img, 0, 0);
          canvas.toBlob((blob) => {
            URL.revokeObjectURL(url);
            if (!blob) {
              resolve(null);
              return;
            }
            const nuevoNombre = file.name.replace(/\.[^/.]+$/, '') + '.jpg';
            const nuevoFile = new File([blob], nuevoNombre, { type: 'image/jpeg' });
            resolve(nuevoFile);
          }, 'image/jpeg', 0.9);
        } catch {
          URL.revokeObjectURL(url);
          resolve(null);
        }
      };
      img.onerror = () => {
        URL.revokeObjectURL(url);
        resolve(null);
      };
      img.src = url;
    });
  }

  const inputsFile = document.querySelectorAll('.input-file-documento');
  inputsFile.forEach((inputEl) => {
    inputEl.addEventListener('change', async (e) => {
      const target = e.target as HTMLInputElement;
      const fileList = target.files;
      if (!fileList || fileList.length === 0) return;

      let file = fileList[0];
      const requisito = target.getAttribute('data-requisito');
      const contenedor = target.closest('.requisito-item');
      const estadoSpan = contenedor?.querySelector('.estado-subida') as HTMLElement | null;

      function setEstado(texto: string, cargando: boolean = false) {
        if (!estadoSpan) return;
        estadoSpan.textContent = texto;
        estadoSpan.style.display = 'inline';
        if (cargando) {
          estadoSpan.style.color = 'var(--portal-azul)';
        }
      }

      // 1. Validar en cliente
      const validacion = validarArchivoCliente(file);
      if (!validacion.valido) {
        if (validacion.esHeic) {
          setEstado('Convirtiendo foto a JPEG...', true);
          const convertido = await convertirHeicAJpeg(file);
          if (convertido) {
            file = convertido;
          } else {
            mostrarError('Tu teléfono tomó la foto en formato HEIC y no fue posible convertirla automáticamente. Por favor toma una foto en formato JPG o selecciona otro archivo.');
            setEstado('', false);
            target.value = '';
            return;
          }
        } else {
          mostrarError(validacion.error || 'Archivo no válido.');
          setEstado('', false);
          target.value = '';
          return;
        }
      }

      setEstado('Autorizando carga...', true);

      try {
        // 2. Pedir token de subida de un solo uso
        const authRes = await fetch('/api/portal/subida-autorizar', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'X-FGREC-Portal': '1'
          },
          body: JSON.stringify({
            requisito,
            nombreArchivo: file.name,
            tipo: validacion.tipoMime || file.type,
            tamano: file.size
          })
        });

        if (authRes.status === 401) {
          window.location.href = '/mi-postulacion/ingresar';
          return;
        }

        const authData = await authRes.json();
        if (!authRes.ok || !authData.token || !authData.url) {
          mostrarError(authData.message || 'No fue posible autorizar la subida del documento.');
          setEstado('Error de autorización', false);
          target.value = '';
          return;
        }

        setEstado('Subiendo archivo a FGREC...', true);

        // 3. Subir archivo crudo directo a FGREC con el token
        // Browser calcula Content-Length automáticamente
        const uploadRes = await fetch(authData.url, {
          method: 'POST',
          headers: {
            'Authorization': `Bearer ${authData.token}`,
            'Content-Type': authData.tipo
          },
          body: file
        });

        if (uploadRes.status === 202) {
          setEstado('✓ Documento recibido', false);
          mostrarExito(`¡${file.name} recibido con éxito! El documento está en revisión preliminar.`);
          setTimeout(() => {
            window.location.reload();
          }, 1200);
        } else {
          let errData: any = {};
          try {
            errData = await uploadRes.json();
          } catch {}
          const errorMsg = mensajeErrorSubida(uploadRes.status, errData.code, errData.message);
          mostrarError(errorMsg);
          setEstado('Rechazado', false);
          target.value = '';
        }
      } catch (err: any) {
        mostrarError('Error de red durante la carga del archivo. Vuelve a seleccionar el archivo para intentar de nuevo.');
        setEstado('Error de subida', false);
        target.value = '';
      }
    });
  });
</script>
