---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
---

<PortalLayout title="Ingreso | Portal del Postulante">
  <div class="portal-auth-grid">
    <div class="portal-auth-info">
      <p class="portal-auth-badge">
        Portal del Postulante · Red Universitaria
      </p>

      <h1 class="portal-auth-title">
        Tu postulación universitaria, acompañada paso a paso hacia tu <em>admisión</em>.
      </h1>
      
      <p class="portal-auth-desc">
        Consulta el estado de tu expediente académico en tiempo real, gestiona tus documentos oficiales y mantén contacto directo con tu asesora institucional.
      </p>

      <ul class="portal-auth-features">
        <li class="portal-auth-feature">
          <span class="portal-auth-feature__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </span>
          <div>
            <strong>Evaluación de expediente en vivo</strong>
            <p>Conoce en todo momento la etapa académica en la que se encuentra tu postulación.</p>
          </div>
        </li>

        <li class="portal-auth-feature">
          <span class="portal-auth-feature__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="17 8 12 3 7 8"></polyline>
              <line x1="12" y1="3" x2="12" y2="15"></line>
            </svg>
          </span>
          <div>
            <strong>Carga ágil de documentos</strong>
            <p>Sube tu cédula, títulos o certificados directamente desde tu celular o computadora.</p>
          </div>
        </li>

        <li class="portal-auth-feature">
          <span class="portal-auth-feature__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
            </svg>
          </span>
          <div>
            <strong>Acceso seguro sin contraseñas</strong>
            <p>Ingreso seguro mediante un código de verificación de un solo uso enviado a tu correo.</p>
          </div>
        </li>
      </ul>
    </div>

    <div class="portal-card--auth">
      <div style="margin-bottom: 20px;">
        <p class="antetitulo" style="margin-bottom: 6px;">Acceso al expediente</p>
        <h2 class="portal-title">Ingresar al Portal</h2>
        <p class="portal-desc" style="margin-bottom: 0;">
          Escribe el correo electrónico o el teléfono celular registrado al iniciar tu postulación:
        </p>
      </div>

      <div id="mensajeAlerta" class="portal-alert portal-alert--error" style="display: none;"></div>

      <form id="formIngresar">
        <div class="portal-input-group">
          <label for="contactoInput" class="portal-label">Correo electrónico o celular con código de país</label>
          <input
            type="text"
            id="contactoInput"
            name="contacto"
            class="portal-input"
            placeholder="ejemplo@correo.com o +593991234567"
            autocomplete="email"
            required
          />
          <span style="display: block; font-size: 13px; color: var(--portal-mutado); margin-top: 6px; line-height: 1.4;">
            Si usas tu número celular, asegúrate de incluir el signo <strong>+</strong> y el código de tu país (ej. <strong>+593</strong> para Ecuador).
          </span>
        </div>

        <div class="nota-destacada" style="margin-bottom: 20px; font-size: 14px; line-height: 1.45;">
          Por tu seguridad, te enviaremos un código de verificación de 6 dígitos a tu correo registrado para validar tu identidad.
        </div>

        <button type="submit" id="btnEnviar" class="portal-btn portal-btn--acento">
          Enviar código de acceso
        </button>
      </form>
    </div>
  </div>
</PortalLayout>

<script>
  const form = document.getElementById('formIngresar') as HTMLFormElement | null;
  const contactoInput = document.getElementById('contactoInput') as HTMLInputElement | null;
  const btnEnviar = document.getElementById('btnEnviar') as HTMLButtonElement | null;
  const alerta = document.getElementById('mensajeAlerta') as HTMLDivElement | null;

  function mostrarError(msg: string) {
    if (!alerta) return;
    alerta.textContent = msg;
    alerta.style.display = 'block';
  }

  function ocultarError() {
    if (!alerta) return;
    alerta.style.display = 'none';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    ocultarError();

    const contacto = contactoInput?.value.trim() || '';
    if (!contacto) {
      mostrarError('Por favor ingresa tu correo o número telefónico.');
      return;
    }

    if (btnEnviar) {
      btnEnviar.disabled = true;
      btnEnviar.textContent = 'Enviando...';
    }

    try {
      const res = await fetch('/api/portal/codigo', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-FGREC-Portal': '1'
        },
        body: JSON.stringify({ contacto })
      });

      const data = await res.json();

      if (res.status === 202 || res.ok) {
        // Redirigir a la pantalla de verificación del código
        window.location.href = '/mi-postulacion/codigo';
      } else {
        mostrarError(data.message || 'No fue posible procesar la solicitud. Intenta de nuevo.');
        if (btnEnviar) {
          btnEnviar.disabled = false;
          btnEnviar.textContent = 'Enviar código de acceso';
        }
      }
    } catch {
      mostrarError('Ocurrió un problema de conexión. Intenta de nuevo en unos momentos.');
      if (btnEnviar) {
        btnEnviar.disabled = false;
        btnEnviar.textContent = 'Enviar código de acceso';
      }
    }
  });
</script>
