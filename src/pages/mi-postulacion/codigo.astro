---
export const prerender = false;

import PortalLayout from '../../layouts/PortalLayout.astro';
import {
  COOKIE_SESION_NOMBRE,
  COOKIE_CONTACTO_NOMBRE,
  llamarFGRECPortal,
  extraerContextoVisitante,
  borrarSesionYContacto
} from '../../lib/fgrec-portal.ts';

const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;
const contactoPendiente = Astro.cookies.get(COOKIE_CONTACTO_NOMBRE)?.value;

if (!sesionToken && !contactoPendiente) {
  return Astro.redirect('/mi-postulacion/ingresar', 302);
}

let infoDestino = 'tu correo electrónico registrado';
let nombrePila = '';

if (sesionToken) {
  const contexto = extraerContextoVisitante(Astro.request);
  const resp = await llamarFGRECPortal({
    metodo: 'GET',
    rutaRelativa: 'precalificador/contexto',
    sesion: sesionToken,
    contexto
  });

  if (resp.status === 401) {
    borrarSesionYContacto(Astro.cookies);
    return Astro.redirect('/mi-postulacion/ingresar', 302);
  }

  if (resp.ok && resp.data) {
    if (resp.data.nombre) nombrePila = resp.data.nombre;
  }
} else if (contactoPendiente) {
  infoDestino = contactoPendiente;
}
---

<PortalLayout title="Verificar código | Portal del Postulante">
  <div class="portal-auth-grid">
    <div class="portal-auth-info">
      <p class="portal-auth-badge">
        Verificación de Identidad · Acceso Seguro
      </p>

      <h1 class="portal-auth-title">
        {nombrePila ? `Hola, ${nombrePila}. Valida tu` : 'Valida tu'} acceso al <em>expediente</em>.
      </h1>

      <p class="portal-auth-desc">
        Hemos enviado un código temporal de 6 dígitos a <strong style="color: var(--portal-cobre-texto);">{infoDestino}</strong> para ingresar sin necesidad de contraseñas.
      </p>

      <ul class="portal-auth-features">
        <li class="portal-auth-feature">
          <span class="portal-auth-feature__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <polyline points="12 6 12 12 16 14"></polyline>
            </svg>
          </span>
          <div>
            <strong>Código de validez temporal</strong>
            <p>El código expira en 15 minutos o tras 5 intentos fallidos.</p>
          </div>
        </li>

        <li class="portal-auth-feature">
          <span class="portal-auth-feature__icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
              <polyline points="22,6 12,13 2,6"></polyline>
            </svg>
          </span>
          <div>
            <strong>Revisa tu carpeta de Spam o Correo no deseado</strong>
            <p>Si no lo ves en tu bandeja de entrada en 1 minuto, revisa las carpetas secundarias.</p>
          </div>
        </li>
      </ul>
    </div>

    <div class="portal-card--auth">
      <div style="margin-bottom: 20px;">
        <p class="antetitulo" style="margin-bottom: 6px;">Paso de verificación</p>
        <h2 class="portal-title">Código de verificación</h2>
        <p class="portal-desc" style="margin-bottom: 0;">
          Escribe los 6 dígitos recibidos para continuar:
        </p>
      </div>

      <div id="alertaError" class="portal-alert portal-alert--error" style="display: none;"></div>
      <div id="alertaExito" class="portal-alert portal-alert--success" style="display: none;"></div>

      <form id="formCodigo">
        <div class="portal-input-group" style="text-align: center;">
          <input
            type="text"
            id="codigoInput"
            name="codigo"
            class="portal-input"
            inputmode="numeric"
            pattern="[0-9]{6}"
            maxlength="6"
            placeholder="••••••"
            autocomplete="one-time-code"
            style="font-size: 2.25rem; letter-spacing: 0.35em; text-align: center; font-weight: 700; height: 3.75rem;"
            required
            autofocus
          />
          <span id="intentosTexto" style="display: block; font-size: 13px; color: var(--portal-mutado); margin-top: 8px;">
            Tienes hasta 5 intentos antes de que el código expire.
          </span>
        </div>

        <button type="submit" id="btnVerificar" class="portal-btn portal-btn--acento">
          Verificar código
        </button>
      </form>

      <div style="margin-top: 24px; text-align: center; border-top: 1px dashed var(--portal-borde); padding-top: 18px;">
        <p style="font-size: 14px; color: var(--portal-mutado); margin-bottom: 10px;">
          ¿No lo recibiste o expiró el código anterior?
        </p>
        <button
          type="button"
          id="btnReenviar"
          class="portal-btn portal-btn--outline"
          style="width: auto; padding: 10px 20px; font-size: 14px; margin: 0 auto;"
        >
          Reenviar código
        </button>
        <div id="temporizadorReenvio" style="display: none; font-size: 13px; color: var(--portal-mutado); margin-top: 8px;">
          Podrás solicitar un nuevo código en <span id="segundosRestantes">60</span> s.
        </div>
      </div>
    </div>
  </div>
</PortalLayout>

<script>
  const form = document.getElementById('formCodigo') as HTMLFormElement | null;
  const codigoInput = document.getElementById('codigoInput') as HTMLInputElement | null;
  const btnVerificar = document.getElementById('btnVerificar') as HTMLButtonElement | null;
  const btnReenviar = document.getElementById('btnReenviar') as HTMLButtonElement | null;
  const alertaError = document.getElementById('alertaError') as HTMLDivElement | null;
  const alertaExito = document.getElementById('alertaExito') as HTMLDivElement | null;
  const intentosTexto = document.getElementById('intentosTexto') as HTMLElement | null;
  const temporizadorReenvio = document.getElementById('temporizadorReenvio') as HTMLDivElement | null;
  const segundosRestantes = document.getElementById('segundosRestantes') as HTMLElement | null;

  function mostrarError(msg: string) {
    if (alertaExito) alertaExito.style.display = 'none';
    if (!alertaError) return;
    alertaError.textContent = msg;
    alertaError.style.display = 'block';
  }

  function mostrarExito(msg: string) {
    if (alertaError) alertaError.style.display = 'none';
    if (!alertaExito) return;
    alertaExito.textContent = msg;
    alertaExito.style.display = 'block';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (alertaError) alertaError.style.display = 'none';

    const codigo = (codigoInput?.value || '').replace(/\D/g, '');
    if (codigo.length !== 6) {
      mostrarError('Por favor ingresa los 6 dígitos del código.');
      return;
    }

    if (btnVerificar) {
      btnVerificar.disabled = true;
      btnVerificar.textContent = 'Verificando...';
    }

    try {
      const res = await fetch('/api/portal/verificar', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-FGREC-Portal': '1'
        },
        body: JSON.stringify({ codigo })
      });

      if (res.status === 401) {
        window.location.href = '/mi-postulacion/ingresar';
        return;
      }

      const data = await res.json();

      if (res.ok && data.ok) {
        mostrarExito('¡Código verificado con éxito! Redirigiendo...');
        setTimeout(() => {
          if (data.siguiente === 'documentos') {
            window.location.href = '/mi-postulacion/documentos';
          } else if (data.siguiente === 'precalificador') {
            window.location.href = '/mi-postulacion/precalificador';
          } else {
            window.location.href = '/mi-postulacion';
          }
        }, 200);
      } else {
        if (data.intentosRestantes !== undefined && intentosTexto) {
          intentosTexto.textContent = `Intentos restantes: ${data.intentosRestantes}`;
          intentosTexto.style.color = 'var(--portal-rojo)';
        }
        mostrarError(data.message || 'Código incorrecto o vencido.');
        if (btnVerificar) {
          btnVerificar.disabled = false;
          btnVerificar.textContent = 'Verificar código';
        }
      }
    } catch {
      mostrarError('Error de comunicación. Intenta nuevamente.');
      if (btnVerificar) {
        btnVerificar.disabled = false;
        btnVerificar.textContent = 'Verificar código';
      }
    }
  });

  // Temporizador de reenvío
  let timer: any = null;
  function iniciarCuentaRegresiva(segundos: number) {
    if (!btnReenviar || !temporizadorReenvio || !segundosRestantes) return;
    btnReenviar.disabled = true;
    temporizadorReenvio.style.display = 'block';
    let restante = segundos;
    segundosRestantes.textContent = String(restante);

    clearInterval(timer);
    timer = setInterval(() => {
      restante -= 1;
      if (restante <= 0) {
        clearInterval(timer);
        btnReenviar.disabled = false;
        temporizadorReenvio.style.display = 'none';
      } else {
        segundosRestantes.textContent = String(restante);
      }
    }, 1000);
  }

  btnReenviar?.addEventListener('click', async () => {
    mostrarExito('Solicitando código...');
    btnReenviar.disabled = true;

    try {
      const res = await fetch('/api/portal/codigo', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'X-FGREC-Portal': '1'
        },
        body: JSON.stringify({})
      });

      if (res.status === 401) {
        window.location.href = '/mi-postulacion/ingresar';
        return;
      }

      const data = await res.json();
      if (res.status === 202 || res.ok) {
        mostrarExito('Te enviamos un código de verificación. Revisa tu bandeja de entrada o spam.');
        iniciarCuentaRegresiva(data.reenviarEn || 60);
      } else {
        mostrarError(data.message || 'No fue posible enviar el código en este momento.');
        btnReenviar.disabled = false;
      }
    } catch {
      mostrarError('Error al contactar al servidor.');
      btnReenviar.disabled = false;
    }
  });
</script>
