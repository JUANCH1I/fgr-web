---
import Layout from "../layouts/Layout.astro";
import FormularioContacto from "../components/FormularioContacto.astro";
---
<Layout title="Contacto" description="Escríbenos o visítanos en Quito. Un asesor de la Fundación del Gran Rosario Ecuador revisa tu caso y te dice qué opciones tienes." >
  <section class="cabecera cabecera--simple">
    <div class="contenedor">
      <p class="antetitulo">Contacto</p>
      <h1>Hablemos de tu caso</h1>
      <p class="entrada">Un asesor revisa tu situación y te dice qué opciones tienes. Sin compromiso.</p>
    </div>
  </section>

  <section class="seccion">
    <div class="contenedor dos-columnas">
      <div>
        <h2>Escríbenos</h2>
        <FormularioContacto />
      </div>
    <div class="contacto-datos">
      <h2>Sede internacional</h2>
      <div>
        <h3>Dirección</h3>
        <p>Av. 12 de Octubre N26-97 y Abraham Lincoln, Edificio Torre 1492, Oficina 902.<br>Quito, Ecuador.</p>
      </div>
      <div>
        <h3>Teléfono</h3>
        <p>+593 96 301 7631</p>
      </div>
      <div>
        <h3>Correo</h3>
        <p><a href="mailto:contacto@fgrec.org">contacto@fgrec.org</a></p>
      </div>
      <div>
        <h3>Oficinas</h3>
        <p>Oficinas en Colombia y Uruguay. Próximamente en Perú y Paraguay.</p>
      </div>
      <p><a class="enlace-flecha" href="https://www.google.com/maps/search/?api=1&amp;query=Torre+1492+Av.+12+de+Octubre+N26-97+Quito" target="_blank" rel="noopener">Ver en el mapa <span aria-hidden="true">→</span></a></p>
      <div class="botones">
        <a class="boton boton--oscuro" href="/contacto/">Hablar ahora con un asesor</a>
      </div>
    </div>
  </div>
</section>
</Layout>
