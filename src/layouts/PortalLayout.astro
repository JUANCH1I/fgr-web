---
// Layout exclusivo para el Portal del Postulante (/mi-postulacion)
// Aislado del sitio de marketing: CERO scripts de terceros, CERO analítica ni píxeles, CSP estricta y noindex.

import {
  obtenerVariableEntorno,
  llamarFGRECPortal,
  extraerContextoVisitante,
  COOKIE_SESION_NOMBRE
} from '../lib/fgrec-portal.ts';
import { leerDatos, datosFaltantes } from '../lib/datos-pure.ts';

interface Props {
  title?: string;
  autenticado?: boolean;
  /** Pendientes que muestra la barra lateral junto a cada sección. Si se omiten o faltan, se resuelven automáticamente. */
  pendientes?: { expediente?: number; datos?: number };
}

const {
  title = 'Portal del Postulante | Fundación Gran Rosario',
  autenticado = false,
  pendientes = {}
} = Astro.props;

const contadores = {
  expediente: pendientes.expediente,
  datos: pendientes.datos
};

// Si el usuario está autenticado y faltan contadores de pendientes para la barra lateral,
// se resuelven de forma centralizada para que la barra lateral conserve siempre sus indicadores consistentes.
if (autenticado && (contadores.expediente === undefined || contadores.datos === undefined)) {
  const sesionToken = Astro.cookies.get(COOKIE_SESION_NOMBRE)?.value;
  if (sesionToken) {
    const contexto = extraerContextoVisitante(Astro.request);
    const necesitaExpediente = contadores.expediente === undefined;
    const necesitaDatos = contadores.datos === undefined;

    try {
      const [respPostulacion, respConvenio, respDatos] = await Promise.all([
        necesitaExpediente ? llamarFGRECPortal({ metodo: 'GET', rutaRelativa: 'postulacion', sesion: sesionToken, contexto }) : null,
        necesitaExpediente ? llamarFGRECPortal({ metodo: 'GET', rutaRelativa: 'convenio', sesion: sesionToken, contexto }) : null,
        necesitaDatos ? llamarFGRECPortal({ metodo: 'GET', rutaRelativa: 'datos', sesion: sesionToken, contexto }) : null
      ]);

      if (necesitaExpediente && respPostulacion?.ok) {
        const post = respPostulacion.data || {};
        const docs = post.documentos || { pendientes: 0, observados: 0 };
        const cartaEnv = Boolean(post.expediente?.cartaEnviada);
        const convPend = respConvenio?.ok && respConvenio.data?.estado === 'GENERADO';
        contadores.expediente = Number(docs.pendientes ?? 0) + Number(docs.observados ?? 0) + (cartaEnv ? 0 : 1) + (convPend ? 1 : 0);
      }

      if (necesitaDatos && respDatos?.ok) {
        const d = leerDatos(respDatos.data);
        contadores.datos = datosFaltantes(d).length;
      }
    } catch {
      // Si la consulta auxiliar falla, no bloquea el render de la página
    }
  }
}

// Sección activa de la barra lateral, por la ruta: el convenio es parte del expediente y las preguntas previas, del inicio.
const ruta = Astro.url.pathname.replace(/\/+$/, '');
const seccion = ruta === '/mi-postulacion' || ruta.endsWith('/precalificador') ? 'inicio'
  : ruta.endsWith('/documentos') || ruta.endsWith('/convenio') ? 'expediente'
  : ruta.endsWith('/datos') ? 'datos'
  : ruta.endsWith('/pagos') ? 'pagos'
  : null;
const secciones = [
  { id: 'inicio', href: '/mi-postulacion', etiqueta: 'Inicio', pendientes: 0 },
  { id: 'expediente', href: '/mi-postulacion/documentos', etiqueta: 'Mi expediente', pendientes: contadores.expediente ?? 0 },
  { id: 'datos', href: '/mi-postulacion/datos', etiqueta: 'Mis datos', pendientes: contadores.datos ?? 0 },
  { id: 'pagos', href: '/mi-postulacion/pagos', etiqueta: 'Mis pagos', pendientes: 0 }
];

// CSP: Origen de subida autorizado para permitir en connect-src (además de 'self')
const uploadOrigin = obtenerVariableEntorno('FGREC_UPLOAD_ORIGIN');

// CSP estricta para el portal
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https://static.wixstatic.com",
  "font-src 'self' data:",
  `connect-src 'self' ${uploadOrigin}`,
  "frame-ancestors 'none'",
  "base-uri 'self'",
  "form-action 'self'"
].join('; ');

Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="stylesheet" href="/assets/css/sitio.css" />

  <style is:global>
    :root {
      --portal-azul: var(--azul, #0B1B2E);
      --portal-azul-profundo: var(--pie, #07121F);
      --portal-cobre: var(--cobre, #C98A4B);
      --portal-cobre-claro: var(--cobre-claro, #E2B587);
      --portal-cobre-texto: var(--cobre-texto, #8F5320);
      --portal-cobre-hover: var(--cobre-hover, #6E3F17);
      --portal-dorado: var(--cobre, #C98A4B);
      --portal-dorado-hover: var(--cobre-hover, #6E3F17);
      --portal-fondo: #F7F4EE; /* Crema institucional idéntica a la landing */
      --portal-blanco: #FFFFFF;
      --portal-texto: var(--texto, #14202E);
      --portal-mutado: var(--gris, #4F5B66);
      --portal-borde: var(--borde, #E3DCCF);
      --portal-linea: var(--linea-oscura, #22344A);
      --portal-verde: #1F5A32;
      --portal-verde-fondo: #E4EFE6;
      --portal-rojo: #A32218;
      --portal-rojo-fondo: #FDF2F2;
      --portal-ambar: #8F5320;
      --portal-ambar-fondo: #FDF7E7;
      --portal-radio: 6px;
    }

    body.portal-body {
      background-color: var(--portal-fondo);
      color: var(--portal-texto);
      font-family: var(--sans);
      font-size: 17px;
      line-height: 1.55;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Cabecera institucional idéntica a la cabecera de la landing */
    .portal-header {
      background: var(--portal-azul);
      color: #FFFFFF;
      border-bottom: 3px solid var(--portal-cobre);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .portal-header__inner {
      max-width: var(--ancho, 1160px);
      margin: 0 auto;
      padding: 14px var(--margen, 24px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .portal-logo-link {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: #FFFFFF;
      min-width: 0;
    }

    .portal-logo-link .portal-logo-img {
      width: 190px;
      height: auto;
      max-height: 54px;
      object-fit: contain;
      object-position: left center;
      display: block;
    }

    .portal-badge-header {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      background: rgba(201, 138, 75, 0.15);
      border: 1px solid rgba(226, 181, 135, 0.35);
      border-radius: 4px;
      color: var(--portal-cobre-claro);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .portal-header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .portal-header__inner {
        padding: 10px 16px;
        gap: 0.75rem;
      }
      .portal-logo-link .portal-logo-img {
        width: 145px;
        max-height: 42px;
      }
      .portal-badge-header {
        display: none;
      }
      .portal-link-volver {
        font-size: 13px;
      }
    }

    .portal-btn-sm {
      font-size: 14px;
      padding: 7px 14px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border: 1.5px solid transparent;
      transition: all 0.15s ease;
      cursor: pointer;
      font-family: inherit;
    }

    .portal-btn-sm--ghost {
      background: transparent;
      color: #D5DCE4;
      border-color: #5E738A;
    }
    .portal-btn-sm--ghost:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #FFFFFF;
      border-color: #CBD5E1;
    }

    .portal-link-volver {
      color: #D5DCE4;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .portal-link-volver:hover {
      color: #FFFFFF;
      text-decoration: underline;
    }

    /* Contenedor principal */
    .portal-container {
      max-width: var(--ancho, 1160px);
      width: 100%;
      margin: 0 auto;
      padding: 48px var(--margen, 24px);
      flex: 1;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
    }

    .portal-container--auth {
      justify-content: center;
    }

    /* Grid para el dashboard de Mi Postulación */
    .portal-dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
    }

    @media (min-width: 960px) {
      .portal-dashboard-grid {
        grid-template-columns: 1.6fr 1fr;
        gap: 32px;
        align-items: start;
      }
    }

    .portal-dashboard-main {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .portal-dashboard-aside {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Hero de bienvenida en el dashboard */
    .portal-hero-lead {
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 32px;
      box-shadow: 0 4px 16px rgba(11, 27, 46, 0.05);
      position: relative;
      overflow: hidden;
    }

    .portal-hero-lead::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--portal-cobre) 0%, var(--portal-cobre-claro) 100%);
    }

    /* Grid institucional de autenticación (2 columnas en desktop) */
    .portal-auth-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
      width: 100%;
      margin: auto 0;
    }

    @media (min-width: 900px) {
      .portal-auth-grid {
        grid-template-columns: 1.15fr 0.9fr;
        gap: 56px;
        align-items: center;
      }
    }

    /* En pantallas angostas: insignia y título, enseguida la tarjeta de ingreso y después las ventajas, compactas.
       El bloque informativo se disuelve en la grilla para poder intercalar la tarjeta entre sus partes. */
    @media (max-width: 899px) {
      .portal-auth-grid { gap: 14px; }
      .portal-auth-grid .portal-auth-info { display: contents; }
      .portal-auth-grid .portal-auth-badge { order: 1; font-size: 12px; }
      .portal-auth-grid .portal-auth-title { order: 2; font-size: 26px; }
      .portal-auth-grid .portal-auth-desc { display: none; }
      .portal-auth-grid .portal-card--auth { order: 3; margin-top: 8px; padding: 26px 20px; }
      .portal-auth-grid .portal-auth-features { order: 4; margin-top: 10px; gap: 10px; }
      .portal-auth-grid .portal-auth-feature { padding: 12px 14px; align-items: center; }
      .portal-auth-grid .portal-auth-feature p { display: none; }
      .portal-auth-grid .portal-auth-feature strong { margin-bottom: 0; font-size: 15px; }
    }

    .portal-auth-info {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .portal-auth-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--portal-cobre-texto);
      margin: 0;
    }

    .portal-auth-title {
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(32px, 4vw, 44px);
      line-height: 1.12;
      color: var(--portal-azul);
      letter-spacing: -0.01em;
      margin: 0;
    }

    .portal-auth-title em {
      font-style: normal;
      color: var(--portal-cobre-texto);
    }

    .portal-auth-desc {
      font-size: 18px;
      color: var(--portal-mutado);
      line-height: 1.5;
      margin: 0;
    }

    .portal-auth-features {
      list-style: none;
      padding: 0;
      margin: 12px 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .portal-auth-feature {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 16px 18px;
      box-shadow: 0 2px 6px rgba(11, 27, 46, 0.03);
    }

    .portal-auth-feature__icon {
      width: 38px;
      height: 38px;
      background: var(--crema-2, #F3EBDD);
      color: var(--portal-cobre-texto);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .portal-auth-feature strong {
      display: block;
      font-size: 16px;
      font-weight: 700;
      color: var(--portal-azul);
      margin-bottom: 2px;
    }

    .portal-auth-feature p {
      font-size: 14px;
      color: var(--portal-mutado);
      line-height: 1.4;
      margin: 0;
    }

    /* Tarjetas estilo Landing (como .tarjeta y .precalificador--destacado) */
    .portal-card {
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 28px;
      box-shadow: 0 4px 16px rgba(11, 27, 46, 0.05);
      margin-bottom: 20px;
    }

    .portal-card--auth {
      background: #FFFFFF;
      border: 1.5px solid var(--portal-borde);
      border-radius: 8px;
      padding: 32px 30px;
      box-shadow: 0 10px 30px rgba(11, 27, 46, 0.07), 0 2px 6px rgba(11, 27, 46, 0.03);
      position: relative;
    }

    .portal-card--auth::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--portal-cobre) 0%, var(--portal-cobre-claro) 100%);
      border-radius: 8px 8px 0 0;
    }

    .portal-title {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      color: var(--portal-azul);
      margin: 0 0 8px 0;
      line-height: 1.2;
    }

    .portal-desc {
      font-size: 16px;
      color: var(--portal-mutado);
      margin: 0 0 20px 0;
      line-height: 1.5;
    }

    /* Botones estilo Landing */
    .portal-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      min-height: 50px;
      padding: 13px 24px;
      border-radius: 4px;
      border: 1.5px solid transparent;
      font: inherit;
      font-weight: 700;
      font-size: 16px;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      cursor: pointer;
      box-sizing: border-box;
      transition: background-color .15s, color .15s, border-color .15s;
    }

    .portal-btn:active {
      transform: translateY(1px);
    }

    .portal-btn--primary {
      background: var(--portal-azul);
      color: #FFFFFF;
    }
    .portal-btn--primary:hover {
      background: var(--azul-3, #1B3350);
      color: #FFFFFF;
    }

    .portal-btn--gold, .portal-btn--acento {
      background: var(--portal-cobre);
      color: #FFFFFF;
    }
    .portal-btn--gold:hover, .portal-btn--acento:hover {
      background: var(--portal-cobre-hover);
      color: #FFFFFF;
    }

    .portal-btn--outline {
      border-color: var(--portal-azul);
      color: var(--portal-azul);
      background: #FFFFFF;
    }
    .portal-btn--outline:hover {
      background: var(--portal-fondo);
      color: var(--portal-azul);
    }

    .portal-btn--wa-full {
      background: #1F5A32;
      color: #FFFFFF;
      border-color: #1F5A32;
    }
    .portal-btn--wa-full:hover {
      background: #143d22;
      color: #FFFFFF;
    }

    /* Campos y formularios estilo Landing */
    .portal-input-group {
      margin-bottom: 18px;
    }

    .portal-label {
      display: block;
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--portal-azul);
    }

    .portal-input, .portal-select {
      width: 100%;
      min-height: 48px;
      padding: 10px 14px;
      font-size: 16px;
      font-family: inherit;
      border: 1.5px solid #CCD4DC;
      border-radius: 4px;
      background: #FCFCFD;
      color: var(--portal-texto);
      box-sizing: border-box;
      transition: border-color .15s, box-shadow .15s;
    }
    .portal-input:focus, .portal-select:focus {
      outline: none;
      border-color: var(--portal-cobre);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(201, 138, 75, 0.2);
    }

    /* Grupos de opciones (radios): el área tocable mide al menos 44px */
    .portal-fieldset { border: 0; padding: 0; min-width: 0; }
    .portal-fieldset legend { padding: 0; }
    .portal-radios { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .portal-radio {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 8px 16px;
      font-weight: 500;
      cursor: pointer;
      border: 1.5px solid #CCD4DC;
      border-radius: 4px;
      background: #FCFCFD;
      box-sizing: border-box;
    }
    .portal-radio input[type="radio"] { width: 22px; height: 22px; margin: 0; flex: none; accent-color: var(--portal-azul); cursor: pointer; }
    .portal-radio:has(input:checked) { border-color: var(--portal-cobre); background: #FFFFFF; }
    .portal-radio:has(input:focus-visible) { box-shadow: 0 0 0 3px rgba(201, 138, 75, 0.35); }

    /* Alertas */
    .portal-alert {
      padding: 14px 16px;
      border-radius: 4px;
      font-size: 15px;
      line-height: 1.45;
      margin-bottom: 18px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .portal-alert--error {
      background: var(--portal-rojo-fondo);
      color: var(--portal-rojo);
      border: 1px solid #F5C2C0;
      font-weight: 600;
    }
    .portal-alert--info {
      background: var(--crema-2, #F3EBDD);
      color: var(--portal-cobre-texto);
      border-left: 4px solid var(--portal-cobre);
      border-radius: 0 4px 4px 0;
    }
    .portal-alert--success {
      background: var(--portal-verde-fondo);
      color: var(--portal-verde);
      border: 1px solid #C4DEC8;
      font-weight: 600;
    }


    /* ---------- Componentes del panel «Mi postulación» (compartidos con la página de documentos) ---------- */
    .postulacion-container {
      max-width: 1120px;
      margin: 0 auto;
      padding: 16px 0 48px;
    }


    /* LAYOUT GRID DE DOS COLUMNAS */
    .postulacion-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) 340px;
      gap: 28px;
      align-items: start;
    }

    /* TARJETA DE ACCIÓN PRIORITARIA */
    .action-card {
      background: var(--portal-blanco);
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
      padding: 22px 24px;
      position: relative;
      box-shadow: 0 2px 6px rgba(11, 27, 46, 0.04);
      margin-bottom: 20px;
    }
    .action-card::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--portal-azul);
    }
    .action-card__tag {
      display: inline-block;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--portal-cobre-texto);
      background: #F3EBDD;
      padding: 2px 8px;
      border-radius: 2px;
      margin-bottom: 10px;
      border-left: 2px solid var(--portal-cobre);
    }
    .action-card__heading {
      font-family: var(--serif);
      font-size: 20px;
      font-weight: 600;
      color: var(--portal-azul);
      margin: 0 0 8px 0;
      line-height: 1.3;
    }
    .action-card__lead {
      font-size: 13.5px;
      color: var(--portal-mutado);
      margin: 0 0 16px 0;
      line-height: 1.5;
    }

    /* AUDITORÍA DE ELEMENTOS PENDIENTES */
    .audit-list {
      background: #FDFDFD;
      border: 1px solid var(--portal-borde);
      border-radius: 3px;
      margin-bottom: 26px;
    }
    .audit-list__row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 12px 18px;
      border-bottom: 1px solid #F1ECE3;
      font-size: 13.5px;
      gap: 12px;
    }
    .audit-list__row:last-child { border-bottom: none; }
    .audit-list__col-left {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--portal-azul);
      font-weight: 500;
    }
    .audit-indicator {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }
    .audit-indicator--ok {
      background: var(--portal-verde-fondo);
      color: var(--portal-verde);
    }
    .audit-indicator--pending {
      border: 1.5px solid #94A3B8;
      background: transparent;
    }
    .badge-status {
      font-size: 11px;
      font-weight: 600;
      padding: 2px 8px;
      border-radius: 2px;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      flex-shrink: 0;
    }
    .badge-status--ok {
      background: var(--portal-verde-fondo);
      color: var(--portal-verde);
    }
    .badge-status--pending {
      background: #FEF3C7;
      color: #92400E;
    }

    .btn-primary {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: var(--portal-azul);
      color: #FFFFFF;
      text-decoration: none;
      font-weight: 600;
      font-size: 14.5px;
      letter-spacing: 0.02em;
      padding: 13px 26px;
      border-radius: 3px;
      border: 1px solid var(--portal-azul);
      transition: background 0.15s, border-color 0.15s;
    }
    .btn-primary:hover {
      background: var(--portal-cobre-hover);
      border-color: var(--portal-cobre-hover);
      color: #FFFFFF;
    }


    /* ASIDE INSTITUCIONAL */
    .aside-card {
      background: var(--portal-blanco);
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
      padding: 26px;
      box-shadow: 0 1px 3px rgba(11, 27, 46, 0.03);
    }
    .aside-card__section-title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--portal-cobre-texto);
      margin: 0 0 16px 0;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--portal-borde);
    }
    .advisor-profile {
      display: flex;
      align-items: center;
      gap: 14px;
      margin-bottom: 16px;
    }
    .advisor-avatar {
      width: 46px;
      height: 46px;
      border-radius: 2px;
      background: var(--portal-azul);
      color: #FFFFFF;
      font-size: 16px;
      font-weight: 700;
      font-family: var(--serif);
      display: flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--portal-cobre);
      flex-shrink: 0;
    }
    .advisor-details strong {
      display: block;
      color: var(--portal-azul);
      font-size: 15px;
      font-weight: 700;
      line-height: 1.3;
    }
    .advisor-details span {
      font-size: 12.5px;
      color: var(--portal-mutado);
    }
    .advisor-desc {
      font-size: 13px;
      color: var(--portal-mutado);
      line-height: 1.55;
      margin: 0 0 20px 0;
    }
    .btn-contact {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      background: #FFFFFF;
      color: var(--portal-azul);
      border: 1px solid var(--portal-azul);
      text-decoration: none;
      font-weight: 600;
      font-size: 13.5px;
      padding: 10px 16px;
      border-radius: 3px;
      transition: all 0.15s;
      margin-bottom: 24px;
    }
    .btn-contact:hover {
      background: var(--portal-azul);
      color: #FFFFFF;
    }
    .info-dl {
      margin: 0;
      padding-top: 16px;
      border-top: 1px solid var(--portal-borde);
      font-size: 12.5px;
      color: var(--portal-mutado);
    }
    .info-dl__item {
      display: flex;
      justify-content: space-between;
      padding: 6px 0;
      border-bottom: 1px dashed var(--portal-borde);
    }
    .info-dl__item:last-child { border-bottom: none; }
    .info-dl__label { font-weight: 600; color: var(--portal-azul); }



    /* Responsive de los componentes del panel */
    @media (max-width: 768px) {
      .postulacion-layout { grid-template-columns: 1fr; gap: 20px; }
      .action-card { padding: 22px 18px; }
      .audit-list__row { flex-direction: column; align-items: flex-start; gap: 6px; }
    }

    /* ---------- Página de documentos: mismas piezas del panel, aplicadas a filas y secciones ---------- */
    .exp-cab { max-width: none; margin-bottom: 20px; }
    .exp-cab__bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; margin-bottom: 6px; }
    .exp-cab__hero { display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; flex-wrap: wrap; }
    .exp-cab .portal-title { font-size: 26px; margin-bottom: 2px; color: var(--portal-azul); }
    .exp-cab .portal-desc { font-size: 13.5px; color: var(--portal-mutado); margin: 0; }
    .postulacion-main > .portal-alert { margin-bottom: 16px; }
    .action-card__estado { display: flow-root; }
    .action-card__estado .action-card__lead { margin-bottom: 24px; }
    .action-card:not(:has(.btn-primary)) .action-card__estado .action-card__lead { margin-bottom: 0; }
    .action-card__lead strong { color: var(--portal-azul); font-weight: 600; }
    button.btn-primary { font-family: inherit; cursor: pointer; }
    .btn-primary:focus-visible, .btn-contact:focus-visible { outline: 3px solid var(--portal-cobre); outline-offset: 2px; }

    /* Action Card cuando está en el aside */
    .action-card--aside { padding: 20px; margin-bottom: 20px; }
    .action-card--aside .action-card__heading { font-size: 18px; margin-bottom: 8px; line-height: 1.3; }
    .action-card--aside .action-card__lead { font-size: 13px; margin-bottom: 16px; line-height: 1.5; }
    .btn-primary--block { width: 100%; box-sizing: border-box; justify-content: center; }

    /* Consentimiento legible y distinguido */
    .exp-consentimiento-card {
      padding: 20px 24px;
      margin-bottom: 20px;
      border: 1px solid var(--portal-borde);
      border-left: 4px solid var(--portal-cobre);
      background: var(--portal-blanco);
      border-radius: 4px;
      box-shadow: 0 1px 3px rgba(11, 27, 46, 0.04);
    }
    .exp-consentimiento-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }
    .exp-consentimiento-title-group {
      display: flex;
      align-items: center;
      gap: 10px;
    }
    .exp-consentimiento-title-group .section-card__title {
      margin: 0;
      padding: 0;
      border: none;
      font-size: 15px;
      font-weight: 700;
      color: var(--portal-azul);
    }
    .exp-consentimiento__texto {
      margin-bottom: 16px;
      max-height: 140px;
      font-size: 13.5px;
      line-height: 1.6;
      color: #1E293B;
      padding: 14px 16px;
      background: #FAF8F5;
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
      overflow-y: auto;
      white-space: pre-line;
    }
    .exp-consentimiento-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }
    .exp-consentimiento-hint {
      margin: 0;
      font-size: 12.5px;
      color: var(--portal-mutado);
      display: flex;
      align-items: center;
      gap: 6px;
    }

    /* Sub-solapas de navegación interna en Mi Expediente */
    .exp-solapas {
      display: flex;
      gap: 8px;
      margin-bottom: 16px;
      border-bottom: 1px solid var(--portal-borde);
    }
    .exp-solapa {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      background: transparent;
      border: none;
      border-bottom: 3px solid transparent;
      color: var(--portal-mutado);
      font-size: 14px;
      font-weight: 500;
      cursor: pointer;
      font-family: inherit;
      margin-bottom: -1px;
      transition: color 0.15s ease, border-color 0.15s ease;
    }
    .exp-solapa:hover {
      color: var(--portal-azul);
    }
    .exp-solapa--activa,
    .exp-solapa[aria-selected="true"] {
      color: var(--portal-azul);
      font-weight: 600;
      border-bottom-color: var(--portal-cobre);
    }
    .exp-solapa svg {
      flex-shrink: 0;
      opacity: 0.75;
      stroke: currentColor;
    }
    .exp-solapa--activa svg,
    .exp-solapa[aria-selected="true"] svg {
      opacity: 1;
      color: var(--portal-cobre-texto);
    }
    .exp-solapa__contador {
      font-size: 11px;
      font-weight: 700;
      padding: 2px 8px;
      border-radius: 10px;
      letter-spacing: 0.02em;
    }
    .exp-solapa__contador--alerta {
      background: #FEF3C7;
      color: #92400E;
    }
    .exp-solapa__contador--ok {
      background: var(--portal-verde-fondo);
      color: var(--portal-verde);
    }
    .exp-solapa__contador--info {
      background: #EFF6FF;
      color: #1E40AF;
    }
    .exp-solapa:focus-visible {
      outline: 2px solid var(--portal-cobre);
      outline-offset: 2px;
    }
    @media (max-width: 640px) {
      .exp-solapas {
        flex-direction: column;
        gap: 6px;
        border-bottom: none;
      }
      .exp-solapa {
        width: 100%;
        justify-content: flex-start;
        border-bottom: none;
        border-left: 3px solid transparent;
        padding: 10px 14px;
        background: var(--portal-blanco);
        border-radius: 4px;
        box-shadow: 0 1px 2px rgba(11, 27, 46, 0.04);
        margin-bottom: 0;
      }
      .exp-solapa--activa,
      .exp-solapa[aria-selected="true"] {
        border-left-color: var(--portal-cobre);
        background: #F7F5F0;
      }
    }

    /* Tabla de documentos horizontal y compacta */
    .section-card--compact { padding: 18px 22px; margin-bottom: 16px; }
    .section-card__topbar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--portal-borde); margin-bottom: 10px; }
    .section-card__topbar-formatos { font-size: 12px; color: var(--portal-mutado); }
    .section-card__topbar-formatos strong { color: var(--portal-azul); }
    .audit-list--table { margin-bottom: 0; }
    .audit-list__row--table {
      display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; padding: 8px 16px; min-height: 48px; gap: 12px; border-bottom: 1px solid #F1ECE3;
    }
    .audit-list__col-main { display: flex; align-items: center; gap: 12px; color: var(--portal-azul); flex: 1 1 260px; min-width: 0; }
    .audit-list__col-actions { display: flex; align-items: center; gap: 14px; flex-shrink: 0; }
    .audit-list__subida { display: flex; align-items: center; gap: 10px; }
    .audit-list__subida .btn-contact--fila { min-height: 34px; padding: 6px 14px; font-size: 13px; border-radius: 3px; }
    .audit-list__nota { flex-basis: 100%; padding-top: 4px; }
    .audit-list__nota .portal-alert { margin: 0; font-size: 12.5px; padding: 6px 12px; }

    .section-card {
      background: var(--portal-blanco);
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
      padding: 26px;
      box-shadow: 0 1px 3px rgba(11, 27, 46, 0.03);
      margin-bottom: 24px;
      scroll-margin-top: 96px;
    }
    .section-card__title {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.1em;
      color: var(--portal-cobre-texto);
      margin: 0 0 14px 0;
      padding-bottom: 8px;
      border-bottom: 1px solid var(--portal-borde);
    }
    .section-card__resumen { font-size: 13.5px; color: var(--portal-mutado); margin: 0 0 14px; display: flex; align-items: center; gap: 8px; }
    .section-card__resumen--ok { color: var(--portal-verde); font-weight: 600; }
    .section-card .audit-list { margin-bottom: 0; }
    .exp-vacio { margin: 0; font-size: 13.5px; color: var(--portal-mutado); }
    .exp-bloqueado { opacity: 0.5; }

    .exp-consentimiento__borrador {
      display: inline-block;
      margin: 0 0 12px;
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--portal-cobre-texto);
      background: #F3EBDD;
      padding: 3px 9px;
      border-radius: 3px;
    }
    .exp-consentimiento__texto {
      margin-bottom: 18px;
      font-size: 14px;
      line-height: 1.55;
      white-space: pre-wrap;
      max-height: 180px;
      overflow-y: auto;
      padding: 12px 16px;
      background: #FDFDFD;
      border: 1px solid var(--portal-borde);
      border-radius: 3px;
    }

    /* Fila de documento: el nombre y la etiqueta de estado van siempre; lo demás solo si hay algo que hacer */
    .audit-list__row--expand { flex-wrap: wrap; scroll-margin-top: 96px; }
    .audit-list__row--expand:focus { outline: none; }
    .audit-list__row--expand:target { background: #F7F4EE; }
    .audit-list__nombre { margin: 0; font: inherit; font-weight: 500; color: var(--portal-azul); }
    .audit-list__opcional { margin-left: 8px; font-size: 12px; font-weight: 400; color: var(--portal-mutado); white-space: nowrap; }
    .audit-indicator--alert { border: 1.5px solid var(--portal-ambar); color: var(--portal-ambar); font-size: 11px; font-weight: 700; line-height: 1; }
    .audit-indicator--error { border: 1.5px solid var(--portal-rojo); color: var(--portal-rojo); font-size: 11px; font-weight: 700; line-height: 1; }
    .badge-status--error { background: var(--portal-rojo-fondo); color: var(--portal-rojo); }
    .audit-list__extra { flex-basis: 100%; padding: 4px 0 4px 30px; display: flex; flex-direction: column; gap: 12px; }
    .audit-list__extra .portal-alert { margin: 0; font-size: 13.5px; padding: 10px 14px; }
    .audit-list__accion { display: flex; flex-wrap: wrap; align-items: center; gap: 8px 14px; }
    .audit-list__formato { margin: 0; font-size: 12.5px; color: var(--portal-mutado); }
    .estado-subida { margin: 0; font-size: 13.5px; font-weight: 700; color: var(--portal-rojo); }
    .estado-subida[data-cargando="true"] { color: var(--portal-azul); }

    /* Botón secundario del panel (el de «Contactar vía WhatsApp») en tamaño de fila */
    .btn-contact--fila {
      display: inline-flex;
      margin: 0;
      min-height: 44px;
      box-sizing: border-box;
      font-family: inherit;
      cursor: pointer;
      position: relative;
    }
    .btn-contact--fila:focus-within { outline: 3px solid var(--portal-cobre); outline-offset: 2px; }
    .btn-contact--fila input[type="file"] { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }

    .exp-ayuda { margin-top: 14px; }
    .exp-ayuda summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: 13.5px; font-weight: 600; color: var(--portal-azul); }
    .exp-ayuda summary::-webkit-details-marker { display: none; }
    .exp-ayuda summary::before {
      content: "";
      flex: none;
      width: 6px;
      height: 6px;
      margin-right: 10px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(-45deg);
    }
    .exp-ayuda[open] > summary::before { transform: rotate(45deg); }
    .exp-ayuda p { margin: 0 0 8px; font-size: 13.5px; color: var(--portal-mutado); line-height: 1.55; max-width: 65ch; }
    .exp-ayuda a { color: var(--portal-azul); font-weight: 600; }

    @media (max-width: 768px) {
      .exp-cab .portal-title { font-size: 26px; }
      .section-card { padding: 22px 18px; }
      .audit-list__extra { padding-left: 0; }
      .audit-list__extra, .audit-list__row--expand .audit-list__accion { align-self: stretch; }
      .btn-contact--fila { width: 100%; justify-content: center; }
    }
    @media (prefers-reduced-motion: reduce) {
      .btn-primary, .btn-contact { transition: none; }
    }

    /* Pie de página institucional */
    .portal-footer {
      background: var(--pie, #07121F);
      color: #D5DCE4;
      border-top: 1px solid var(--linea-oscura, #22344A);
      padding: 32px var(--margen, 24px);
      font-size: 14px;
      text-align: center;
      margin-top: auto;
    }

    .portal-footer__inner {
      max-width: var(--ancho, 1160px);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .portal-footer-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .portal-footer-links a {
      color: #D5DCE4;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .portal-footer-links a:hover {
      color: var(--portal-cobre-claro);
    }
    /* Barra lateral del portal con sesión (escritorio fija; en pantallas angostas, desplegable) */
    .portal-shell { display: flex; min-height: 100vh; }
    .portal-sidebar {
      width: 260px; flex-shrink: 0; box-sizing: border-box;
      position: sticky; top: 0; height: 100vh; overflow-y: auto;
      display: flex; flex-direction: column; gap: 24px; padding: 24px 16px 20px;
      background: #091524; color: var(--portal-blanco);
      border-right: 1px solid rgba(226, 181, 135, 0.12);
    }
    .portal-sidebar__marca {
      display: flex; flex-direction: column; align-items: flex-start; gap: 8px;
      padding: 0 8px 12px; text-decoration: none;
      border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    }
    .portal-sidebar__marca .portal-logo-img { width: 168px; height: auto; object-fit: contain; }
    .portal-sidebar__badge {
      display: inline-flex; align-items: center;
      font-size: 10.5px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.08em;
      color: #E2B587; background: rgba(201, 138, 75, 0.12);
      border: 1px solid rgba(201, 138, 75, 0.25);
      border-radius: 3px; padding: 3px 8px;
    }
    .portal-sidebar__nav { display: flex; flex-direction: column; gap: 4px; }
    .portal-sidebar__link {
      display: flex; align-items: center; gap: 12px; min-height: 44px; padding: 0 14px;
      border-radius: 6px; color: #A0B0C0; font-size: 14.5px; font-weight: 500; text-decoration: none;
      border-left: 3px solid transparent;
      transition: background 0.15s ease, color 0.15s ease, border-left-color 0.15s ease;
    }
    .portal-sidebar__link:hover { background: rgba(255, 255, 255, 0.05); color: var(--portal-blanco); }
    .portal-sidebar__link[aria-current="page"] {
      background: linear-gradient(90deg, rgba(201, 138, 75, 0.16) 0%, rgba(201, 138, 75, 0.04) 100%);
      color: var(--portal-blanco); font-weight: 600; border-left-color: var(--portal-cobre);
    }
    .portal-sidebar__icono { flex-shrink: 0; opacity: 0.75; stroke: currentColor; transition: opacity 0.15s ease, color 0.15s ease; }
    .portal-sidebar__link:hover .portal-sidebar__icono { opacity: 1; }
    .portal-sidebar__link[aria-current="page"] .portal-sidebar__icono { opacity: 1; color: var(--portal-cobre-claro); }
    .portal-sidebar__link:focus-visible, .portal-sidebar__salir:focus-visible, .portal-menu-btn:focus-visible { outline: 2px solid var(--portal-cobre-claro); outline-offset: 2px; }
    .portal-sidebar__texto { flex-grow: 1; }
    .portal-sidebar__contador {
      min-width: 20px; height: 20px; padding: 0 6px; box-sizing: border-box; border-radius: 10px;
      display: inline-flex; align-items: center; justify-content: center;
      font-size: 11.5px; font-weight: 700; color: #FFFFFF; background: var(--portal-cobre);
    }
    .portal-sidebar__pie {
      margin-top: auto;
      padding-top: 16px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
      display: flex;
      flex-direction: column;
    }
    .portal-sidebar__salir {
      min-height: 40px; padding: 0 12px; border: 0; background: none; color: #8F9CAE; font: inherit; font-size: 13.5px;
      display: flex; align-items: center; gap: 10px; cursor: pointer; border-radius: 4px;
      transition: color 0.15s ease, background 0.15s ease;
    }
    .portal-sidebar__salir:hover { color: var(--portal-blanco); background: rgba(255, 255, 255, 0.04); }
    .portal-sidebar__salir svg { opacity: 0.7; }
    .portal-sidebar__salir:hover svg { opacity: 1; }
    .portal-shell__contenido { flex: 1 1 auto; min-width: 0; display: flex; flex-direction: column; }
    .portal-container--shell {
      max-width: 1440px;
      margin: 0;
      padding: 20px 32px 32px;
      width: 100%;
      box-sizing: border-box;
    }
    .portal-topbar { display: none; }
    .portal-sidebar-fondo { position: fixed; inset: 0; z-index: 40; background: rgba(7, 18, 31, 0.5); }
    .portal-sidebar-fondo[hidden] { display: none; }
    @media (max-width: 899px) {
      .portal-shell { display: block; }
      .portal-topbar {
        display: flex; align-items: center; gap: 12px; padding: 8px 12px;
        position: sticky; top: 0; z-index: 30; background: var(--portal-azul);
      }
      .portal-menu-btn {
        display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 12px; cursor: pointer;
        border: 1px solid var(--portal-linea); border-radius: var(--portal-radio); background: none;
        color: var(--portal-blanco); font: inherit; font-size: 14px; font-weight: 600;
      }
      .portal-topbar__logo { height: 32px; width: auto; }
      .portal-sidebar {
        position: fixed; top: 0; left: 0; bottom: 0; height: auto; z-index: 50; width: min(280px, 85vw);
        transform: translateX(-100%); visibility: hidden;
        transition: transform 0.25s cubic-bezier(0.22, 1, 0.36, 1), visibility 0s linear 0.25s;
      }
      .portal-sidebar--abierta { transform: none; visibility: visible; transition-delay: 0s; }
      .portal-container--shell { padding: 20px 16px 32px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .portal-sidebar { transition: none; }
    }
  </style>
</head>
<body class="portal-body">
  {autenticado ? (
  <div class="portal-shell">
    <div class="portal-topbar">
      <button type="button" class="portal-menu-btn" id="btnMenuPortal" aria-expanded="false" aria-controls="portalSidebar">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        <span>Menú</span>
      </button>
      <img class="portal-topbar__logo" src="https://static.wixstatic.com/media/64d480_878e9bae365142a8a7cfd49040026764~mv2.png" alt="Fundación del Gran Rosario Ecuador" width="140" height="40" />
    </div>
    <div class="portal-sidebar-fondo" id="portalSidebarFondo" hidden></div>

    <aside class="portal-sidebar" id="portalSidebar" aria-label="Portal del postulante">
      <a href="/" class="portal-sidebar__marca" title="Volver al inicio del sitio">
        <img class="portal-logo-img" src="https://static.wixstatic.com/media/64d480_878e9bae365142a8a7cfd49040026764~mv2.png" alt="Fundación del Gran Rosario Ecuador" width="190" height="54" />
        <span class="portal-sidebar__badge">Portal del Postulante</span>
      </a>
      <nav class="portal-sidebar__nav" aria-label="Secciones">
        {secciones.map((s) => (
          <a href={s.href} class="portal-sidebar__link" aria-current={seccion === s.id ? 'page' : undefined}>
            {s.id === 'inicio' && (
              <svg class="portal-sidebar__icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
            )}
            {s.id === 'expediente' && (
              <svg class="portal-sidebar__icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
            )}
            {s.id === 'datos' && (
              <svg class="portal-sidebar__icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            )}
            {s.id === 'pagos' && (
              <svg class="portal-sidebar__icono" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            )}
            <span class="portal-sidebar__texto">{s.etiqueta}</span>
            {s.pendientes > 0 && (
              <span class="portal-sidebar__contador" aria-label={s.pendientes === 1 ? '1 pendiente' : `${s.pendientes} pendientes`}>{s.pendientes}</span>
            )}
          </a>
        ))}
      </nav>
      <div class="portal-sidebar__pie">
        <button type="button" id="btnSalirPortal" class="portal-sidebar__salir">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span>Cerrar sesión</span>
        </button>
      </div>
    </aside>

    <div class="portal-shell__contenido">
      <main class="portal-container portal-container--shell">
        <slot />
      </main>
    </div>
  </div>
  ) : (
  <>
  <header class="portal-header">
    <div class="portal-header__inner">
      <a href="/" class="portal-logo-link" title="Volver al inicio del sitio">
        <img class="portal-logo-img" src="https://static.wixstatic.com/media/64d480_878e9bae365142a8a7cfd49040026764~mv2.png" alt="Fundación del Gran Rosario Ecuador" width="190" height="54" />
        <span class="portal-badge-header">Portal del Postulante</span>
      </a>

      <div class="portal-header-actions">
        <a href="/" class="portal-link-volver">
          <span aria-hidden="true">←</span>
          <span>Volver al sitio</span>
        </a>
      </div>
    </div>
  </header>

  <main class="portal-container portal-container--auth">
    <slot />
  </main>
  </>
  )}

  <footer class="portal-footer">
    <div class="portal-footer__inner">
      <div><strong>Fundación del Gran Rosario Ecuador</strong> · Admisiones y Acompañamiento Académico</div>
      <div class="portal-footer-links">
        <a href="/" target="_blank" rel="noopener">Inicio</a>
        <span>·</span>
        <a href="/carreras/" target="_blank" rel="noopener">Carreras</a>
        <span>·</span>
        <a href="/proteccion-de-datos/" target="_blank" rel="noopener">Protección de Datos</a>
        <span>·</span>
        <a href="/contacto/" target="_blank" rel="noopener">Contacto</a>
      </div>
    </div>
  </footer>

  <script>
    // Barra lateral desplegable en pantallas angostas: el botón abre y cierra; Escape y el fondo la cierran.
    const btnMenu = document.getElementById('btnMenuPortal');
    const sidebar = document.getElementById('portalSidebar');
    const fondo = document.getElementById('portalSidebarFondo');
    const abrirMenu = (abierto: boolean) => {
      if (!btnMenu || !sidebar || !fondo) return;
      btnMenu.setAttribute('aria-expanded', String(abierto));
      sidebar.classList.toggle('portal-sidebar--abierta', abierto);
      fondo.hidden = !abierto;
      if (abierto) sidebar.querySelector<HTMLElement>('a, button')?.focus();
    };
    btnMenu?.addEventListener('click', () => abrirMenu(btnMenu.getAttribute('aria-expanded') !== 'true'));
    fondo?.addEventListener('click', () => abrirMenu(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && btnMenu?.getAttribute('aria-expanded') === 'true') { abrirMenu(false); btnMenu.focus(); }
    });

    const btnSalir = document.getElementById('btnSalirPortal');
    btnSalir?.addEventListener('click', async () => {
      try {
        await fetch('/api/portal/salir', {
          method: 'POST',
          headers: {
            'X-FGREC-Portal': '1'
          }
        });
      } finally {
        window.location.href = '/mi-postulacion/ingresar';
      }
    });
  </script>
</body>
</html>
