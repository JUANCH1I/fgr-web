---
// Layout exclusivo para el Portal del Postulante (/mi-postulacion)
// Aislado del sitio de marketing: CERO scripts de terceros, CERO analítica ni píxeles, CSP estricta y noindex.

import { obtenerVariableEntorno } from '../lib/fgrec-portal.ts';

interface Props {
  title?: string;
  autenticado?: boolean;
}

const {
  title = 'Portal del Postulante | Fundación Gran Rosario',
  autenticado = false
} = Astro.props;

// WhatsApp institucional configurado por variable de entorno
const whatsappNumero = obtenerVariableEntorno('FGREC_WHATSAPP_NUMERO').replace(/[^\d+]/g, '');
const whatsappHref = whatsappNumero
  ? `https://wa.me/${whatsappNumero.replace(/^\+/, '')}?text=Hola,%20tengo%20una%20consulta%20sobre%20mi%20postulación.`
  : null;

// CSP: Origen de subida autorizado para permitir en connect-src (además de 'self')
const uploadOrigin = obtenerVariableEntorno('FGREC_UPLOAD_ORIGIN');

// CSP estricta para el portal
const csp = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self' 'unsafe-inline'",
  "img-src 'self' data: blob: https://static.wixstatic.com",
  "font-src 'self' data:",
  `connect-src 'self' ${uploadOrigin}`,
  "frame-ancestors 'none'",
  "base-uri 'self'",
  "form-action 'self'"
].join('; ');

Astro.response.headers.set('Content-Security-Policy', csp);
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Frame-Options', 'DENY');
Astro.response.headers.set('Cache-Control', 'no-store, no-cache, must-revalidate, proxy-revalidate');
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="robots" content="noindex, nofollow, noarchive" />
  <meta name="referrer" content="no-referrer" />

  <!-- Favicon -->
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="icon" href="/favicon-32x32.png" type="image/png" sizes="32x32" />
  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

  <link rel="stylesheet" href="/assets/css/sitio.css" />

  <style is:global>
    :root {
      --portal-azul: var(--azul, #0B1B2E);
      --portal-azul-profundo: var(--pie, #07121F);
      --portal-cobre: var(--cobre, #C98A4B);
      --portal-cobre-claro: var(--cobre-claro, #E2B587);
      --portal-cobre-texto: var(--cobre-texto, #8F5320);
      --portal-cobre-hover: var(--cobre-hover, #6E3F17);
      --portal-dorado: var(--cobre, #C98A4B);
      --portal-dorado-hover: var(--cobre-hover, #6E3F17);
      --portal-fondo: #F7F4EE; /* Crema institucional idéntica a la landing */
      --portal-blanco: #FFFFFF;
      --portal-texto: var(--texto, #14202E);
      --portal-mutado: var(--gris, #4F5B66);
      --portal-borde: var(--borde, #E3DCCF);
      --portal-linea: var(--linea-oscura, #22344A);
      --portal-verde: #1F5A32;
      --portal-verde-fondo: #E4EFE6;
      --portal-rojo: #A32218;
      --portal-rojo-fondo: #FDF2F2;
      --portal-ambar: #8F5320;
      --portal-ambar-fondo: #FDF7E7;
      --portal-radio: 6px;
    }

    body.portal-body {
      background-color: var(--portal-fondo);
      color: var(--portal-texto);
      font-family: var(--sans);
      font-size: 17px;
      line-height: 1.55;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      margin: 0;
      padding: 0;
      -webkit-font-smoothing: antialiased;
    }

    /* Cabecera institucional idéntica a la cabecera de la landing */
    .portal-header {
      background: var(--portal-azul);
      color: #FFFFFF;
      border-bottom: 3px solid var(--portal-cobre);
      position: sticky;
      top: 0;
      z-index: 50;
    }

    .portal-header__inner {
      max-width: var(--ancho, 1160px);
      margin: 0 auto;
      padding: 14px var(--margen, 24px);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .portal-logo-link {
      display: flex;
      align-items: center;
      gap: 14px;
      text-decoration: none;
      color: #FFFFFF;
      min-width: 0;
    }

    .portal-logo-link .portal-logo-img {
      width: 190px;
      height: auto;
      max-height: 54px;
      object-fit: contain;
      object-position: left center;
      display: block;
    }

    .portal-badge-header {
      display: inline-flex;
      align-items: center;
      padding: 3px 10px;
      background: rgba(201, 138, 75, 0.15);
      border: 1px solid rgba(226, 181, 135, 0.35);
      border-radius: 4px;
      color: var(--portal-cobre-claro);
      font-size: 13px;
      font-weight: 700;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      white-space: nowrap;
    }

    .portal-header-actions {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-shrink: 0;
    }

    @media (max-width: 640px) {
      .portal-header__inner {
        padding: 10px 16px;
        gap: 0.75rem;
      }
      .portal-logo-link .portal-logo-img {
        width: 145px;
        max-height: 42px;
      }
      .portal-badge-header {
        display: none;
      }
      .portal-link-volver {
        font-size: 13px;
      }
    }

    .portal-btn-sm {
      font-size: 14px;
      padding: 7px 14px;
      border-radius: 4px;
      text-decoration: none;
      font-weight: 700;
      display: inline-flex;
      align-items: center;
      gap: 0.35rem;
      border: 1.5px solid transparent;
      transition: all 0.15s ease;
      cursor: pointer;
      font-family: inherit;
    }

    .portal-btn-sm--ghost {
      background: transparent;
      color: #D5DCE4;
      border-color: #5E738A;
    }
    .portal-btn-sm--ghost:hover {
      background: rgba(255, 255, 255, 0.08);
      color: #FFFFFF;
      border-color: #CBD5E1;
    }

    .portal-link-volver {
      color: #D5DCE4;
      text-decoration: none;
      font-size: 14px;
      font-weight: 500;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }
    .portal-link-volver:hover {
      color: #FFFFFF;
      text-decoration: underline;
    }

    /* Contenedor principal */
    .portal-container {
      max-width: var(--ancho, 1160px);
      width: 100%;
      margin: 0 auto;
      padding: 48px var(--margen, 24px);
      flex: 1;
      display: flex;
      flex-direction: column;
      box-sizing: border-box;
    }

    .portal-container--auth {
      justify-content: center;
    }

    /* Grid para el dashboard de Mi Postulación */
    .portal-dashboard-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 28px;
    }

    @media (min-width: 960px) {
      .portal-dashboard-grid {
        grid-template-columns: 1.6fr 1fr;
        gap: 32px;
        align-items: start;
      }
    }

    .portal-dashboard-main {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .portal-dashboard-aside {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    /* Hero de bienvenida en el dashboard */
    .portal-hero-lead {
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 32px;
      box-shadow: 0 4px 16px rgba(11, 27, 46, 0.05);
      position: relative;
      overflow: hidden;
    }

    .portal-hero-lead::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--portal-cobre) 0%, var(--portal-cobre-claro) 100%);
    }

    /* Grid institucional de autenticación (2 columnas en desktop) */
    .portal-auth-grid {
      display: grid;
      grid-template-columns: 1fr;
      gap: 32px;
      align-items: start;
      width: 100%;
      margin: auto 0;
    }

    @media (min-width: 900px) {
      .portal-auth-grid {
        grid-template-columns: 1.15fr 0.9fr;
        gap: 56px;
        align-items: center;
      }
    }

    .portal-auth-info {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .portal-auth-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-size: 13px;
      letter-spacing: 0.13em;
      text-transform: uppercase;
      font-weight: 700;
      color: var(--portal-cobre-texto);
      margin: 0;
    }

    .portal-auth-title {
      font-family: var(--serif);
      font-weight: 500;
      font-size: clamp(32px, 4vw, 44px);
      line-height: 1.12;
      color: var(--portal-azul);
      letter-spacing: -0.01em;
      margin: 0;
    }

    .portal-auth-title em {
      font-style: normal;
      color: var(--portal-cobre-texto);
    }

    .portal-auth-desc {
      font-size: 18px;
      color: var(--portal-mutado);
      line-height: 1.5;
      margin: 0;
    }

    .portal-auth-features {
      list-style: none;
      padding: 0;
      margin: 12px 0 0 0;
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .portal-auth-feature {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 16px 18px;
      box-shadow: 0 2px 6px rgba(11, 27, 46, 0.03);
    }

    .portal-auth-feature__icon {
      width: 38px;
      height: 38px;
      background: var(--crema-2, #F3EBDD);
      color: var(--portal-cobre-texto);
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .portal-auth-feature strong {
      display: block;
      font-size: 16px;
      font-weight: 700;
      color: var(--portal-azul);
      margin-bottom: 2px;
    }

    .portal-auth-feature p {
      font-size: 14px;
      color: var(--portal-mutado);
      line-height: 1.4;
      margin: 0;
    }

    /* Tarjetas estilo Landing (como .tarjeta y .precalificador--destacado) */
    .portal-card {
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: var(--portal-radio);
      padding: 28px;
      box-shadow: 0 4px 16px rgba(11, 27, 46, 0.05);
      margin-bottom: 20px;
    }

    .portal-card--auth {
      background: #FFFFFF;
      border: 1.5px solid var(--portal-borde);
      border-radius: 8px;
      padding: 32px 30px;
      box-shadow: 0 10px 30px rgba(11, 27, 46, 0.07), 0 2px 6px rgba(11, 27, 46, 0.03);
      position: relative;
    }

    .portal-card--auth::before {
      content: "";
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 4px;
      background: linear-gradient(90deg, var(--portal-cobre) 0%, var(--portal-cobre-claro) 100%);
      border-radius: 8px 8px 0 0;
    }

    .portal-title {
      font-family: var(--serif);
      font-size: 26px;
      font-weight: 500;
      color: var(--portal-azul);
      margin: 0 0 8px 0;
      line-height: 1.2;
    }

    .portal-desc {
      font-size: 16px;
      color: var(--portal-mutado);
      margin: 0 0 20px 0;
      line-height: 1.5;
    }

    /* Botones estilo Landing */
    .portal-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      width: 100%;
      min-height: 50px;
      padding: 13px 24px;
      border-radius: 4px;
      border: 1.5px solid transparent;
      font: inherit;
      font-weight: 700;
      font-size: 16px;
      line-height: 1.2;
      text-decoration: none;
      text-align: center;
      cursor: pointer;
      box-sizing: border-box;
      transition: background-color .15s, color .15s, border-color .15s;
    }

    .portal-btn:active {
      transform: translateY(1px);
    }

    .portal-btn--primary {
      background: var(--portal-azul);
      color: #FFFFFF;
    }
    .portal-btn--primary:hover {
      background: var(--azul-3, #1B3350);
      color: #FFFFFF;
    }

    .portal-btn--gold, .portal-btn--acento {
      background: var(--portal-cobre);
      color: #FFFFFF;
    }
    .portal-btn--gold:hover, .portal-btn--acento:hover {
      background: var(--portal-cobre-hover);
      color: #FFFFFF;
    }

    .portal-btn--outline {
      border-color: var(--portal-azul);
      color: var(--portal-azul);
      background: #FFFFFF;
    }
    .portal-btn--outline:hover {
      background: var(--portal-fondo);
      color: var(--portal-azul);
    }

    .portal-btn--wa-full {
      background: #1F5A32;
      color: #FFFFFF;
      border-color: #1F5A32;
    }
    .portal-btn--wa-full:hover {
      background: #143d22;
      color: #FFFFFF;
    }

    /* Campos y formularios estilo Landing */
    .portal-input-group {
      margin-bottom: 18px;
    }

    .portal-label {
      display: block;
      font-size: 15px;
      font-weight: 700;
      margin-bottom: 6px;
      color: var(--portal-azul);
    }

    .portal-input, .portal-select {
      width: 100%;
      min-height: 48px;
      padding: 10px 14px;
      font-size: 16px;
      font-family: inherit;
      border: 1.5px solid #CCD4DC;
      border-radius: 4px;
      background: #FCFCFD;
      color: var(--portal-texto);
      box-sizing: border-box;
      transition: border-color .15s, box-shadow .15s;
    }
    .portal-input:focus, .portal-select:focus {
      outline: none;
      border-color: var(--portal-cobre);
      background: #FFFFFF;
      box-shadow: 0 0 0 3px rgba(201, 138, 75, 0.2);
    }

    /* Grupos de opciones (radios): el área tocable mide al menos 44px */
    .portal-fieldset { border: 0; padding: 0; min-width: 0; }
    .portal-fieldset legend { padding: 0; }
    .portal-radios { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 6px; }
    .portal-radio {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 44px;
      padding: 8px 16px;
      font-weight: 500;
      cursor: pointer;
      border: 1.5px solid #CCD4DC;
      border-radius: 4px;
      background: #FCFCFD;
      box-sizing: border-box;
    }
    .portal-radio input[type="radio"] { width: 22px; height: 22px; margin: 0; flex: none; accent-color: var(--portal-azul); cursor: pointer; }
    .portal-radio:has(input:checked) { border-color: var(--portal-cobre); background: #FFFFFF; }
    .portal-radio:has(input:focus-visible) { box-shadow: 0 0 0 3px rgba(201, 138, 75, 0.35); }

    /* Alertas */
    .portal-alert {
      padding: 14px 16px;
      border-radius: 4px;
      font-size: 15px;
      line-height: 1.45;
      margin-bottom: 18px;
      display: flex;
      align-items: flex-start;
      gap: 10px;
    }
    .portal-alert--error {
      background: var(--portal-rojo-fondo);
      color: var(--portal-rojo);
      border: 1px solid #F5C2C0;
      font-weight: 600;
    }
    .portal-alert--info {
      background: var(--crema-2, #F3EBDD);
      color: var(--portal-cobre-texto);
      border-left: 4px solid var(--portal-cobre);
      border-radius: 0 4px 4px 0;
    }
    .portal-alert--success {
      background: var(--portal-verde-fondo);
      color: var(--portal-verde);
      border: 1px solid #C4DEC8;
      font-weight: 600;
    }


    /* ---------- Expediente: documentos y carta de interés ---------- */
    .exp {
      width: 100%;
      max-width: 820px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .portal-container:has(.exp) { padding-top: 24px; }
    .exp .portal-alert { margin-bottom: 0; }
    .exp__cab { display: flex; flex-direction: column; gap: 6px; }
    .exp__cab .enlace-flecha { font-size: 15px; min-height: 44px; align-items: center; }
    .exp__titulo {
      font-family: var(--serif);
      font-size: 30px;
      font-weight: 500;
      line-height: 1.15;
      color: var(--portal-azul);
      margin: 0;
      text-wrap: balance;
    }

    /* Tarjeta de estado: lo primero que se lee y la única con fondo oscuro */
    .exp-estado {
      background: var(--portal-azul);
      color: #FFFFFF;
      border-radius: 8px;
      padding: 28px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .exp-estado__principal { display: flex; gap: 18px; align-items: flex-start; }
    .exp-estado__icono {
      flex: none;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      color: var(--portal-cobre-claro);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .exp-estado__cuerpo { min-width: 0; }
    .exp-estado__titulo {
      font-family: var(--serif);
      font-size: 28px;
      font-weight: 500;
      line-height: 1.18;
      color: #FFFFFF;
      margin: 0;
      text-wrap: balance;
    }
    .exp-estado__texto { margin: 10px 0 0; color: #D5DCE4; font-size: 16px; max-width: 58ch; }
    .exp-estado__aviso { margin: 10px 0 0; color: #FFFFFF; font-weight: 700; font-size: 16px; }
    .exp-estado__accion { margin-top: 20px; }
    .exp-estado__asesora {
      border-top: 1px solid rgba(255, 255, 255, 0.16);
      padding-top: 16px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 4px 16px;
      flex-wrap: wrap;
      font-size: 15px;
      color: #D5DCE4;
    }
    .exp-estado__asesora strong { color: #FFFFFF; }
    .exp-estado__persona { display: inline-flex; align-items: center; gap: 10px; }
    .exp-estado__avatar {
      flex: none;
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: var(--portal-cobre-claro);
      color: var(--portal-azul);
      font-weight: 700;
      font-size: 14px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .exp-estado__enlace {
      color: var(--portal-cobre-claro);
      font-weight: 700;
      text-decoration: none;
      min-height: 44px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }
    .exp-estado__enlace:hover { text-decoration: underline; color: #FFFFFF; }

    /* Secciones: dos bloques con el mismo peso (Documentos, Carta de interés) */
    .exp-seccion {
      background: #FFFFFF;
      border: 1px solid var(--portal-borde);
      border-radius: 8px;
      padding: 24px 28px 20px;
    }
    .exp-seccion__cab { margin-bottom: 4px; }
    .exp-seccion__titulo {
      font-family: var(--serif);
      font-size: 24px;
      font-weight: 500;
      line-height: 1.2;
      color: var(--portal-azul);
      margin: 0;
    }
    .exp-seccion__resumen { margin: 4px 0 0; font-size: 15px; color: var(--portal-mutado); }
    .exp-vacio { margin: 12px 0; color: var(--portal-mutado); }
    .exp-boton { width: auto; margin-top: 14px; color: var(--portal-azul); }
    .exp-boton:hover { color: var(--portal-azul); background: var(--portal-cobre-claro); }
    #documentos, #bloqueConsentimiento { scroll-margin-top: 96px; }

    .exp-consentimiento__borrador {
      display: inline-block;
      margin: 10px 0 0;
      padding: 2px 10px;
      font-size: 13px;
      font-weight: 700;
      color: var(--portal-cobre-texto);
      background: var(--crema-2, #F3EBDD);
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
    }
    .exp-consentimiento__texto {
      margin-top: 12px;
      font-size: 15px;
      line-height: 1.5;
      white-space: pre-wrap;
      max-height: 180px;
      overflow-y: auto;
      padding: 12px 14px;
      background: var(--crema, #F2EBE0);
      border: 1px solid var(--portal-borde);
      border-radius: 4px;
    }
    .exp-bloqueado { opacity: 0.5; }

    /* Filas de documento: una línea de nombre y estado; la acción solo donde hay algo que hacer */
    .exp-docs { list-style: none; margin: 8px 0 0; padding: 0; }
    .doc {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 10px 20px;
      align-items: center;
      padding: 16px 0;
      border-top: 1px solid var(--portal-borde);
      scroll-margin-top: 96px;
    }
    .doc:focus { outline: none; }
    .doc:target { background: var(--crema, #F2EBE0); margin: 0 -12px; padding-left: 12px; padding-right: 12px; border-radius: 6px; }
    .doc__nombre {
      font-family: inherit;
      font-size: 17px;
      font-weight: 700;
      line-height: 1.3;
      color: var(--portal-azul);
      margin: 0;
    }
    .doc__opcional { margin-left: 8px; font-size: 14px; font-weight: 500; color: var(--portal-mutado); white-space: nowrap; }
    .doc__estado {
      margin: 4px 0 0;
      font-size: 15px;
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--portal-mutado);
    }
    .doc__icono { display: inline-flex; flex: none; }
    .doc__estado--recibido { color: var(--portal-azul); }
    .doc__estado--validado { color: var(--portal-verde); font-weight: 600; }
    .doc__estado--observado { color: var(--portal-ambar); font-weight: 600; }
    .doc__estado--reemplazo { color: var(--portal-rojo); font-weight: 600; }
    .doc__accion { display: flex; flex-direction: column; align-items: flex-end; gap: 6px; }
    .doc__accion .boton { min-height: 44px; padding: 8px 18px; font-size: 15px; position: relative; }
    .doc__accion .boton:focus-within { outline: 3px solid var(--portal-cobre); outline-offset: 2px; }
    .doc__accion input[type="file"] { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0; overflow: hidden; clip: rect(0, 0, 0, 0); border: 0; }
    .doc__formato { margin: 0; font-size: 13px; color: var(--portal-mutado); }
    .estado-subida { margin: 0; font-size: 14px; font-weight: 700; color: var(--portal-rojo); text-align: right; }
    .estado-subida[data-cargando="true"] { color: var(--portal-azul); }
    .doc__nota {
      grid-column: 1 / -1;
      margin: 0;
      padding: 10px 14px;
      font-size: 15px;
      line-height: 1.45;
      border-radius: 4px;
      border: 1px solid transparent;
    }
    .doc__nota--observado { background: var(--portal-ambar-fondo); border-color: #F6DFB3; color: #6E3F17; }
    .doc__nota--reemplazo { background: var(--portal-rojo-fondo); border-color: #F5C2C0; color: var(--portal-rojo); }

    .exp-ayuda { margin-top: 4px; border-top: 1px solid var(--portal-borde); }
    .exp-ayuda summary { cursor: pointer; min-height: 44px; display: flex; align-items: center; font-size: 15px; font-weight: 600; color: var(--portal-cobre-texto); }
    .exp-ayuda summary::-webkit-details-marker { display: none; }
    .exp-ayuda summary::before {
      content: "";
      flex: none;
      width: 7px;
      height: 7px;
      margin-right: 12px;
      border-right: 2px solid currentColor;
      border-bottom: 2px solid currentColor;
      transform: rotate(-45deg);
    }
    .exp-ayuda[open] > summary::before { transform: rotate(45deg); }
    .exp-ayuda p { margin: 0 0 12px; font-size: 15px; color: var(--portal-mutado); max-width: 65ch; }
    .exp-ayuda a { color: var(--portal-cobre-texto); font-weight: 600; }

    @media (max-width: 600px) {
      .exp { gap: 16px; }
      .exp__titulo { font-size: 26px; }
      .exp-estado { padding: 22px 18px; }
      .exp-estado__principal { flex-direction: column; gap: 14px; }
      .exp-estado__titulo { font-size: 25px; }
      .exp-estado__accion { width: 100%; box-sizing: border-box; }
      .exp-seccion { padding: 20px 18px 16px; }
      .doc { grid-template-columns: 1fr; }
      .doc__accion { align-items: stretch; }
      .doc__accion .boton { width: 100%; box-sizing: border-box; }
      .doc__formato, .estado-subida { text-align: left; }
      .doc:target { margin: 0 -8px; padding-left: 8px; padding-right: 8px; }
    }
    @media (prefers-reduced-motion: reduce) {
      .boton, .portal-btn { transition: none; }
    }

    /* Pie de página institucional */
    .portal-footer {
      background: var(--pie, #07121F);
      color: #D5DCE4;
      border-top: 1px solid var(--linea-oscura, #22344A);
      padding: 32px var(--margen, 24px);
      font-size: 14px;
      text-align: center;
      margin-top: auto;
    }

    .portal-footer__inner {
      max-width: var(--ancho, 1160px);
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
    }

    .portal-footer-links {
      display: flex;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }
    .portal-footer-links a {
      color: #D5DCE4;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .portal-footer-links a:hover {
      color: var(--portal-cobre-claro);
    }
  </style>
</head>
<body class="portal-body">
  <header class="portal-header">
    <div class="portal-header__inner">
      <a href="/" class="portal-logo-link" title="Volver al inicio del sitio">
        <img class="portal-logo-img" src="https://static.wixstatic.com/media/64d480_878e9bae365142a8a7cfd49040026764~mv2.png" alt="Fundación del Gran Rosario Ecuador" width="190" height="54" />
        <span class="portal-badge-header">Portal del Postulante</span>
      </a>

      <div class="portal-header-actions">
        <a href="/" class="portal-link-volver">
          <span aria-hidden="true">←</span>
          <span>Volver al sitio</span>
        </a>
        {autenticado && (
          <button type="button" id="btnSalirPortal" class="portal-btn-sm portal-btn-sm--ghost">
            Cerrar sesión
          </button>
        )}
      </div>
    </div>
  </header>

  <main class={`portal-container ${!autenticado ? 'portal-container--auth' : ''}`}>
    <slot />
  </main>

  <footer class="portal-footer">
    <div class="portal-footer__inner">
      <div><strong>Fundación del Gran Rosario Ecuador</strong> · Admisiones y Acompañamiento Académico</div>
      <div class="portal-footer-links">
        <a href="/" target="_blank" rel="noopener">Inicio</a>
        <span>·</span>
        <a href="/carreras/" target="_blank" rel="noopener">Carreras</a>
        <span>·</span>
        <a href="/proteccion-de-datos/" target="_blank" rel="noopener">Protección de Datos</a>
        <span>·</span>
        <a href="/contacto/" target="_blank" rel="noopener">Contacto</a>
      </div>
    </div>
  </footer>

  <script>
    const btnSalir = document.getElementById('btnSalirPortal');
    btnSalir?.addEventListener('click', async () => {
      try {
        await fetch('/api/portal/salir', {
          method: 'POST',
          headers: {
            'X-FGREC-Portal': '1'
          }
        });
      } finally {
        window.location.href = '/mi-postulacion/ingresar';
      }
    });
  </script>
</body>
</html>
